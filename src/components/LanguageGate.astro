---
/**
 * First-visit language picker — a native <dialog> opened when no language
 * preference is stored. Language-neutral by design: both language names are
 * always visible, so the picker itself carries no data-kn/data-en variants.
 *
 * Choosing a language stores it (localStorage, never a cookie — see the
 * privacy page) and applies it immediately; dismissing stores nothing, so
 * the visitor is asked again on their next visit.
 */
import Bloom from './motifs/Bloom.astro';
---

<dialog
  id="lang-gate"
  class="m-auto w-[min(92vw,26rem)] border border-ink/10 bg-cream p-0 text-ink shadow-2xl backdrop:bg-ink/70 backdrop:backdrop-blur-sm"
  aria-labelledby="lang-gate-title"
>
  <div class="px-6 py-9 text-center sm:px-10">
    <Bloom class="mx-auto w-10 text-turmeric" />
    <h2 id="lang-gate-title" class="mt-4 font-display text-2xl font-bold text-ink">
      <span lang="kn">ಭಾಷೆ ಆರಿಸಿ</span>
    </h2>
    <p class="font-display text-lg text-leaf" lang="en">Choose your language</p>
    <p class="mt-3 font-ui text-sm leading-relaxed text-stone">
      <span lang="kn">ನಿಮಗೆ ಅನುಕೂಲವಾದ ಭಾಷೆಯಲ್ಲಿ ಓದಿ.</span>
      Read in whichever language suits you.
    </p>

    <div class="mt-7 grid gap-3 sm:grid-cols-2">
      <button type="button" data-lang-choice="kn" class="lang-choice">
        <span class="block font-display text-xl font-bold">ಕನ್ನಡ</span>
        <span class="lang-choice-sub mt-1 block font-ui text-xs">ಕನ್ನಡದಲ್ಲಿ ಓದಿ</span>
      </button>
      <button type="button" data-lang-choice="en" class="lang-choice">
        <span class="block font-display text-xl font-bold">English</span>
        <span class="lang-choice-sub mt-1 block font-ui text-xs">Read in English</span>
      </button>
    </div>

    <p class="mt-6 font-ui text-xs leading-relaxed text-stone/80">
      <span lang="kn">ನಿಮ್ಮ ಆಯ್ಕೆ ಈ ವೀಕ್ಷಕದಲ್ಲಿ ಮಾತ್ರ ಇಡಲಾಗುತ್ತದೆ.</span>
      Your choice is saved only in this browser.
    </p>
  </div>
</dialog>

<style>
  .lang-choice {
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    background-color: var(--color-jasmine);
    padding: 1.1rem 1rem 1rem;
    color: var(--color-ink);
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      color 200ms ease;
  }

  .lang-choice:hover,
  .lang-choice:active {
    border-color: var(--color-leaf);
    background-color: var(--color-leaf);
    color: var(--color-milk);
  }

  .lang-choice-sub {
    color: var(--color-stone);
  }

  .lang-choice:hover .lang-choice-sub,
  .lang-choice:active .lang-choice-sub {
    color: color-mix(in srgb, var(--color-milk) 82%, transparent);
  }

  /* The browser-language suggestion: a turmeric ring, still just a hint. */
  .lang-choice.lang-suggested {
    border: 2px solid var(--color-turmeric);
  }
</style>

<script>
  import { activeLocale, applyLocale, storedLocale, type Locale } from '../i18n/client';

  // Keep title/meta/aria in step with whatever the pre-paint script applied.
  applyLocale(activeLocale(), false);

  // The header (and drawer) pill flips the stored preference in place.
  for (const btn of document.querySelectorAll<HTMLButtonElement>(
    '[data-lang-toggle]',
  )) {
    btn.addEventListener('click', () => {
      applyLocale(activeLocale() === 'en' ? 'kn' : 'en');
    });
  }

  // First visit: no stored preference — ask once, remember only a choice.
  const dialog = document.getElementById('lang-gate') as HTMLDialogElement | null;
  if (dialog && storedLocale() === null) {
    // Suggest from the browser's own language, without choosing for the visitor.
    const suggested: Locale = navigator.language
      ?.toLowerCase()
      .startsWith('kn')
      ? 'kn'
      : 'en';
    dialog
      .querySelector<HTMLButtonElement>(`[data-lang-choice="${suggested}"]`)
      ?.classList.add('lang-suggested');

    for (const btn of dialog.querySelectorAll<HTMLButtonElement>(
      '[data-lang-choice]',
    )) {
      btn.addEventListener('click', () => {
        applyLocale((btn.dataset.langChoice as Locale) ?? 'kn');
        dialog.close();
      });
    }

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    // Backdrop click dismisses: nothing stored, asked again next visit.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.showModal();
    document.body.style.overflow = 'hidden';
  }
</script>
