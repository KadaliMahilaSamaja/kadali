---
const links = [
  { href: '/', label: 'ಮುಖಪುಟ' },
  { href: '/about', label: 'ನಮ್ಮ ಬಗ್ಗೆ' },
  { href: '/articles', label: 'ಬರಹಗಳು' },
  { href: '/events', label: 'ಕಾರ್ಯಕ್ರಮಗಳು' },
  { href: '/gallery', label: 'ಚಿತ್ರಶಾಲೆ' },
  { href: '/contact', label: 'ಸಂಪರ್ಕ' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-milk/15 bg-leaf/95 text-milk backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="ಕದಲಿ — ಮುಖಪುಟ">
      <svg
        class="size-8 shrink-0 text-turmeric"
        viewBox="0 0 32 32"
        fill="currentColor"
        aria-hidden="true"
      >
        <circle cx="16" cy="16" r="13"></circle>
        <circle cx="12" cy="13" r="1.6" fill="var(--color-leaf)"></circle>
        <circle cx="19" cy="12" r="1.6" fill="var(--color-leaf)"></circle>
        <circle cx="16" cy="18" r="1.6" fill="var(--color-leaf)"></circle>
        <circle cx="10.5" cy="18.5" r="1.2" fill="var(--color-leaf)"></circle>
        <circle cx="21.5" cy="18" r="1.2" fill="var(--color-leaf)"></circle>
      </svg>
      <span class="font-display text-xl font-semibold tracking-tight">
        <span lang="kn">ಕದಲಿ</span>
        <span class="ml-1.5 align-middle font-ui text-xs font-medium text-milk/70"
          >Kadali</span
        >
      </span>
    </a>

    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-6">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={current === href ? 'page' : undefined}
                class:list={[
                  'font-ui text-base font-medium text-milk/80 transition-colors hover:text-milk active:text-milk',
                  current === href &&
                    'font-semibold text-milk underline decoration-turmeric decoration-2 underline-offset-8',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="nav-toggle"
      type="button"
      class="inline-flex size-11 items-center justify-center rounded-sm text-milk transition-colors hover:bg-milk/10 active:bg-milk/15 md:hidden"
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <span class="sr-only">ಮೆನು</span>
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="nav-icon-close hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav
    id="nav-drawer"
    class="hidden border-t border-milk/15 bg-leaf text-milk md:!hidden"
    aria-label="Primary mobile"
  >
    <ul class="mx-auto max-w-6xl px-4 py-2 sm:px-6">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={current === href ? 'page' : undefined}
              class:list={[
                'block border-b border-milk/10 px-1 py-3.5 font-ui text-lg font-medium text-milk/85 last:border-0 hover:text-milk active:text-milk',
                current === href && 'font-semibold text-milk',
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  const iconOpen = toggle?.querySelector('.nav-icon-open');
  const iconClose = toggle?.querySelector('.nav-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !drawer) return;
    toggle.setAttribute('aria-expanded', String(open));
    drawer.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    // Scroll lock while the drawer is open.
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  // Escape closes the drawer; links inside navigate and close it.
  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      toggle?.getAttribute('aria-expanded') === 'true'
    ) {
      setOpen(false);
    }
  });

  drawer?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
