---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/work-sans';
import '@fontsource-variable/noto-sans-kannada';
import '@fontsource-variable/noto-serif-kannada';
import '../styles/global.css';
import Seo from './Seo.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import JsonLd from './JsonLd.astro';

// Preload only the display face (Fraunces) — its variable wght file covers
// the 400–700 range we use. Other faces load via CSS with swap display.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type = 'website' } = Astro.props;

// Site-wide JSON-LD: Organization + WebSite, injected once on every page.
// Social URLs are placeholders — swap in the club's real profiles when they exist.
const siteUrl = Astro.site
  ? new URL('/', Astro.site).href
  : 'https://kadali.example.org/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Kadali',
    url: siteUrl,
    logo: new URL('/favicon.svg', siteUrl).href,
    sameAs: [
      'https://www.instagram.com/',
      'https://www.youtube.com/',
      'https://wa.me/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Kadali',
    url: siteUrl,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} image={image} type={type} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={frauncesUrl}
      crossorigin
    />
    <JsonLd data={jsonLd} />
  </head>
  <body
    class="grid min-h-screen grid-rows-[auto_1fr_auto] bg-cream font-ui text-ink"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-jasmine focus:px-4 focus:py-2 focus:font-ui focus:text-sm focus:font-semibold focus:text-rani"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
