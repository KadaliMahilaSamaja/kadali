---
import '@fontsource-variable/work-sans';
import '@fontsource-variable/noto-sans-kannada';
import '@fontsource-variable/noto-serif-kannada';
import '../styles/global.css';
import Seo from './Seo.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import JsonLd from './JsonLd.astro';
import LanguageGate from './LanguageGate.astro';
import InstallPrompt from './InstallPrompt.astro';
import PushPrompt from './PushPrompt.astro';
import { ui } from '../i18n/ui';

// Preload the Kannada sans — headings (incl. the hero display line) are set
// in Noto Sans Kannada now, and its variable wght file covers the 400–700
// range we use. Other faces load via CSS with swap display.
import kannadaUrl from '@fontsource-variable/noto-sans-kannada/files/noto-sans-kannada-kannada-wght-normal.woff2?url';

interface Props {
  title?: string;
  /** English <title> for the browser tab; omitted → the site name is used. */
  titleEn?: string;
  description?: string;
  /** English meta description; omitted → the Kannada one stays in both modes. */
  descriptionEn?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, titleEn, description, descriptionEn, image, type = 'website' } =
  Astro.props;

// The Kannada variants are what crawlers see; the English mirrors ride on
// <body> data attributes below and are swapped in client-side by i18n/client.
const titleKn = title ?? ui.seo.siteTitle.kn;
const titleEnDefault = titleEn ?? ui.seo.siteTitle.en;
const descKn = description ?? ui.seo.description.kn;
// Without an explicit English description (e.g. content pages), the Kannada
// meta stays in both modes — content is not translated.
const descEn = descriptionEn ?? (description ? '' : ui.seo.description.en);

// Site-wide JSON-LD: Organization + WebSite, injected once on every page.
// Social URLs are placeholders — swap in the club's real profiles when they exist.
const siteUrl = Astro.site
  ? new URL('/', Astro.site).href
  : 'https://kadali.org/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ಕದಳಿ ವನಿತಾ ಸಮಾಜ',
    alternateName: 'Kadali Vanita Samaja',
    url: siteUrl,
    logo: new URL('/favicon.svg', siteUrl).href,
    email: 'contact@kadali.org',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'ಚೌಕಿ ಮಠ (Chowki Matha)',
      addressLocality: 'ಶಿವಮೊಗ್ಗ (Shivamogga)',
      addressRegion: 'Karnataka',
      addressCountry: 'IN',
    },
    sameAs: [
      'https://www.instagram.com/',
      'https://www.youtube.com/',
      'https://wa.me/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ಕದಳಿ ವನಿತಾ ಸಮಾಜ',
    alternateName: 'Kadali Vanita Samaja',
    url: siteUrl,
  },
];
---

<!doctype html>
<html lang="kn" data-lang="kn" class="overflow-x-clip">
  <head>
    <script is:inline>
      // Language before first paint: read the stored preference (never a
      // cookie) and flip the root so the CSS visibility rules show the right
      // variant instantly — no flash of the other language.
      try {
        if (localStorage.getItem('kadali-lang') === 'en') {
          document.documentElement.dataset.lang = 'en';
          document.documentElement.lang = 'en';
        }
      } catch (e) {
        /* storage unavailable — the Kannada default stands */
      }
      // The launch hand-off (?celebrate=1, from /launch or the curtain):
      // mark the page pre-paint so the turmeric veil covers it before the
      // first frame — the ceremony wash continues into this veil without a
      // visible seam. The bundled script at the bottom runs the petals and
      // the fade-out reveal.
      try {
        if (new URLSearchParams(location.search).has('celebrate')) {
          document.documentElement.classList.add('celebrate');
        }
      } catch (e) {
        /* no flag, no veil */
      }
    </script>
    <Seo title={title} description={description} image={image} type={type} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={kannadaUrl}
      crossorigin
    />
    <JsonLd data={jsonLd} />
  </head>
  <body
    class="grid min-h-screen grid-cols-[minmax(0,1fr)] grid-rows-[auto_1fr_auto] overflow-x-clip bg-cream font-ui text-ink"
    data-title-kn={titleKn}
    data-title-en={titleEnDefault}
    data-desc-kn={descKn}
    data-desc-en={descEn || undefined}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-jasmine focus:px-4 focus:py-2 focus:font-ui focus:text-sm focus:font-semibold focus:text-leaf"
    >
      <span data-kn lang="kn">{ui.skip.kn}</span><span data-en>{ui.skip.en}</span>
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- ಪುಷ್ಪ ವರ್ಷ: a page loaded with ?celebrate=1 (the launch moment —
         the ceremony console and every curtain tab land here) is covered
         by the turmeric veil first, petals rain over it, and the veil then
         fades to reveal the real site. The shower layer sits above the
         veil; both clean themselves up. -->
    <div class="celebrate-veil" aria-hidden="true"></div>
    <div
      data-shower
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-[70] overflow-hidden"
    ></div>
    <InstallPrompt />
    <PushPrompt />
    <LanguageGate />
  </body>
</html>

<script>
  // Service worker: offline caching + installability. Registered after load
  // so it never competes with first paint, and only in production builds —
  // the dev server's constantly-changing output would poison the cache.
  // Registration failing (rare, e.g. blocked storage) changes nothing: the
  // site works fine without it.
  if ('serviceWorker' in navigator && import.meta.env.PROD) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {
        /* progressive enhancement — carry on without offline support */
      });
    });
  }
</script>

<script>
  // The launch moment, on every page: the ceremony console hands over with
  // ?celebrate=1 and the curtain tabs replace their URL with it, so
  // wherever a visitor lands — homepage or a shared deep link — the page
  // is first covered by the turmeric veil (added pre-paint in the head),
  // petals rain over the veil, and after a beat the veil fades away
  // revealing the site, the shower thinning out after it. The flag is
  // scrubbed from the address bar right away; a later refresh is plain.
  import { flowerShower } from '../lib/petal-shower.js';

  const celebrate = new URLSearchParams(window.location.search).has('celebrate');
  if (celebrate) {
    window.history.replaceState(null, '', window.location.pathname);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      // no veil, no petals — just the plain page
      document.documentElement.classList.remove('celebrate');
    } else {
      window.addEventListener('load', () => {
        flowerShower(document.querySelector('[data-shower]'));
        // petals establish over the veil first, then it fades away
        // (2.2 s) revealing the page; the shower keeps thinning to a
        // stop on its own (~11 s), self-cleaning.
        window.setTimeout(() => {
          document.documentElement.classList.add('celebrate-reveal');
        }, 700);
        window.setTimeout(() => {
          document.documentElement.classList.remove('celebrate', 'celebrate-reveal');
        }, 3400);
      });
    }
  }
</script>
