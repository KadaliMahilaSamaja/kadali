---
import KasutiBorder from './motifs/KasutiBorder.astro';

const year = new Date().getFullYear();

const quickLinks = [
  { href: '/about', label: 'About' },
  { href: '/articles', label: 'Articles' },
  { href: '/events', label: 'Events' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];

const socials = [
  { href: '#', label: 'Instagram' },
  { href: '#', label: 'YouTube' },
  { href: '#', label: 'WhatsApp' },
];
---

<footer class="mt-16">
  <KasutiBorder class="text-rani" />
  <div class="bg-jasmine">
    <div
      class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-3 sm:px-6"
    >
      <div>
        <p class="font-display text-lg font-semibold text-rani">
          <span lang="kn">ಕದಲಿ</span> · Kadali
        </p>
        <p class="mt-3 max-w-xs font-ui text-sm leading-relaxed text-stone">
          A women's cultural collective in coastal Karnataka — vachana circles,
          kasuti stitching, seva, and shared galleries, inspired by
          Akkamahadevi's wandering spirit.
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="font-ui text-sm font-semibold tracking-wide uppercase text-ink">
          Quick links
        </h2>
        <ul class="mt-3 space-y-2">
          {
            quickLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="font-ui text-sm text-stone underline-offset-4 hover:text-rani hover:underline"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-ui text-sm font-semibold tracking-wide uppercase text-ink">
          Contact
        </h2>
        <address class="mt-3 space-y-1 font-ui text-sm not-italic text-stone">
          <p>Placeholder address line, Udupi, Karnataka</p>
          <p><a href="mailto:hello@example.org" class="hover:text-rani">hello@example.org</a></p>
        </address>
        <ul class="mt-4 flex gap-4">
          {
            socials.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="font-ui text-sm font-medium text-rani underline-offset-4 hover:underline"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="border-t border-ink/10">
      <p class="mx-auto max-w-6xl px-4 py-4 font-ui text-xs text-stone sm:px-6">
        © {year} Kadali. Crafted with care in Karnataka.
      </p>
    </div>
  </div>
</footer>
