---
import KasutiBorder from './motifs/KasutiBorder.astro';
import FlowerLine from './motifs/FlowerLine.astro';

const year = new Date().getFullYear();

const quickLinks = [
  { href: '/about', label: 'ನಮ್ಮ ಬಗ್ಗೆ' },
  { href: '/articles', label: 'ಬರಹಗಳು' },
  { href: '/events', label: 'ಕಾರ್ಯಕ್ರಮಗಳು' },
  { href: '/gallery', label: 'ಚಿತ್ರಶಾಲೆ' },
  { href: '/contact', label: 'ಸಂಪರ್ಕ' },
];

const socials = [
  { href: '#', label: 'Instagram' },
  { href: '#', label: 'YouTube' },
  { href: '#', label: 'WhatsApp' },
];
---

<footer class="mt-16">
  <KasutiBorder class="text-turmeric" />
  <div class="relative overflow-hidden bg-leaf text-milk">
    <!-- white florals scattered on the green mast, brochure-style -->
    <FlowerLine
      class="pointer-events-none absolute -top-6 right-6 w-24 text-milk/10 sm:right-16 sm:w-32"
    />
    <FlowerLine
      class="pointer-events-none absolute -bottom-8 left-4 w-20 rotate-12 text-milk/10 sm:left-24 sm:w-28"
    />

    <div
      class="relative mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-3 sm:px-6"
    >
      <div>
        <p class="font-display text-lg font-semibold text-milk">
          <span lang="kn">ಕದಲಿ ಮಹಿಳಾ ಸಂಘ</span>
        </p>
        <p class="mt-3 max-w-xs font-ui text-sm leading-relaxed text-milk/75">
          ಅಕ್ಕಮಹಾದೇವಿಯ ಹೆಜ್ಜನೆಯಲ್ಲಿ ನಡೆಯುವ, ಉಡುಪಿಯ ಮಹಿಳೆಯರ ಒಡನಾಡು. ವಚನ
          ವೃತ್ತ, ಕಸುತಿ ಹೆಣಿಗೆ, ಸೇವೆ.
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="font-ui text-sm font-semibold text-milk">ತ್ವರಿತ ಸಂಪರ್ಕ</h2>
        <ul class="mt-3 space-y-2">
          {
            quickLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="font-ui text-sm text-milk/75 underline-offset-4 hover:text-milk hover:underline active:text-milk"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-ui text-sm font-semibold text-milk">ಸಂಪರ್ಕ</h2>
        <address class="mt-3 space-y-1 font-ui text-sm not-italic text-milk/75">
          <p>ಉಡುಪಿ, ಕರ್ನಾಟಕ</p>
          <p>
            <a
              href="mailto:hello@example.org"
              class="underline-offset-4 hover:text-milk hover:underline active:text-milk"
              >hello@example.org</a
            >
          </p>
        </address>
        <ul class="mt-4 flex gap-4">
          {
            socials.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="font-ui text-sm font-medium text-milk underline-offset-4 hover:underline active:text-milk/80"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="relative border-t border-milk/15">
      <p class="mx-auto max-w-6xl px-4 py-4 font-ui text-xs text-milk/60 sm:px-6">
        © {year} ಕದಲಿ ಮಹಿಳಾ ಸಂಘ. ಕರ್ನಾಟಕದಲ್ಲಿ ಪ್ರೀತಿಯಿಂದ ಕಟ್ಟಿದ್ದು.
      </p>
    </div>
  </div>
</footer>
