---
/**
 * The committee — role-grouped member cards for the About page.
 * Order: president → vice-president → secretary → joint secretary →
 * treasurer → directors → members; within each role group by `order`,
 * then name. The whole section is hidden when `people` is empty.
 */
import { getCollection } from 'astro:content';
import { ROLE_LABELS, ROLE_ORDER } from '../../i18n/ui';

const heading = {
  kn: 'ನಮ್ಮ ಸಮಿತಿ',
  en: 'Our committee',
};

const people = await getCollection('people');
const committee = people.sort(
  (a, b) =>
    ROLE_ORDER.indexOf(a.data.role) - ROLE_ORDER.indexOf(b.data.role) ||
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name),
);
---

{
  committee.length > 0 && (
    <section class="bg-jasmine">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <h2 class="font-display text-3xl font-semibold text-ink">
          <span data-kn lang="kn">{heading.kn}</span>
          <span data-en>{heading.en}</span>
        </h2>

        <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 xl:grid-cols-4">
          {
            committee.map((person) => {
              const { name, nameKn, role, photo, bio } = person.data;
              const roleLabel = ROLE_LABELS[role];
              return (
                <article class="flex h-full flex-col items-center border border-ink/10 bg-cream px-4 pb-6 pt-8 text-center sm:px-6">
                  <div class="w-full overflow-hidden rounded-t-[999px] border border-ink/10">
                    <img
                      src={photo}
                      alt={`ಕದಳಿ ಸಮಿತಿಯ ಸದಸ್ಸೆ ${nameKn ?? name}`}
                      width={640}
                      height={800}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/5] w-full object-cover"
                    />
                  </div>
                  <h3 class="mt-5 font-display text-xl font-semibold text-ink">
                    <span lang="kn">{nameKn ?? name}</span>
                  </h3>
                  <p class="mt-2 font-ui text-sm font-semibold text-leaf">
                    <span data-kn lang="kn">{roleLabel.kn}</span>
                    <span data-en>{roleLabel.en}</span>
                  </p>
                  {bio && (
                    <p class="mt-3 font-body text-sm leading-relaxed text-stone">
                      <span lang="kn">{bio}</span>
                    </p>
                  )}
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  )
}
