---
/**
 * Shared intro band for the standalone pages (about / contact / privacy).
 * Alternates section treatment per the design brief: leaf / jasmine / cream.
 * Decorative Arch sits off to the right on wider screens. All copy props are
 * bilingual ({ kn, en }) pairs rendered as dual spans.
 */
import Arch from '../motifs/Arch.astro';
import type { Bi } from '../../i18n/ui';

interface Props {
  eyebrow: Bi;
  title: Bi;
  /** Subtitle line — rendered below the title in both languages. */
  kn?: Bi;
  lede?: Bi;
  tone?: 'leaf' | 'jasmine' | 'cream';
}

const { eyebrow, title, kn, lede, tone = 'leaf' } = Astro.props;
const onLeaf = tone === 'leaf';

const tones: Record<NonNullable<Props['tone']>, string> = {
  leaf: 'bg-leaf text-milk',
  jasmine: 'bg-jasmine text-ink',
  cream: 'bg-cream text-ink border-b border-ink/10',
};
---

<section class:list={[tones[tone], 'relative overflow-hidden']}>
  <Arch
    width={150}
    class:list={[
      'absolute -right-6 top-10 hidden sm:block',
      onLeaf ? 'text-milk/15' : 'text-leaf/10',
    ]}
  />
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <p
      class:list={[
        'font-ui text-xs font-semibold tracking-[0.2em] uppercase',
        onLeaf ? 'text-milk/80' : 'text-leaf',
      ]}
    >
      <span data-kn lang="kn" class="tracking-normal normal-case">{eyebrow.kn}</span>
      <span data-en class="tracking-normal normal-case">{eyebrow.en}</span>
    </p>
    <h1
      class:list={[
        'mt-4 max-w-3xl font-display text-4xl font-bold sm:text-5xl',
        onLeaf && 'text-milk',
      ]}
    >
      <span data-kn lang="kn">{title.kn}</span>
      <span data-en>{title.en}</span>
    </h1>
    {
      kn && (
        <p
          class:list={[
            'mt-3 font-display text-xl',
            onLeaf ? 'text-milk/90' : 'text-leaf',
          ]}
        >
          <span data-kn lang="kn">{kn.kn}</span>
          <span data-en>{kn.en}</span>
        </p>
      )
    }
    {
      lede && (
        <p
          class:list={[
            'mt-5 max-w-2xl font-body text-lg',
            onLeaf ? 'text-milk/85' : 'text-stone',
          ]}
        >
          <span data-kn lang="kn">{lede.kn}</span>
          <span data-en class="font-serif">{lede.en}</span>
        </p>
      )
    }
  </div>
</section>
