---
/**
 * Shared intro band for the standalone pages (about / contact / privacy).
 * Alternates section treatment per the design brief: rani / jasmine / cream.
 * Decorative Arch sits off to the right on wider screens.
 */
import Arch from '../motifs/Arch.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Kannada subtitle line — always rendered with lang="kn". */
  kn?: string;
  lede?: string;
  tone?: 'rani' | 'jasmine' | 'cream';
}

const { eyebrow, title, kn, lede, tone = 'rani' } = Astro.props;
const onRani = tone === 'rani';

const tones: Record<NonNullable<Props['tone']>, string> = {
  rani: 'bg-rani text-cream',
  jasmine: 'bg-jasmine text-ink',
  cream: 'bg-cream text-ink border-b border-ink/10',
};
---

<section class:list={[tones[tone], 'relative overflow-hidden']}>
  <Arch
    width={150}
    class:list={[
      'absolute -right-6 top-10 hidden sm:block',
      onRani ? 'text-cream/15' : 'text-rani/10',
    ]}
  />
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <p
      class:list={[
        'font-ui text-xs font-semibold tracking-[0.2em] uppercase',
        onRani ? 'text-cream/80' : 'text-rani',
      ]}
    >
      {eyebrow}
    </p>
    <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold sm:text-5xl">
      {title}
    </h1>
    {
      kn && (
        <p
          lang="kn"
          class:list={[
            'mt-3 font-display text-xl',
            onRani ? 'text-cream/90' : 'text-rani',
          ]}
        >
          {kn}
        </p>
      )
    }
    {
      lede && (
        <p
          class:list={[
            'mt-5 max-w-2xl font-body text-lg',
            onRani ? 'text-cream/85' : 'text-stone',
          ]}
        >
          {lede}
        </p>
      )
    }
  </div>
</section>
