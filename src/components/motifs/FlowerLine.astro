---
/**
 * Outline blossom — eight line-drawn petals around a dotted heart, the way
 * the brochure scatters white flowers across its peach panels. Intended for
 * low-opacity backgrounds (e.g. `class="text-milk/60"`). currentColor via `class`.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const petals = Array.from({ length: 8 }, (_, i) => i * 45);
const heartDots = Array.from({ length: 8 }, (_, i) => i * 45);
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  {petals.map((angle) => (
    <ellipse
      cx="32"
      cy="15"
      rx="6.5"
      ry="12"
      stroke="currentColor"
      stroke-width="2"
      transform={`rotate(${angle} 32 32)`}
    ></ellipse>
  ))}
  <circle cx="32" cy="32" r="6.5" stroke="currentColor" stroke-width="2"></circle>
  <circle cx="32" cy="32" r="2.4" fill="currentColor"></circle>
  {heartDots.map((angle) => (
    <circle
      cx="32"
      cy="12"
      r="1.6"
      fill="currentColor"
      transform={`rotate(${angle + 22.5} 32 32)`}
    ></circle>
  ))}
</svg>
