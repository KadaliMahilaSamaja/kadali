---
/**
 * Small solid six-petal bloom with a milk dot heart — the scattered orange
 * flowers from the brochure. Ink it with currentColor via `class`.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const petals = Array.from({ length: 6 }, (_, i) => i * 60);
---

<svg
  viewBox="0 0 32 32"
  fill="currentColor"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  {petals.map((angle) => (
    <ellipse cx="16" cy="8" rx="4.4" ry="6.4" transform={`rotate(${angle} 16 16)`} />
  ))}
  <circle cx="16" cy="16" r="5.6"></circle>
  <circle cx="16" cy="16" r="2.6" fill="var(--color-milk)"></circle>
</svg>
