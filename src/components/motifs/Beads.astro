---
/**
 * Horizontal rudraksha-bead divider — five beads with slight vertical jitter.
 * Color via currentColor; stretch with `class` (e.g. `class="w-full text-rani"`).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 140 28"
  fill="currentColor"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  <circle cx="14" cy="15" r="6"></circle>
  <circle cx="42" cy="11" r="6"></circle>
  <circle cx="70" cy="16" r="6"></circle>
  <circle cx="98" cy="12" r="6"></circle>
  <circle cx="126" cy="15" r="6"></circle>
</svg>
