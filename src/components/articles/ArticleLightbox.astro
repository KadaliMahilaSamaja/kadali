---
/**
 * Article Lightbox Component.
 * Enables full-screen zoom and inspection for any image inside article bodies
 * and article covers. Progressive enhancement, vanilla JS, zero dependencies.
 */
---

<dialog
  id="article-lightbox"
  class="m-auto w-[min(94vw,68rem)] max-w-full rounded-lg border border-ink/15 bg-cream p-0 text-ink shadow-2xl backdrop:bg-ink/80 backdrop:backdrop-blur-sm"
  aria-label="ಚಿತ್ರ ವೀಕ್ಷಕ"
>
  <div class="flex flex-col overflow-hidden">
    <!-- Header with caption preview and close button -->
    <div class="flex items-center justify-between border-b border-ink/10 bg-jasmine px-4 py-3 sm:px-6">
      <div class="flex items-center gap-2">
        <span class="inline-block size-2 rounded-full bg-turmeric"></span>
        <p id="article-lightbox-title" class="font-ui text-sm font-semibold text-leaf truncate max-w-[20rem] sm:max-w-md">
          ಚಿತ್ರ ವೀಕ್ಷಣೆ
        </p>
      </div>
      <button
        type="button"
        id="article-lightbox-close"
        class="flex size-9 cursor-pointer items-center justify-center rounded-full border border-ink/20 text-ink transition-colors hover:bg-leaf hover:text-milk"
        aria-label="ಮುಚ್ಚಿ"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <!-- Image Viewport -->
    <div class="flex items-center justify-center bg-cream/90 p-4 sm:p-6 min-h-[40vh]">
      <img
        id="article-lightbox-img"
        src=""
        alt=""
        class="max-h-[72vh] w-auto max-w-full rounded-sm border border-ink/10 bg-white object-contain shadow-md"
      />
    </div>

    <!-- Footer Caption -->
    <div id="article-lightbox-caption-box" class="border-t border-ink/10 bg-jasmine px-4 py-3 text-center sm:px-6">
      <p id="article-lightbox-caption" class="font-ui text-sm leading-relaxed text-stone"></p>
    </div>
  </div>
</dialog>

<script>
  function setupArticleLightbox() {
    const dialog = document.getElementById('article-lightbox') as HTMLDialogElement | null;
    const imgEl = document.getElementById('article-lightbox-img') as HTMLImageElement | null;
    const titleEl = document.getElementById('article-lightbox-title');
    const captionEl = document.getElementById('article-lightbox-caption');
    const closeBtn = document.getElementById('article-lightbox-close');

    if (!dialog || !imgEl) return;

    // Close on button click
    closeBtn?.addEventListener('click', () => dialog.close());

    // Close on backdrop click
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!isInDialog) {
        dialog.close();
      }
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      imgEl.src = '';
    });

    // Find all images within the article body and cover
    const targets = document.querySelectorAll<HTMLImageElement>(
      '.prose-kadali img, .article-cover img',
    );

    targets.forEach((img) => {
      // Style cursor and hint
      img.classList.add('cursor-zoom-in', 'transition-transform', 'duration-200', 'hover:opacity-95');
      img.setAttribute('title', 'ದೊಡ್ಡದಾಗಿ ನೋಡಲು ಕ್ಲಿಕ್ ಮಾಡಿ');

      img.addEventListener('click', () => {
        const src = img.currentSrc || img.src;
        if (!src) return;

        // Determine caption: figure figcaption > alt text > nearby em
        let caption = '';
        const figure = img.closest('figure');
        if (figure) {
          const figcaption = figure.querySelector('figcaption');
          if (figcaption) caption = figcaption.textContent?.trim() ?? '';
        }

        if (!caption && img.parentElement) {
          const nextEm = img.parentElement.querySelector('em');
          if (nextEm) caption = nextEm.textContent?.trim() ?? '';
        }

        if (!caption) {
          caption = img.alt?.trim() ?? '';
        }

        imgEl.src = src;
        imgEl.alt = caption || 'ಚಿತ್ರ ವೀಕ್ಷಣೆ';

        if (titleEl) {
          titleEl.textContent = caption || 'ಕದಳಿ ವನಿತಾ ಸಮಾಜ · ಚಿತ್ರ ವೀಕ್ಷಣೆ';
        }

        if (captionEl) {
          captionEl.textContent = caption;
          const box = document.getElementById('article-lightbox-caption-box');
          if (box) box.style.display = caption ? 'block' : 'none';
        }

        dialog.showModal();
        document.body.style.overflow = 'hidden';
      });
    });
  }

  // Run on page load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupArticleLightbox);
  } else {
    setupArticleLightbox();
  }
</script>
