---
/**
 * Decorative stand-in for articles with neither a cover image nor an
 * author photo. A turmeric bloom on the jasmine band, masked like the
 * cover it replaces (pass the mask/radius classes of the slot via `class`).
 */
import Bloom from '../motifs/Bloom.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class={`flex items-center justify-center bg-jasmine ${className}`}
  aria-hidden="true"
>
  <Bloom class="size-14 text-turmeric/70" />
</div>
