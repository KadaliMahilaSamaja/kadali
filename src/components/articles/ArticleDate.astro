---
/**
 * Kannada date byline, e.g. "18 ಅಕ್ಟೋಬರ್ 2026".
 * Month map is hardcoded — Node's ICU data for kn is not guaranteed
 * on every build machine.
 */
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;

const KN_MONTHS = [
  'ಜನವರಿ',
  'ಫೆಬ್ರವರಿ',
  'ಮಾರ್ಚ್',
  'ಏಪ್ರಿಲ್',
  'ಮೇ',
  'ಜೂನ್',
  'ಜುಲೈ',
  'ಆಗಸ್ಟ್',
  'ಸೆಪ್ಟೆಂಬರ್',
  'ಅಕ್ಟೋಬರ್',
  'ನವೆಂಬರ್',
  'ಡಿಸೆಂಬರ್',
] as const;

const dayFmt = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
});
const yearFmt = new Intl.DateTimeFormat('en-IN', {
  year: 'numeric',
});
---

<span lang="kn" class={className}>
  <time datetime={date.toISOString().slice(0, 10)}>
    {dayFmt.format(date)} {KN_MONTHS[date.getMonth()]} {yearFmt.format(date)}
  </time>
</span>
