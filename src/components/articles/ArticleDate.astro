---
/**
 * Date byline in both languages, e.g. "18 ಅಕ್ಟೋಬರ್ 2026" / "18 October 2026".
 * Month names come from the shared bilingual table in src/i18n/dates.ts —
 * Node's ICU data for kn is not guaranteed on every build machine.
 */
import { formatDate } from '../../i18n/dates';

interface Props {
  date: Date;
  class?: string;
}

const { date, class: className } = Astro.props;
const label = formatDate(date);
---

<span class={className}>
  <time datetime={date.toISOString().slice(0, 10)}>
    <span data-kn lang="kn">{label.kn}</span>
    <span data-en>{label.en}</span>
  </time>
</span>
