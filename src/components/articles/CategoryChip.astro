---
/**
 * Category chip — links back to the filtered articles index.
 * Label: the bilingual category name (Kannada primary, English secondary).
 */
import { CATEGORY_LABELS, type ArticleCategory } from './categories';

interface Props {
  category: ArticleCategory;
  class?: string;
}

const { category, class: className } = Astro.props;
const { kn, en } = CATEGORY_LABELS[category];
---

<a
  href={`/articles/?category=${category}`}
  class={`inline-flex items-center gap-1.5 self-start border border-leaf/30 bg-cream px-2.5 py-1 font-ui text-xs font-semibold tracking-wider uppercase text-leaf transition-colors duration-200 hover:border-leaf hover:bg-leaf hover:text-cream ${className ?? ''}`}
>
  <span data-kn lang="kn" class="tracking-normal normal-case">{kn}</span>
  <span data-en class="tracking-normal normal-case">{en}</span>
</a>
