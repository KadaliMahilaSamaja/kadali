---
/**
 * Share row: WhatsApp / Facebook / X share anchors (no tracking scripts of
 * our own) plus a copy-link button. The copy action is progressive —
 * navigator.clipboard with an execCommand fallback for non-secure contexts.
 */
import { ui } from '../../i18n/ui';

interface Props {
  /** Absolute URL of the page being shared. */
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const { articles } = ui;

const text = encodeURIComponent(title);
const link = encodeURIComponent(url);

const shares = [
  {
    label: articles.whatsapp,
    href: `https://wa.me/?text=${text}%20${link}`,
  },
  {
    label: articles.facebook,
    href: `https://www.facebook.com/sharer/sharer.php?u=${link}`,
  },
  {
    label: articles.x,
    href: `https://twitter.com/intent/tweet?text=${text}&url=${link}`,
  },
];

const buttonClass =
  'inline-block border border-ink/15 bg-cream px-3 py-1.5 font-ui text-sm font-medium text-ink transition-colors duration-200 hover:border-leaf hover:bg-leaf hover:text-cream';
---

<div data-share class="flex flex-wrap items-center gap-3">
  <h2 class="font-ui text-sm font-semibold tracking-wide uppercase text-ink">
    <span data-kn lang="kn" class="font-normal tracking-normal normal-case text-leaf">{articles.share.kn}</span>
    <span data-en class="font-normal tracking-normal normal-case text-leaf">{articles.share.en}</span>
  </h2>
  <ul class="flex flex-wrap items-center gap-2">
    {
      shares.map(({ label, href }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class={buttonClass}>
            <span data-kn lang="kn">{label.kn}</span>
            <span data-en>{label.en}</span>
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" data-copy-link={url} class={buttonClass}>
        <span data-kn lang="kn">{articles.copyLink.kn}</span>
        <span data-en>{articles.copyLink.en}</span>
      </button>
    </li>
  </ul>
  <p role="status" data-copy-status class="font-ui text-sm font-medium text-leaf"></p>
</div>

<script>
  import { activeLocale } from '../../i18n/client';
  import { ui } from '../../i18n/ui';

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-copy-link]',
  )) {
    button.addEventListener('click', async () => {
      const url = button.dataset.copyLink ?? '';
      let copied = false;

      try {
        await navigator.clipboard.writeText(url);
        copied = true;
      } catch {
        // execCommand fallback for non-secure contexts (http previews).
        const scratch = document.createElement('textarea');
        scratch.value = url;
        scratch.setAttribute('readonly', '');
        scratch.setAttribute('aria-hidden', 'true');
        scratch.style.position = 'fixed';
        scratch.style.opacity = '0';
        document.body.appendChild(scratch);
        scratch.select();
        copied = document.execCommand('copy');
        scratch.remove();
      }

      const en = activeLocale() === 'en';
      const status = button
        .closest('[data-share]')
        ?.querySelector<HTMLElement>('[data-copy-status]');
      if (status) {
        status.textContent = copied
          ? en
            ? ui.articles.copied.en
            : ui.articles.copied.kn
          : en
            ? ui.articles.copyFailed.en
            : ui.articles.copyFailed.kn;
      }

      window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 2500);
    });
  }
</script>
