---
import type { AuthorProfile } from '../../lib/authors';

interface Props {
  author: AuthorProfile;
  articlesCount?: number;
}

const { author, articlesCount } = Astro.props;
const authorUrl = `/articles?author=${encodeURIComponent(author.name)}`;
---

<section class="mt-14 border border-ink/15 bg-jasmine p-6 sm:p-8" aria-labelledby="author-heading">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
    <a href={authorUrl} class="group shrink-0 self-start sm:self-center" aria-label={`${author.name} ಅವರ ಪ್ರೊಫೈಲ್`}>
      <div class="size-24 sm:size-28 overflow-hidden rounded-full border-2 border-leaf/30 bg-cream p-1 transition-transform duration-200 group-hover:scale-105">
        {author.photo ? (
          <img
            src={author.photo}
            alt={author.name}
            width="112"
            height="112"
            class="size-full rounded-full object-cover"
          />
        ) : (
          <div class="flex size-full items-center justify-center rounded-full bg-leaf/10 text-leaf">
            <span class="font-display text-4xl font-bold">
              {author.name.slice(0, 1)}
            </span>
          </div>
        )}
      </div>
    </a>

    <div class="flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-leaf px-2.5 py-0.5 font-ui text-xs font-semibold text-milk">
          ಲೇಖಕಿ
        </span>
        <span class="font-ui text-xs font-semibold text-stone">
          {author.role}
        </span>
      </div>

      <h3 id="author-heading" class="mt-2 font-display text-2xl font-bold text-ink">
        <a href={authorUrl} class="transition-colors hover:text-leaf hover:underline">
          {author.name}
        </a>
      </h3>

      <p class="mt-3 font-body text-base leading-relaxed text-stone">
        {author.bio}
      </p>

      <div class="mt-4 pt-3 border-t border-ink/10 flex flex-wrap items-center justify-between gap-3">
        <a
          href={authorUrl}
          class="inline-flex items-center gap-1.5 font-ui text-sm font-semibold text-leaf transition-colors hover:text-sindoor underline-offset-4 hover:underline"
        >
          <span>{author.name} ಅವರ ಎಲ್ಲಾ ಬರಹಗಳನ್ನು ನೋಡಿ</span>
          {articlesCount !== undefined && <span class="rounded-full bg-cream px-2 py-0.5 text-xs text-ink font-bold">({articlesCount})</span>}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
