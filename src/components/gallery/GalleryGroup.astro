---
/**
 * One gallery entry: KasutiBorder header (title, bilingual date, optional
 * linked event) followed by a masonry-ish CSS-columns photo grid.
 * The section carries `data-gallery` so the lightbox script can scope
 * prev/next cycling to this group's photos only.
 */
import type { CollectionEntry } from 'astro:content';
import KasutiBorder from '../motifs/KasutiBorder.astro';
import { utcInstant } from '../../i18n/dates';
import { ui } from '../../i18n/ui';
import PhotoTile from './PhotoTile.astro';

interface Props {
  gallery: CollectionEntry<'galleries'>;
  /** Resolved href of the linked event, when a title match exists. */
  eventHref?: string;
}

const { gallery, eventHref } = Astro.props;
const { title, date, event, photos } = gallery.data;

// Build-time formatting; UTC keeps the rendered date stable across host TZs.
// Month names come from the shared bilingual table in src/i18n/dates.ts.
const { day, month, year } = utcInstant(date);
const headingId = `gallery-heading-${gallery.id}`;
---

<section
  id={`gallery-${gallery.id}`}
  class="border-t border-ink/10 py-10 first:border-t-0 first:pt-0 md:py-14"
  data-gallery
  aria-labelledby={headingId}
>
  <header class="mb-6">
    <KasutiBorder class="text-leaf" />
    <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 id={headingId} class="font-display text-2xl font-semibold text-ink md:text-3xl">
        <span lang="kn">{title}</span>
      </h2>
      <p class="font-ui text-sm text-stone">
        <span data-kn lang="kn">{day} {month.kn} {year}</span>
        <span data-en>{day} {month.en} {year}</span>
      </p>
    </div>
    {
      event && (
        <p class="mt-1 font-ui text-sm text-stone">
          <span>
            <span data-kn lang="kn">{ui.gallery.eventLabel.kn}</span>
            <span data-en>{ui.gallery.eventLabel.en}</span>
          </span>{' '}
          {eventHref ? (
            <a
              href={eventHref}
              class="font-medium text-leaf underline decoration-leaf/40 underline-offset-4 transition-colors duration-200 hover:decoration-leaf"
            >
              <span lang="kn">{event}</span>
            </a>
          ) : (
            <span><span lang="kn">{event}</span></span>
          )}
        </p>
      )
    }
  </header>

  <div class="columns-2 gap-3 md:columns-3 xl:columns-4">
    {
      photos.map((photo) => (
        <PhotoTile src={photo.image} caption={photo.caption} />
      ))
    }
  </div>
</section>
