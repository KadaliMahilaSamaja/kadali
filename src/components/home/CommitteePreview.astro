---
/**
 * Homepage committee preview — role-grouped member cards, Kannada primary.
 * Order: president → vice-president → secretary → joint secretary →
 * treasurer → members; the section hides when the collection is empty.
 */
import { getCollection } from 'astro:content';

const ROLE_ORDER = [
  'president',
  'vice_president',
  'secretary',
  'joint_secretary',
  'treasurer',
  'member',
] as const;

type Role = (typeof ROLE_ORDER)[number];

const ROLE_LABELS_KN: Record<Role, string> = {
  president: 'ಅಧ್ಯಕ್ಷೆ',
  vice_president: 'ಉಪಾಧ್ಯಕ್ಷೆ',
  secretary: 'ಕಾರ್ಯದರ್ಶಿ',
  joint_secretary: 'ಸಹ ಕಾರ್ಯದರ್ಶಿ',
  treasurer: 'ಕೋಶಾಧಿಕಾರಿ',
  member: 'ಸದಸ್ಯೆ',
};

const committee = (await getCollection('people')).sort(
  (a, b) =>
    ROLE_ORDER.indexOf(a.data.role) - ROLE_ORDER.indexOf(b.data.role) ||
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name),
);
---

{
  committee.length > 0 && (
    <section class="bg-cream" aria-labelledby="committee-heading">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
        <div class="flex flex-wrap items-end justify-between gap-4 px-4 md:px-0">
          <h2 id="committee-heading" class="reveal text-section font-bold">
            ನಿರ್ವಹಣಾ ಸಮಿತಿ
          </h2>
          <a
            href="/about"
            class="underline-reveal font-ui text-base font-semibold text-leaf active:text-sindoor"
          >
            ಸಂಪೂರ್ಣ ಸಮಿತಿ
          </a>
        </div>

        {/* Mobile-first: swipeable snap rail, the next member peeking past
            the edge; the four-up grid returns from md. */}
        <div class="rail mt-10 px-4 pb-2 sm:px-6 md:grid md:grid-cols-4 md:px-0 md:pb-0">
          {committee.map((person, i) => {
            const { name, nameKn, role, photo } = person.data;
            return (
              <div
                class="reveal min-w-[64%] snap-center sm:min-w-[40%] md:min-w-0"
                style={`--reveal-delay: ${i * 70}ms`}
              >
                <article class="flex h-full flex-col items-center border border-ink/10 bg-jasmine px-3 pb-5 pt-6 text-center sm:px-4">
                  <div class="w-full overflow-hidden rounded-t-[999px] border border-ink/10">
                    <img
                      src={photo}
                      alt={`ಕದಲಿ ಸಮಿತಿಯ ಸದಸ್ಸೆ ${nameKn ?? name}`}
                      width="640"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/5] w-full object-cover"
                    />
                  </div>
                  <h3 class="mt-4 text-lg leading-snug">
                    <span lang="kn">{nameKn ?? name}</span>
                  </h3>
                  {nameKn && (
                    <p lang="en" class="mt-0.5 font-ui text-xs text-stone">
                      {name}
                    </p>
                  )}
                  <p class="mt-2 font-ui text-sm font-semibold text-leaf">
                    <span lang="kn">{ROLE_LABELS_KN[role]}</span>
                  </p>
                </article>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}
