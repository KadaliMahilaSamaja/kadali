---
import { getCollection } from 'astro:content';

/**
 * Homepage committee preview — the board's own members, Kannada-primary.
 * Order: president → vice-president → secretary → joint secretary →
 * treasurer → directors → members; the section hides when empty.
 */
const ROLE_ORDER = [
  'president',
  'vice_president',
  'secretary',
  'joint_secretary',
  'treasurer',
  'director',
  'member',
] as const;

type Role = (typeof ROLE_ORDER)[number];

const ROLE_LABELS_KN: Record<Role, string> = {
  president: 'ಅಧ್ಯಕ್ಷರು',
  vice_president: 'ಉಪಾಧ್ಯಕ್ಷರು',
  secretary: 'ಕಾರ್ಯದರ್ಶಿ',
  joint_secretary: 'ಸಹಕಾರ್ಯದರ್ಶಿ',
  treasurer: 'ಖಜಾಂಚಿ',
  director: 'ನಿರ್ದೇಶಕರು',
  member: 'ಸದಸ್ಯೆ',
};

const committee = (await getCollection('people')).sort(
  (a, b) =>
    ROLE_ORDER.indexOf(a.data.role) - ROLE_ORDER.indexOf(b.data.role) ||
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name),
);
---

{
  committee.length > 0 && (
    <section class="border-t border-ink/10 bg-cream" aria-labelledby="committee-heading">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
        <div class="reveal flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow-kn">ನಮ್ಮ ಜನ</p>
            <h2 id="committee-heading" class="text-section font-bold">
              ಒಟ್ಟಾಗಿ ಮುನ್ನಡೆಸುವ ಕೈಗಳು
            </h2>
          </div>
          <div class="md:pb-2 md:text-right">
            <p class="max-w-sm font-body text-lg leading-relaxed text-stone">
              ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಹಿಂದೆ ಇರುವ ಸೇವಾ ಮನಸ್ಸುಗಳು, ಸಮರ್ಪಣೆ ಮತ್ತು
              ಒಗ್ಗಟ್ಟಿನ ಪರಿಚಯ.
            </p>
            <a
              href="/about"
              class="underline-reveal mt-3 inline-flex items-center gap-1.5 font-ui text-base font-semibold text-leaf active:text-sindoor"
            >
              <span>ಸಂಪೂರ್ಣ ಸಮಿತಿ</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        {/* Mobile: swipe band */}
        <div class="rail-x mt-10 pb-2 md:hidden">
          {committee.map((person, i) => {
            const { name, nameKn, role, photo } = person.data;
            return (
              <div
                class="reveal min-w-[64%] snap-center sm:min-w-[38%]"
                style={`--reveal-delay: ${i * 70}ms`}
              >
                <article class="flex h-full flex-col items-center rounded-b-[2rem] border border-ink/10 bg-milk px-3 pb-5 pt-6 text-center sm:px-4">
                  <div class="w-full overflow-hidden rounded-t-[999px] border border-ink/10">
                    <img
                      src={photo}
                      alt={`ಕದಳಿ ಸಮಿತಿಯ ಸದಸ್ಸೆ ${nameKn ?? name}`}
                      width="720"
                      height="900"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/5] w-full object-cover"
                    />
                  </div>
                  <h3 class="mt-4 text-lg leading-snug">
                    <span lang="kn">{nameKn ?? name}</span>
                  </h3>
                  <p class="mt-2 font-ui text-sm font-semibold text-leaf">
                    <span lang="kn">{ROLE_LABELS_KN[role]}</span>
                  </p>
                </article>
              </div>
            );
          })}
        </div>
        <p class="swipe-hint md:hidden" aria-hidden="true">
          ಸರಿಸಿ ಪರಿಚಯ ಪಡೆಯಿರಿ
        </p>

        {/* Tablet & Desktop: centered wrap grid — a partial last row (e.g. a
            lone 9th member) centres itself instead of hanging at ¼ width. */}
        <div class="hidden md:flex md:flex-wrap md:justify-center gap-6 mt-10">
          {committee.map((person, i) => {
            const { name, nameKn, role, photo } = person.data;
            return (
              <div
                class="reveal w-[calc(50%-0.75rem)] md:w-[calc(33.333%-1rem)] lg:w-[calc(25%-1.125rem)]"
                style={`--reveal-delay: ${i * 60}ms`}
              >
                <article class="group flex h-full flex-col items-center rounded-b-[2rem] border border-ink/10 bg-milk px-4 pb-6 pt-6 text-center transition-transform duration-300 hover:-translate-y-1">
                  <div class="w-full overflow-hidden rounded-t-[999px] border border-ink/10">
                    <img
                      src={photo}
                      alt={`ಕದಳಿ ಸಮಿತಿಯ ಸದಸ್ಸೆ ${nameKn ?? name}`}
                      width="720"
                      height="900"
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </div>
                  <h3 class="mt-4 text-lg font-semibold leading-snug">
                    <span lang="kn">{nameKn ?? name}</span>
                  </h3>
                  <p class="mt-1.5 font-ui text-sm font-semibold text-leaf">
                    <span lang="kn">{ROLE_LABELS_KN[role]}</span>
                  </p>
                </article>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Section eyebrow — the mockup's rust kicker line, in Kannada */
  .eyebrow-kn {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-sindoor);
  }
</style>
