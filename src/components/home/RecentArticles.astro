---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../i18n/dates';
import { CATEGORY_LABELS } from '../articles/categories';
import { ui } from '../../i18n/ui';
import Bloom from '../motifs/Bloom.astro';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
const { home } = ui;
---

<section class="border-t border-ink/10 bg-cream" aria-labelledby="recent-articles-heading">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="reveal flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow-kn">
          <span data-kn lang="kn">{home.writingsEyebrow.kn}</span>
          <span data-en>{home.writingsEyebrow.en}</span>
        </p>
        <h2 id="recent-articles-heading" class="text-section font-bold">
          <span data-kn lang="kn">{home.writingsHeading.kn}</span>
          <span data-en>{home.writingsHeading.en}</span>
        </h2>
      </div>
      <div class="md:pb-2 md:text-right">
        <p class="max-w-sm font-body text-lg leading-relaxed text-stone">
          <span data-kn lang="kn">{home.writingsLede.kn}</span>
          <span data-en class="font-serif">{home.writingsLede.en}</span>
        </p>
        <a
          href="/articles"
          class="underline-reveal mt-3 inline-flex items-center gap-1.5 font-ui text-base font-semibold text-leaf active:text-sindoor"
        >
          <span data-kn lang="kn">{home.allArticles.kn}</span>
          <span data-en>{home.allArticles.en}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {
      articles.length === 1 ? (
        (() => {
          const article = articles[0];
          const { title, description, cover, coverAlt, author, category, pubDate } =
            article.data;
          const href = `/articles/${article.id}`;
          const date = formatDate(pubDate);
          const categoryLabel = CATEGORY_LABELS[category];
          return (
            <div class="reveal mt-10">
              <article class="group flex flex-col overflow-hidden border border-ink/10 bg-milk rounded-t-[3rem] md:rounded-t-none md:rounded-l-[4rem] md:flex-row">
                <a
                  href={href}
                  class="relative overflow-hidden md:w-1/2 md:shrink-0"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <img
                    src={cover}
                    alt={coverAlt ?? ''}
                    width="1200"
                    height="675"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] md:h-full md:aspect-auto"
                  />
                </a>
                <div class="flex flex-1 flex-col justify-center p-6 sm:p-8 lg:p-10">
                  <span class="badge w-fit rounded-full px-3 py-1 text-xs">
                    <span data-kn lang="kn">{categoryLabel.kn}</span>
                    <span data-en>{categoryLabel.en}</span>
                  </span>
                  <h3 class="mt-4 text-2xl font-bold leading-snug lg:text-3xl">
                    <a href={href} class="underline-reveal text-leaf">
                      <span lang="kn">{title}</span>
                    </a>
                  </h3>
                  <p class="mt-3 line-clamp-3 font-body text-base text-stone lg:text-lg">
                    <span lang="kn">{description}</span>
                  </p>
                  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-ink/10 pt-4">
                    <p class="font-ui text-sm text-stone">
                      <span class="text-stone/75">
                        <span data-kn lang="kn">{home.by.kn}</span>
                        <span data-en>{home.by.en}</span>
                      </span>{' '}
                      <span lang="kn" class="font-medium text-ink">{author}</span>
                      <span aria-hidden="true"> • </span>
                      <span>
                        <span data-kn lang="kn">{date.kn}</span>
                        <span data-en>{date.en}</span>
                      </span>
                    </p>
                    <a
                      href={href}
                      class="inline-flex items-center gap-1.5 font-ui text-sm font-semibold text-leaf transition-colors hover:text-sindoor"
                    >
                      <span data-kn lang="kn">{home.readFullArticle.kn}</span>
                      <span data-en>{home.readFullArticle.en}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          );
        })()
      ) : (
        <>
          <div class="rail-x mt-10 pb-2">
            {articles.map((article, i) => {
              const { title, description, cover, author, category, pubDate } =
                article.data;
              const href = `/articles/${article.id}`;
              const date = formatDate(pubDate);
              const categoryLabel = CATEGORY_LABELS[category];
              return (
                <article
                  class="reveal flex min-w-[86%] snap-center sm:min-w-[58%] lg:min-w-[30rem]"
                  style={`--reveal-delay: ${i * 90}ms`}
                >
                  <div class="group flex w-full flex-col border border-ink/10 bg-milk">
                    <a
                      href={href}
                      class="overflow-hidden rounded-t-[3rem]"
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <img
                        src={cover}
                        alt=""
                        width="1200"
                        height="675"
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    </a>
                    <div class="flex flex-1 flex-col p-5 sm:p-6">
                      <span class="badge w-fit rounded-full px-3 py-1 text-xs">
                        <span data-kn lang="kn">{categoryLabel.kn}</span>
                        <span data-en>{categoryLabel.en}</span>
                      </span>
                      <h3 class="mt-3 text-2xl leading-snug">
                        <a href={href} class="underline-reveal text-leaf">
                          <span lang="kn">{title}</span>
                        </a>
                      </h3>
                      <p class="mt-3 line-clamp-3 font-body text-base text-stone">
                        <span lang="kn">{description}</span>
                      </p>
                      <p class="mt-4 font-ui text-sm text-stone">
                        <span class="text-stone/75">
                          <span data-kn lang="kn">{home.by.kn}</span>
                          <span data-en>{home.by.en}</span>
                        </span>{' '}
                        <span lang="kn" class="font-medium text-ink">{author}</span>
                        <span aria-hidden="true"> • </span>
                        <span>
                          <span data-kn lang="kn">{date.kn}</span>
                          <span data-en>{date.en}</span>
                        </span>
                      </p>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
          <p class="swipe-hint md:hidden" aria-hidden="true">
            <span data-kn lang="kn">{home.swipeRead.kn}</span>
            <span data-en>{home.swipeRead.en}</span>
          </p>
        </>
      )
    }
  </div>
</section>
