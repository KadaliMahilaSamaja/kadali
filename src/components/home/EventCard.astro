---
import type { CollectionEntry } from 'astro:content';
import { dayOfMonth, knMonth, timeRangeIST, yearOf } from './dates';

interface Props {
  event: CollectionEntry<'events'>;
  /** Wide layout for a lone event: poster beside details, not a lone grid cell. */
  wide?: boolean;
}

const { event, wide = false } = Astro.props;
const { title, poster, summary, venue, startAt, endAt } = event.data;
const href = `/events/${event.id}`;
---

<article
  class:list={[
    'group flex h-full flex-col border border-ink/10 bg-milk',
    wide ? 'overflow-hidden rounded-t-[3rem] md:rounded-t-none md:rounded-l-[9rem] md:flex-row' : '',
  ]}
>
  <a
    href={href}
    class:list={[
      'relative overflow-hidden',
      wide
        ? 'md:w-72 lg:w-80 md:shrink-0 md:rounded-l-[9rem]'
        : 'rounded-t-[9rem]',
    ]}
    tabindex="-1"
    aria-hidden="true"
  >
    <!-- Posters are portrait (850x1100); the slot keeps their aspect -->
    <img
      src={poster}
      alt=""
      width="850"
      height="1100"
      loading="lazy"
      decoding="async"
      class:list={[
        'aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]',
        wide && 'md:h-full md:min-h-full md:aspect-auto',
      ]}
    />
    <!-- Date coin riding the arch's foot, brochure style. On the wide card
         the poster's bottom-left is a 9rem curve that clips the coin, so it
         stamps the straight top-right corner instead. -->
    <span
      class:list={[
        'absolute flex w-16 flex-col items-center rounded-full border border-ink/10 bg-milk/95 px-2 py-2.5 text-center',
        wide ? 'top-4 right-4' : 'bottom-3 left-3',
      ]}
    >
      <span class="text-2xl leading-none font-semibold text-leaf">
        {dayOfMonth(startAt)}
      </span>
      <span class="mt-1 font-ui text-xs leading-tight text-stone" lang="kn">
        {knMonth(startAt)}
      </span>
      <span class="font-ui text-[0.65rem] leading-tight text-stone">
        {yearOf(startAt)}
      </span>
    </span>
  </a>
  <div
    class:list={[
      'flex flex-1 flex-col items-center p-5 text-center sm:p-6',
      wide && 'md:items-start md:justify-center md:text-left',
    ]}
  >
    <p class="font-ui text-sm font-medium text-leaf">
      <span lang="kn">{timeRangeIST(startAt, endAt)}</span>
    </p>
    <h3 class="mt-2 text-xl leading-snug">
      <a href={href} class="underline-reveal text-leaf">
        <span lang="kn">{title}</span>
      </a>
    </h3>
    <p class="mt-3 inline-flex items-center gap-1.5 font-ui text-sm text-stone">
      <svg
        class="size-4 shrink-0 text-turmeric"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z"></path>
        <circle cx="12" cy="11" r="2.2"></circle>
      </svg>
      <span lang="kn">{venue}</span>
    </p>
    {
      wide && (
        <>
          <p class="mt-3 line-clamp-3 font-body text-base text-stone">
            <span lang="kn">{summary}</span>
          </p>
          <div class="mt-5">
            <a
              href={href}
              class="inline-flex min-h-[42px] items-center justify-center gap-1.5 rounded-full bg-leaf px-6 py-2 font-ui text-sm font-semibold text-milk transition-colors hover:bg-turmeric hover:text-ink focus-visible:outline-leaf active:translate-y-[1px]"
            >
              <span>ಕಾರ್ಯಕ್ರಮದ ವಿವರ</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </>
      )
    }
  </div>
</article>
