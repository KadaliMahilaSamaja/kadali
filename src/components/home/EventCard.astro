---
import type { CollectionEntry } from 'astro:content';
import { dayOfMonth, knMonth, timeRangeIST, yearOf } from './dates';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, poster, summary, venue, startAt, endAt } = event.data;
const href = `/events/${event.id}`;
---

<article class="group flex h-full flex-col border border-ink/10 bg-cream">
  <a
    href={href}
    class="overflow-hidden"
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={poster}
      alt=""
      width="850"
      height="1100"
      loading="lazy"
      decoding="async"
      class="aspect-[4/3] w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
    />
  </a>
  <div class="flex flex-1 gap-4 p-5 sm:gap-5">
    <div class="w-14 shrink-0 border-r border-ink/10 pr-3 text-center">
      <p class="font-display text-3xl leading-none text-rani">
        {dayOfMonth(startAt)}
      </p>
      <p class="mt-1 font-ui text-[0.7rem] leading-tight text-stone">
        <span lang="kn">{knMonth(startAt)}</span>
      </p>
      <p class="font-ui text-[0.7rem] text-stone">{yearOf(startAt)}</p>
    </div>
    <div class="min-w-0 flex-1">
      <p class="font-ui text-xs font-semibold tracking-wider text-rani uppercase">
        {timeRangeIST(startAt, endAt)}
      </p>
      <h3 class="mt-1 font-display text-xl leading-snug">
        <a href={href} class="underline-reveal text-ink">{title}</a>
      </h3>
      <p class="mt-2 font-ui text-sm text-stone">{venue}</p>
      <p class="mt-2 line-clamp-2 font-body text-base text-stone">
        {summary}
      </p>
    </div>
  </div>
</article>
