---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from './dates';

interface Props {
  announcements: CollectionEntry<'announcements'>[];
}

const { announcements } = Astro.props;
---

<section class="bg-jasmine" aria-labelledby="announcements-heading">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
    <p class="font-ui text-xs font-semibold tracking-[0.25em] text-rani uppercase">
      Notice board
    </p>
    <h2 id="announcements-heading" class="mt-3 font-display text-3xl font-semibold">
      Announcements
    </h2>

    <ul class="mt-8 divide-y divide-ink/10 border-y border-ink/10">
      {
        announcements.map((announcement) => (
          <li class="flex items-center gap-5 py-5">
            {announcement.data.image && (
              <img
                src={announcement.data.image}
                alt=""
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
                class="h-16 w-16 shrink-0 border border-ink/10 object-cover sm:h-20 sm:w-20"
              />
            )}
            <div class="min-w-0">
              <h3 class="font-display text-xl leading-snug text-ink">
                {announcement.data.title}
              </h3>
              <p class="mt-1 font-ui text-sm text-stone">
                Posted {formatDate(announcement.data.pubDate)}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
