---
import FlowerLine from '../motifs/FlowerLine.astro';
---

<section
  class="relative overflow-hidden rounded-t-[3rem] bg-leaf text-milk sm:rounded-t-[5rem]"
  aria-labelledby="join-heading"
>
  <!-- White florals on the green band, brochure-frame style -->
  <FlowerLine
    class="reveal pointer-events-none absolute -right-6 -bottom-8 w-28 rotate-12 text-milk/10 sm:w-36"
  />
  <FlowerLine
    class="reveal pointer-events-none absolute top-16 right-10 w-16 -rotate-12 text-milk/10"
  />
  <FlowerLine
    class="reveal pointer-events-none absolute bottom-10 left-10 hidden w-16 rotate-6 text-milk/10 sm:block"
  />

  <div class="reveal relative mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 md:py-20">
    <p class="font-ui text-sm font-bold tracking-[0.1em] text-turmeric">
      ನಿಮ್ಮನ್ನು ಸ್ವಾಗತಿಸುತ್ತೇವೆ
    </p>
    <h2 id="join-heading" class="mt-4 text-section font-bold text-milk">
      ಬನ್ನಿ, ನಮ್ಮೊಂದಿಗೆ ಬೆಸೆಯಿರಿ
    </h2>
    <p class="mt-5 font-body text-xl text-milk/85">
      ನಮ್ಮ ಕಾರ್ಯಕ್ರಮಗಳ ಬಗ್ಗೆ ತಿಳಿಯಲು, ಸದಸ್ಯರಾಗಲು ಅಥವಾ ನಿಮ್ಮ ಬರಹಗಳನ್ನು
      ಹಂಚಿಕೊಳ್ಳಲು ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ.
    </p>
    <div class="mt-8">
      <a
        href="mailto:contact@kadali.org?subject=%E0%B2%95%E0%B2%A6%E0%B2%B3%E0%B2%BF%20%E0%B2%B5%E0%B2%A8%E0%B2%BF%E0%B2%A4%E0%B2%BE%20%E0%B2%B8%E0%B2%AE%E0%B2%BE%E0%B2%9C%20%E2%80%94%20%E0%B2%B8%E0%B2%82%E0%B2%AA%E0%B2%B0%E0%B3%8D%E0%B2%95"
        class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-milk px-8 py-3 font-ui text-base font-semibold text-ink transition-colors duration-200 hover:bg-turmeric focus-visible:outline-milk active:translate-y-[1px]"
      >
        <span>ಸಂಪರ್ಕಿಸಿ</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
