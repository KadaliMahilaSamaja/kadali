---
interface Props {
  heading: string;
  description: string;
}

const { heading, description } = Astro.props;

/* The mockup sets the headline as beat lines ("ಭಕ್ತಿ ಬೇರು. ಸಂಸ್ಕೃತಿ ಉಸಿರು.
   ಮಹಿಳೆಯರ ಒಗ್ಗಟ್ಟು.") — split on the full stops, keep the punctuation, and
   gold the middle line of a three-beat head. A period-free heading renders
   as one unbroken line. */
const lines = heading
  .split('.')
  .map((line) => line.trim())
  .filter(Boolean)
  .map((line) => `${line}.`);
const goldLine = lines.length === 3 ? 1 : -1;

/* Kannada line-breaks at syllable boundaries inside a word; wrapping each
   word unbreakably keeps breaks at the spaces the author wrote. */
const words = (line: string) => line.split(/\s+/);
const wordCount = lines.reduce((n, line) => n + words(line).length, 0);
/* Entrance choreography: each word 90ms apart, then sentence, actions, art. */
const wordDelay = (i: number) => 140 + i * 90;
const afterWords = 140 + wordCount * 90;
---

<section
  class="hero relative isolate overflow-hidden text-milk md:flex md:min-h-[calc(100svh-65px)] md:flex-col md:justify-center"
>
  <!-- Field: deep-leaf radial wash with faint diagonal gold stripes -->
  <div class="hero-field" aria-hidden="true"></div>
  <!-- Concentric rings behind the artwork, like the mockup's ornament -->
  <div class="hero-rings" aria-hidden="true"></div>

  <div
    class="relative z-[4] mx-auto w-full max-w-6xl px-4 pt-14 pb-6 sm:px-6 md:pt-0 md:pb-0"
  >
    <!-- Word block: gold kicker, serif beat lines, one sentence, two actions -->
    <div class="min-w-0 md:max-w-[36rem]">
      <p class="hero-kicker hero-fade font-ui [animation-delay:40ms]">
        ಕದಳಿ ವನಿತಾ ಸಮಾಜ · ಶಿವಮೊಗ್ಗ
      </p>
      <h1 class="hero-title mt-5">
        {
          lines.map((line, li) => (
            <span class:list={['block', li === goldLine && 'hero-title-gold']}>
              {words(line).map((word, wi) => (
                <>
                  {wi > 0 && ' '}
                  <span
                    class="hero-rise whitespace-nowrap"
                    style={`animation-delay: ${wordDelay(
                      lines
                        .slice(0, li)
                        .reduce((n, l) => n + words(l).length, 0) + wi,
                    )}ms`}
                  >
                    {word}
                  </span>
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p
        class="hero-rise mt-5 max-w-md font-body text-lg leading-relaxed text-milk/80 md:text-xl"
        style={`animation-delay: ${afterWords}ms`}
      >
        {description}
      </p>
      <div
        class="hero-rise mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center"
        style={`animation-delay: ${afterWords + 120}ms`}
      >
        <a
          href="#aim"
          class="hero-btn-gold inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-7 py-3 font-ui text-base font-semibold"
        >
          <span>ಕದಳಿಯನ್ನು ಅರಿಯಿರಿ</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="/articles"
          class="hero-btn-ghost inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full px-7 py-3 font-ui text-base font-semibold"
        >
          <span>ನಮ್ಮ ಬರಹಗಳನ್ನು ಓದಿ</span>
        </a>
      </div>
      <p
        class="hero-note hero-fade mt-12 hidden md:flex"
        style="animation-delay: 700ms"
      >
        <span lang="kn">ಮಹಿಳೆಯರ ಧ್ವನಿ · ನಮ್ಮ ಪರಂಪರೆ · ನಾಳೆಯ ಪೀಳಿಗೆ</span>
      </p>
    </div>
  </div>

  <!-- Akkamahadevi — the painting fills the right field; the halo turns
       over her head inside the stage, so it tracks the artwork at any size.
       In flow below the copy on phones; anchored to the panel's bottom-right
       corner from md up, behind the copy's whitespace like the mockup. -->
  <div class="hero-art hero-arrive" style="animation-delay: 300ms">
    <div class="art-stage">
      <div class="halo" aria-hidden="true"><span class="halo-glint"></span></div>
      <picture>
        <source srcset="/images/akkamahadevi-hero.webp" type="image/webp" />
        <img
          src="/images/akkamahadevi-hero.png"
          alt="ಬಾಳೆಗಿಡಗಳ ನಡುವೆ ಧ್ಯಾನದಲ್ಲಿ ಕುಳಿತ ಅಕ್ಕಮಹಾದೇವಿ"
          width="1039"
          height="627"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </div>

  <p class="art-caption" aria-hidden="true" lang="kn">
    ಅಕ್ಕಮಹಾದೇವಿ · ವಚನ ಪರಂಪರೆ
  </p>
  <a href="#aim" class="scroll-cue font-ui">
    <b aria-hidden="true"></b> ಮುಂದೆ ಸಾಗಿ
  </a>
</section>

<style>
  /* ——— The dark leaf field and its golds (scoped to this panel) ——— */
  .hero {
    --hf-hi: #33604a;
    --hf-mid: #1d4632;
    --hf-deep: #0e2a1e;
    --hf-fade: #163427;
    --hg-kicker: #e1bd78;
    --hg-em: #e4c17f;
    --hg-btn: #dfbd7a;
    --hg-caption: #e6c27e;
    --hg-ring: 235 194 105;
    background-color: var(--hf-deep);
  }

  .hero-field {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: radial-gradient(
      ellipse at 74% 42%,
      var(--hf-hi) 0%,
      var(--hf-mid) 42%,
      var(--hf-deep) 82%
    );
  }

  .hero-field::before {
    content: '';
    position: absolute;
    inset: -20%;
    background: repeating-linear-gradient(
      112deg,
      transparent 0 74px,
      rgb(220 195 135 / 0.05) 75px 76px
    );
    transform: rotate(-8deg);
  }

  .hero-rings {
    position: absolute;
    right: -70px;
    top: 90px;
    width: 54vw;
    max-width: 730px;
    aspect-ratio: 1;
    border: 1px solid rgb(216 177 101 / 0.16);
    border-radius: 50%;
    z-index: -1;
    pointer-events: none;
  }

  .hero-rings::before,
  .hero-rings::after {
    content: '';
    position: absolute;
    border: 1px solid rgb(216 177 101 / 0.12);
    border-radius: 50%;
  }

  .hero-rings::before {
    inset: 8%;
  }

  .hero-rings::after {
    inset: 18%;
  }

  /* ——— Copy ——— */
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--hg-kicker);
    font-size: 13px;
    font-weight: 600;
    /* Kannada kicker: vowel signs ride the consonants, so keep the
       tracking gentle (the mockup's .2em was for its Latin kicker) */
    letter-spacing: 0.08em;
  }

  .hero-kicker::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .hero-title {
    font-family: var(--font-kn-serif);
    font-weight: 500;
    /* Fluid font size with Kannada clearance: 1.28 line-height gives room for
       stacked ottakshara (subscript consonants) and vowel signs. */
    font-size: clamp(2rem, 0.9rem + 4.2vw, 4rem);
    line-height: 1.28;
    color: var(--color-milk);
    text-wrap: initial;
  }

  .hero-title-gold {
    color: var(--hg-em);
  }

  .hero-note {
    align-items: center;
    gap: 12px;
    color: rgb(255 253 247 / 0.68);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .hero-note::before {
    content: '';
    width: 35px;
    height: 1px;
    background: var(--hg-em);
  }

  /* ——— Actions ——— */
  .hero-btn-gold {
    background-color: var(--hg-btn);
    color: #2b201a;
    transition:
      transform 200ms ease,
      background-color 200ms ease;
  }

  .hero-btn-gold:hover {
    transform: translateY(-2px);
    background-color: #e9ca8d;
  }

  .hero-btn-gold:active {
    transform: translateY(1px);
  }

  .hero-btn-ghost {
    border: 1px solid rgb(255 253 247 / 0.42);
    color: var(--color-milk);
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .hero-btn-ghost:hover {
    border-color: rgb(255 253 247 / 0.8);
    background-color: rgb(255 253 247 / 0.08);
  }

  .hero a:focus-visible {
    outline-color: var(--hg-em);
  }

  /* ——— The artwork and its stage ——— */
  .hero-art {
    margin: 0 -8% -1.5rem -3%;
    z-index: 1;
  }

  .art-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1039 / 627;
  }

  .art-stage img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 20px 28px rgb(0 0 0 / 0.22));
  }

  /* Shadow pooling at the figure's base grounds her in the field */
  .art-stage::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    z-index: 2;
    background: linear-gradient(0deg, var(--hf-fade), transparent);
    pointer-events: none;
  }

  .hero-arrive {
    animation: kadali-art-arrive 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes kadali-art-arrive {
    from {
      opacity: 0;
      transform: translateY(26px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ——— The revolving halo ———
     Anchored to the stage, not the viewport: her head sits at ~51% across,
     ~19% down in the painting, so percentage offsets keep the ring on her
     head at every render size. The ring and its dashed inner circle turn
     together (34s); the broken outer ring counter-turns (18s); the glint
     rides the ring's crown. Reduced motion is neutralised globally. */
  .halo {
    position: absolute;
    z-index: 0;
    top: 19%;
    left: 51%;
    width: 33%;
    aspect-ratio: 1;
    margin: -16.5% 0 0 -16.5%;
    border: 1px solid rgb(var(--hg-ring) / 0.92);
    border-radius: 50%;
    box-shadow:
      0 0 0 7px rgb(var(--hg-ring) / 0.06),
      0 0 38px rgb(var(--hg-ring) / 0.14),
      inset 0 0 24px rgb(var(--hg-ring) / 0.1);
    animation: kadali-halo-spin 34s linear infinite;
  }

  .halo::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px dashed rgb(var(--hg-ring) / 0.65);
    border-radius: 50%;
  }

  .halo::after {
    content: '';
    position: absolute;
    inset: -12px;
    border: 1px solid rgb(var(--hg-ring) / 0.18);
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    animation: kadali-halo-spin 18s linear infinite reverse;
  }

  .halo-glint {
    position: absolute;
    left: 50%;
    top: -3.5px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: #ffe2a0;
    box-shadow: 0 0 18px 5px rgb(255 220 145 / 0.6);
  }

  @keyframes kadali-halo-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ——— Caption and scroll cue ——— */
  .art-caption {
    position: absolute;
    right: clamp(14px, 3.5vw, 28px);
    top: 44%;
    z-index: 5;
    writing-mode: vertical-rl;
    color: var(--hg-caption);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.16em;
    pointer-events: none;
  }

  @media (max-width: 47.99rem) {
    .art-caption {
      display: none;
    }
  }

  .scroll-cue {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgb(255 253 247 / 0.7);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .scroll-cue b {
    display: block;
    width: 1px;
    height: 24px;
    background: #d7b46d;
    animation: kadali-cue 1.8s ease-in-out infinite;
  }

  @keyframes kadali-cue {
    0%,
    100% {
      transform: scaleY(0.65);
      transform-origin: top;
      opacity: 0.5;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
      opacity: 1;
    }
  }

  /* Below md the art flows under the cue's fixed slot; hiding it keeps the
       figure's base clean. Declared after the base rule so it wins the tie. */
  @media (max-width: 47.99rem) {
    .scroll-cue {
      display: none;
    }
  }

  /* ——— From md: the painting anchors to the panel's bottom-right corner,
         large and partly behind the copy, as in the mockup ——— */
  @media (min-width: 48rem) {
    .hero-art {
      position: absolute;
      right: -4%;
      bottom: -3%;
      width: 60%;
      margin: 0;
    }

    .hero-rings {
      top: 120px;
    }

    .art-caption {
      top: 38%;
    }

    .scroll-cue {
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  @media (min-width: 1024px) {
    .hero-art {
      right: -1.5%;
      bottom: -4%;
      width: min(62%, 780px);
    }
  }

  @media (max-width: 47.99rem) {
    .halo::before {
      inset: 7px;
    }

    .halo::after {
      inset: -8px;
    }

    .halo {
      box-shadow:
        0 0 0 5px rgb(var(--hg-ring) / 0.05),
        0 0 28px rgb(var(--hg-ring) / 0.12),
        inset 0 0 14px rgb(var(--hg-ring) / 0.08);
    }

    .halo-glint {
      width: 5px;
      height: 5px;
      top: -2.5px;
      margin-left: -2.5px;
    }
  }
</style>
