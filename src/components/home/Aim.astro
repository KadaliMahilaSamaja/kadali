---
import Bloom from '../motifs/Bloom.astro';
import FlowerLine from '../motifs/FlowerLine.astro';
import { ui } from '../../i18n/ui';

const { aim } = ui;

/* The mockup's intro paragraph, split into words server-side so the
   scroll-driven light-up (word-reveal) needs no DOM surgery at runtime.
   The strong phrase keeps its weight across the split. Both languages
   render their own paragraph; only the active one is visible. */
const introSegments = [
  [
    { text: aim.intro1.kn },
    { text: aim.intro2.kn, strong: true },
    { text: aim.intro3.kn },
  ],
  [
    { text: aim.intro1.en },
    { text: aim.intro2.en, strong: true },
    { text: aim.intro3.en },
  ],
] as const;
---

<section
  id="aim"
  class="relative overflow-hidden bg-cream"
  aria-labelledby="aim-heading"
>
  <!-- white outline florals on the cream, barely-there brochure scatter -->
  <FlowerLine
    class="pointer-events-none absolute -top-8 right-8 w-24 rotate-12 text-milk/70 sm:w-32"
  />
  <FlowerLine
    class="pointer-events-none absolute bottom-6 left-6 hidden w-16 -rotate-6 text-milk/60 lg:block"
  />

  <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <!-- Intro split: beat-line heading left, the light-up paragraph right -->
    <div class="grid items-start gap-8 md:grid-cols-[0.9fr_1.1fr] md:gap-14">
      <div class="reveal">
        <p class="eyebrow-kn">
          <span data-kn lang="kn">{aim.eyebrow.kn}</span>
          <span data-en>{aim.eyebrow.en}</span>
        </p>
        <h2 id="aim-heading" class="text-section font-bold">
          <span data-kn lang="kn">{aim.heading1.kn}</span>
          <span data-en>{aim.heading1.en}</span>
          <span class="block text-sindoor">
            <span data-kn lang="kn">{aim.heading2.kn}</span>
            <span data-en>{aim.heading2.en}</span>
          </span>
        </h2>
      </div>
      <div class="reveal" style="--reveal-delay: 120ms">
        {
          introSegments.map((segments, variant) => (
            <p
              class="word-reveal font-display text-xl leading-relaxed text-ink md:text-2xl"
              {...(variant === 0 ? { 'data-kn': true, lang: 'kn' } : { 'data-en': true })}
            >
              {segments.map((segment) =>
                segment.text.split(/\s+/).map((word) => (
                  <span class:list={['w', 'strong' in segment && segment.strong ? 'font-semibold' : 'font-medium']}>
                    {word}{' '}
                  </span>
                )),
              )}
            </p>
          ))
        }
        <a
          href="/contact"
          class="underline-reveal mt-6 inline-flex items-center gap-1.5 font-ui text-base font-semibold text-leaf active:text-sindoor"
        >
          <span data-kn lang="kn">{aim.joinHands.kn}</span>
          <span data-en>{aim.joinHands.en}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Temple-arch cards: the shrine window from the brochure, as quiet
         milk-on-cream tiles. -->
    <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {
        aim.pillars.map((pillar, i) => (
          <div class="reveal" style={`--reveal-delay: ${i * 90}ms`}>
            <article class="flex h-full flex-col items-center rounded-t-[9rem] border border-ink/10 bg-milk px-3.5 pb-6 pt-10 text-center sm:px-6 sm:pb-7 sm:pt-14">
              <span class="text-turmeric" aria-hidden="true">
                {pillar.icon === 'spirit' && <Bloom class="block w-10" />}
                {pillar.icon === 'lamp' && (
                  <svg
                    class="block w-10"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3c1.6 1.8 2.4 3.2 2.4 4.6a2.4 2.4 0 1 1-4.8 0C9.6 6.2 10.4 4.8 12 3Z" />
                    <path d="M4.5 12.5h15" />
                    <path d="M6 12.5c.7 2.6 3 4.2 6 4.2s5.3-1.6 6-4.2" />
                    <path d="M12 16.7v2.3" />
                    <path d="M9 21h6" />
                  </svg>
                )}
                {pillar.icon === 'people' && (
                  <svg
                    class="block w-10"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="9" cy="8" r="3.2" />
                    <circle cx="16.5" cy="9.5" r="2.6" />
                    <path d="M3.5 19c.6-3.2 2.9-5 5.5-5s4.9 1.8 5.5 5" />
                    <path d="M14.5 14.6c2.3.3 4.2 1.9 4.8 4.4" />
                  </svg>
                )}
                {pillar.icon === 'book' && (
                  <svg
                    class="block w-10"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 6.5C10.2 5 7.8 4.5 4.5 4.5v13c3.3 0 5.7.5 7.5 2 1.8-1.5 4.2-2 7.5-2v-13c-3.3 0-5.7.5-7.5 2Z" />
                    <path d="M12 6.5v13" />
                  </svg>
                )}
              </span>
              <h3 class="mt-4 text-xl font-bold">
                <span data-kn lang="kn">{pillar.title.kn}</span>
                <span data-en>{pillar.title.en}</span>
              </h3>
              <p class="mt-3 font-body text-sm leading-relaxed text-stone sm:text-base">
                <span data-kn lang="kn">{pillar.body.kn}</span>
                <span data-en class="font-serif">{pillar.body.en}</span>
              </p>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>
