---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from './dates';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, cover, coverAlt, author, category, pubDate } =
  article.data;
const href = `/articles/${article.id}`;
const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);
---

<section class="bg-cream" aria-labelledby="featured-article-heading">
  <div
    class="group mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:gap-16 md:py-24"
  >
    <div class="md:order-2">
      <p class="inline-block border border-rani/40 px-3 py-1 font-ui text-xs font-semibold tracking-[0.2em] text-rani uppercase">
        {categoryLabel}
      </p>
      <h2
        id="featured-article-heading"
        class="mt-5 font-display text-3xl font-semibold md:text-4xl"
      >
        <a href={href} class="underline-reveal">{title}</a>
      </h2>
      <p class="mt-4 font-body text-lg text-stone">{description}</p>
      <p class="mt-5 font-ui text-sm text-stone">
        {author} · {formatDate(pubDate)}
      </p>
      <a
        href={href}
        class="underline-reveal mt-6 inline-block font-ui text-sm font-semibold text-rani"
      >
        Read the article →
      </a>
    </div>

    <div class="mx-auto w-full max-w-sm md:order-1 md:max-w-none">
      <a
        href={href}
        class="block overflow-hidden rounded-t-[999px] border border-ink/10"
        tabindex="-1"
        aria-hidden="true"
      >
        <!-- Above the fold on most viewports, so eager. -->
        <img
          src={cover}
          alt={coverAlt}
          width="1200"
          height="675"
          loading="eager"
          decoding="async"
          class="aspect-[4/5] w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
        />
      </a>
    </div>
  </div>
</section>
