---
/**
 * Compact past-event row — small date block, title, venue · time, chevron.
 * Used inside a divide-y list in the past group.
 */
import type { CollectionEntry } from 'astro:content';
import { istInstant, istTimeRange } from '../../i18n/dates';
import { ui } from '../../i18n/ui';
import CancelledBadge from './CancelledBadge.astro';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, venue, endAt, startAt, status } = event.data;
const { day, month, year } = istInstant(startAt);
const time = istTimeRange(startAt, endAt);
const href = `/events/${event.id}`;
---

<li>
  <a href={href} class="group flex items-center gap-4 py-4 sm:gap-6">
    <div class="w-14 shrink-0 text-center sm:w-16">
      <span class="font-display text-2xl font-semibold text-leaf sm:text-3xl">
        {day}
      </span>
      <span class="block font-ui text-xs leading-tight">
        <span data-kn lang="kn" class="text-ink">{month.kn}</span>
        <span data-en class="text-ink">{month.en}</span>
        <span class="text-stone">{year}</span>
      </span>
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="font-display text-lg leading-snug">
        <span
          class="text-ink underline-offset-4 group-hover:text-leaf group-hover:underline group-hover:decoration-leaf group-hover:decoration-2"
        >
          <span lang="kn">{title}</span>
        </span>
      </h3>
      <p class="mt-1 font-ui text-sm text-stone">
        <span lang="kn">{venue}</span> ·
        <span data-kn lang="kn">{time.kn}</span>
        <span data-en>{time.en}</span>
        {status === 'cancelled' && (
          <span class="sr-only">
            (<span data-kn lang="kn">{ui.events.cancelledShort.kn}</span><span data-en>{ui.events.cancelledShort.en}</span>)
          </span>
        )}
      </p>
    </div>
    {status === 'cancelled' && <div class="hidden sm:block"><CancelledBadge /></div>}
    <span aria-hidden="true" class="text-leaf">→</span>
  </a>
</li>
