---
/**
 * Event card for grids — portrait poster on top, date block, title, venue,
 * summary. Whole card is one link; hover scales the poster and reveals a
 * title underline (200ms, reduced-motion aware via global.css).
 */
import type { CollectionEntry } from 'astro:content';
import EventDate from './EventDate.astro';
import CancelledBadge from './CancelledBadge.astro';
import { ui } from '../../i18n/ui';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, poster, summary, venue, endAt, startAt, status } = event.data;
const href = `/events/${event.id}`;
---

<article class="border border-ink/10 bg-cream">
  <a href={href} class="group flex h-full flex-col">
    <div class="overflow-hidden">
      <img
        src={poster}
        alt={`${title} — ${ui.events.posterSuffix.kn}`}
        width="850"
        height="1100"
        loading="lazy"
        decoding="async"
        class="h-auto w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
      />
    </div>
    <div class="flex flex-1 flex-col gap-3 p-5">
      {status === 'cancelled' && <CancelledBadge />}
      <EventDate startAt={startAt} endAt={endAt} size="compact" />
      <h3 class="font-display text-xl leading-snug">
        <span
          class="text-ink underline-offset-4 group-hover:text-leaf group-hover:underline group-hover:decoration-leaf group-hover:decoration-2"
        >
          <span lang="kn">{title}</span>
        </span>
      </h3>
      <p class="font-ui text-sm text-stone">
        <span class="font-semibold">
          <span data-kn lang="kn">{ui.events.venue.kn}</span>
          <span data-en>{ui.events.venue.en}</span>
        </span>{' '}
        <span lang="kn">{venue}</span>
      </p>
      <p class="line-clamp-3 font-body text-sm text-stone"><span lang="kn">{summary}</span></p>
    </div>
  </a>
</article>
