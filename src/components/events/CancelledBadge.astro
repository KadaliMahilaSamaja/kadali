---
/**
 * "Cancelled" pill shown on events whose frontmatter status is `cancelled`.
 * Sindoor red — the palette's sparing accent — so it reads as an alert.
 */
import { ui } from '../../i18n/ui';
---

<p
  class="inline-flex w-fit items-center gap-2 bg-sindoor px-2.5 py-1 font-ui text-xs font-semibold uppercase tracking-wider text-cream"
>
  <span data-kn lang="kn" class="normal-case">{ui.events.cancelled.kn}</span>
  <span data-en class="normal-case">{ui.events.cancelled.en}</span>
</p>
