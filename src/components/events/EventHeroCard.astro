---
/**
 * Featured event hero card — temple-arch-masked poster beside an editorial
 * content column. Rendered as the first item of the upcoming group.
 */
import type { CollectionEntry } from 'astro:content';
import EventDate from './EventDate.astro';
import CancelledBadge from './CancelledBadge.astro';
import { ui } from '../../i18n/ui';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, poster, summary, venue, endAt, startAt, status } = event.data;
const href = `/events/${event.id}`;
---

<article class="border border-ink/10 bg-cream">
  <a href={href} class="group grid md:grid-cols-2">
    <div class="overflow-hidden rounded-t-[999px]">
      <img
        src={poster}
        alt={`${title} — ${ui.events.posterSuffix.kn}`}
        width="850"
        height="1100"
        loading="lazy"
        decoding="async"
        class="h-auto w-full object-cover transition-transform duration-200 group-hover:scale-[1.02] md:h-full"
      />
    </div>
    <div class="flex flex-col items-start gap-4 p-6 sm:p-8">
      {status === 'cancelled' && <CancelledBadge />}
      <p
        class="font-ui text-xs font-semibold uppercase tracking-wider text-leaf"
      >
        <span data-kn lang="kn" class="normal-case">{ui.events.featured.kn}</span>
        <span data-en class="normal-case">{ui.events.featured.en}</span>
      </p>
      <h3 class="font-display text-2xl leading-snug sm:text-3xl">
        <span
          class="text-ink underline-offset-4 group-hover:text-leaf group-hover:underline group-hover:decoration-leaf group-hover:decoration-2"
        >
          <span lang="kn">{title}</span>
        </span>
      </h3>
      <EventDate startAt={startAt} endAt={endAt} />
      <p class="font-ui text-sm text-stone">
        <span class="font-semibold">
          <span data-kn lang="kn">{ui.events.venue.kn}</span>
          <span data-en>{ui.events.venue.en}</span>
        </span>{' '}
        <span lang="kn">{venue}</span>
      </p>
      <p class="line-clamp-4 font-body text-base text-stone"><span lang="kn">{summary}</span></p>
      <span
        class="mt-auto font-ui text-sm font-semibold text-leaf underline-offset-4 group-hover:underline group-hover:decoration-2"
      >
        <span data-kn lang="kn">{ui.events.viewDetails.kn}</span>
        <span data-en>{ui.events.viewDetails.en}</span>
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>
