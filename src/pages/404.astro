---
import BaseLayout from '../components/BaseLayout.astro';
import Arch from '../components/motifs/Arch.astro';
import Beads from '../components/motifs/Beads.astro';
import { ui } from '../i18n/ui';

const { notFound, nav } = ui;

const links = [
  { href: '/', label: nav.home },
  { href: '/articles', label: nav.articles },
  { href: '/events', label: nav.events },
];
---

<BaseLayout
  title="ಪುಟ ಸಿಗುದಿಲ್ಲ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ"
  titleEn="Page not found · Kadali Vanita Samaja"
  description="ನೀವು ಹುಡುಕುತ್ತಿದ್ದ ಪುಟ ಸಿಗಲಿಲ್ಲ. ಮುಖಪುಟಕ್ಕೆ ಹಿಂತಿರುಗಿ ಅಥವಾ ಬರಹಗಳು, ಕಾರ್ಯಕ್ರಮಗಳನ್ನು ನೋಡಿ."
  descriptionEn="The page you were looking for wasn't found. Return to the homepage or browse the writings and events."
>
  <section class="relative overflow-hidden">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center px-4 py-20 text-center sm:px-6 sm:py-28"
    >
      <!-- 404 numeral inside a temple arch, decorative -->
      <div class="relative flex justify-center">
        <Arch width={220} class="text-leaf/20" />
        <span
          aria-hidden="true"
          class="absolute inset-x-0 bottom-5 font-display text-6xl font-semibold tracking-tight text-leaf sm:text-7xl"
        >
          404
        </span>
      </div>

      <h1
        class="mt-8 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
      >
        <span data-kn lang="kn">{notFound.heading.kn}</span>
        <span data-en>{notFound.heading.en}</span>
      </h1>

      <Beads class="mt-8 w-40 text-leaf" />

      <p class="mt-8 max-w-md font-body text-lg leading-relaxed text-stone">
        <span data-kn lang="kn">{notFound.lede.kn}</span>
        <span data-en class="font-serif">{notFound.lede.en}</span>
      </p>

      <ul class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {
          links.map(({ href, label }, index) => (
            <li>
              <a
                href={href}
                class:list={[
                  'inline-flex items-center rounded-full px-5 py-2.5 font-ui text-sm font-semibold transition-colors duration-200',
                  index === 0
                    ? 'bg-leaf text-cream hover:bg-ink'
                    : 'border border-ink/15 text-ink hover:border-leaf hover:text-leaf',
                ]}
              >
                <span data-kn lang="kn">{label.kn}</span>
                <span data-en>{label.en}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
