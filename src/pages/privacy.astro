import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/pages/PageHero.astro';

// Single source of the "last updated" date; hardcode, do not use the build date.
const lastUpdated = '2026-11-12';
---

<BaseLayout
  title="ಗೋಪ್ಯತೆ ನೀತಿ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ"
  description="ಕದಳಿಯ ಗೋಪ್ಯತಾ ನೀತಿ ಸರಳ ಮಾತಿನಲ್ಲಿ: ವಿಶ್ಲೇಷಣೆ ಇಲ್ಲ, ಹಿಂಬಾಲಿಸುವ ಪಿಕ್ಸೆಲ್ ಇಲ್ಲ, ತಾಣದ ಕುಕೀ ಇಲ್ಲ; Cloudflare ಅಂಚಿನ ದಾಖಲೆ ಮಾತ್ರ; ಛಾಯಾಚಿತ್ರ ಒಪ್ಪಿಗೆಯಿಂದ ಮಾತ್ರ."
>
  <PageHero
    eyebrow="ಗೋಪ್ಯತೆ"
    title="ಗೋಪ್ಯತೆ ನೀತಿ"
    lede="ವಾಡಿಕೆಯ ಮಬ್ಬಿಲ್ಲದೆ ಇಡೀ ನೀತಿ ಇಷ್ಟೇ: ಏನನ್ನೂ ಸಂಗ್ರಹಿಸಿಲ್ಲ, ಏನನ್ನೂ ಹಿಂಬಾಲಿಸಿಲ್ಲ, ಏನನ್ನೂ ಮಾರಿಲ್ಲ — ಮಾರಲು ಏನೂ ಇಲ್ಲವಾದ್ದರಿಂದ."
    tone="cream"
  />

  <article
    class="prose-kadali mx-auto max-w-3xl px-4 py-16 sm:px-6"
  >
    <p class="font-ui text-sm text-stone">
      ಕೊನೆಯ ಪರಿಷ್ಕರಣೆ: <time datetime={lastUpdated}>12 ನವೆಂಬರ್ 2026</time>.
    </p>

    <h2>ಸಂಕ್ಷಿಪ್ತ ರೂಪ</h2>
    <ul>
      <li>ವಿಶ್ಲೇಷಣೆ ಇಲ್ಲ, ಹಿಂಬಾಲಿಸುವ ಪಿಕ್ಸೆಲ್ ಇಲ್ಲ, ಜಾಹೀರಾತು ಇಲ್ಲ — ಈ ತಾಣದಲ್ಲಿ ಅಂಥದ್ದೇನೂ ಇಲ್ಲ.</li>
      <li>ಈ ತಾಣ ತನ್ನದೇ ಆದ ಯಾವುದೇ ಕುಕೀ ಇಡುವುದಿಲ್ಲ.</li>
      <li>ವಾಟ್ಸ್‌ಆಪ್ ಅಥವಾ ಇಮೇಲ್ ಸಂದೇಶ ಸಂಘಕ್ಕೆ ಹೋಗುತ್ತದೆ, ಇಲ್ಲಿನ ಯಾವುದೇ ದತ್ತಸಂಚಯಕ್ಕೆ ಅಲ್ಲ.</li>
      <li>ನಮ್ಮ ಆತಿಥ್ಯದಾರರು (Cloudflare) ಭದ್ರತೆಗಾಗಿ ರೂಢಿಯ ಅಂಚಿನ ದಾಖಲೆ ಇಡುತ್ತಾರೆ; ನಾವದನ್ನು ಅಗೆಯುವುದಿಲ್ಲ.</li>
      <li>ಸದಸ್ಸೆಯರ ಛಾಯಾಚಿತ್ರ ಒಪ್ಪಿಗೆಯಿಂದ ಮಾತ್ರ ಪ್ರಕಟ; ಕೇಳಿದರೆ ತೆಗೆಯುತ್ತೇವೆ.</li>
      <li>ನಮ್ಮ ಪ್ರಯತ್ನ ಬದಲಾದಾಗ ಮಾತ್ರ ಈ ನೀತಿ ಬದಲಾಗುತ್ತದೆ — ಮೇಲಿನ ದಿನಾಂಕ ಅದನ್ನು ಹೇಳುತ್ತದೆ.</li>
    </ul>

    <h2>ನಾವು ಸಂಗ್ರಹಿಸುವುದು</h2>
    <p>
      ಯಾವುದನ್ನೂ ಬೇಕೆಂದೇ ಇಲ್ಲ. ಈ ತಾಣದ ಪುಟಗಳು ಸ್ಥಿರ ಕಡತಗಳು: ನಿಮ್ಮ ವೀಕ್ಷಕ
      ಪುಟವನ್ನು ಕೇಳುತ್ತದೆ, ಅದು ಸಿಗುತ್ತದೆ; ಆಮೇಲೆ ನಿಮ್ಮನ್ನು ಹಿಂಬಾಲಿಸುವವರಿಲ್ಲ.
      ವಿಶ್ಲೇಷಣೆಯ ಲಿಪಿ ಇಲ್ಲ, ಹಿಂಬಾಲಿಸುವ ಪಿಕ್ಸೆಲ್ ಇಲ್ಲ, ಒಳಗೊಂಡ ಜಾಹೀರಾತು
      ಇಲ್ಲ, ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಬಿಡಿಸುವ ಸಂಪರ್ಕ ಫಾರ್ಮೂ ಇಲ್ಲ.
    </p>
    <p>
      ವಾಟ್ಸ್‌ಆಪ್, ದೂರವಾಣಿ ಅಥವಾ ಇಮೇಲ್ ಮೂಲಕ ಸಂಪರ್ಕಿಸಿದರೆ, ನೀವು ಕಳಿಸಿದ್ದು
      ಓದುವ ಸಂಘದ ಅಧಿಕಾರಿಗಳ ಬಳಿಯೇ ಇರುತ್ತದೆ; ನಿಮಗೆ ಉತ್ತರಿಸಲೂ, ಸಂಘದ
      ಕೆಲಸಗಳನ್ನು ನಡೆಸಲೂ ಅದನ್ನು ಮಾತ್ರ ಬಳಸಿಕೊಳ್ಳುತ್ತೇವೆ. ಅದನ್ನು ಮುಂದೆ
      ಹಂಚುವುದಿಲ್ಲ; ಬೇರೆ ಉದ್ದೇಶಕ್ಕೆ ತಿರುಗಿಸಿಕೊಳ್ಳುವ ಯಾವುದೇ ಸೇವೆಗೆ
      ಕೊಡುವುದೂ ಇಲ್ಲ.
    </p>

    <h2>ತಾಣ ಎಲ್ಲಿ ಚಾಲನೆಯಲ್ಲಿದೆ</h2>
    <p>
      ಕದಳಿ Cloudflare ಜಾಲಬಂಧದ ಮೂಲಕ ವಿತರಣೆಯಾಗುತ್ತದೆ. Cloudflare ಇರುವ ಯಾವುದೇ
      ತಾಣದಂತೆ, ಭದ್ರತೆ ಮತ್ತು ದುರುಪಯೋಗ ತಡೆಗಾಗಿ ಅಂಚಿನಲ್ಲಿ ವಿನಂತಿಗಳ
      ದಾಖಲೆ ಆಗುತ್ತದೆ — ಐಪಿ ವಿಳಾಸ, ಸಮಯ, ಕೇಳಿದ ಕೊಂಡಿ, ವೀಕ್ಷಕದ ವಿವರ.
      ಆ ದಾಖಲೆಗಳ ಮೇಲೆ ವಿಶ್ಲೇಷಣೆಯೋ ಜಾಹೀರಾತೋ ನಡೆಸುವುದಿಲ್ಲ; ಇಲ್ಲಿನ
      ವೀಕ್ಷಣೆಯನ್ನು ನಿಮ್ಮ ವ್ಯಕ್ತಿತ್ವಕ್ಕೆ ನಾವು ಕಟ್ಟಲಾರೆವು.
    </p>

    <h2>ಕುಕೀಗಳು</h2>
    <p>
      ಸಾರ್ವಜನಿಕ ತಾಣ ಯಾವುದೇ ಕುಕೀ ಇಡುವುದಿಲ್ಲ, ಓದುವುದೂ ಇಲ್ಲ. ತಾಣಕ್ಕೆ
      ವಿಷಯ ಪ್ರಕಟಿಸುವ ಸದಸ್ಸೆಯರು ಪ್ರತ್ಯೇಕ, ಪ್ರವೇಶಪದ ರಕ್ಷಿತ ಆಡಳಿತ
      ಕ್ಷೇತ್ರವನ್ನು ಬಳಸುತ್ತಾರೆ; ಅದರ ದೃಢೀಕರಣ ಆ ಸೇವೆಯದೇ ಆಗಿದ್ದು,
      ಸಾರ್ವಜನಿಕ ತಾಣದ ಭಾಗವಲ್ಲ.
    </p>

    <h2>ಈ ತಾಣದಿಂದ ಹೊರಗೆ ಕರೆದೊಯ್ಯುವ ಕೊಂಡಿಗಳು</h2>
    <p>
      ನಮ್ಮ ವಾಟ್ಸ್‌ಆಪ್, ಇಮೇಲ್ ಮತ್ತು ನಕ್ಷೆ ಕೊಂಡಿಗಳು ಬೇಕೆಂದೇ ಬೇರೆ
      ಸೇವೆಗಳಿಗೆ ಕರೆದೊಯ್ಯುತ್ತವೆ; ಅವುಗಳಿಗೆ ತಮ್ಮದೇ ಗೋಪ್ಯತಾ ನೀತಿ ಇದೆ.
      ಅವುಗಳ ಸಂಕೇತ ನಮ್ಮ ಪುಟಗಳಲ್ಲಿ ಚಾಲನೆಗೊಳ್ಳದಂತೆ, ಒಳಗೊಂಡ
      ವಿಜೆಟ್‌ಗಳ ಬದಲು ಕೊಂಡಿಗಳನ್ನೇ ಆಯ್ದುಕೊಂಡಿದ್ದೇವೆ.
    </p>

    <h2>ಛಾಯಾಚಿತ್ರಗಳು ಮತ್ತು ವಿಷಯ</h2>
    <p>
      ಸದಸ್ಸೆಯರ ಮತ್ತು ಕಾರ್ಯಕ್ರಮಗಳ ಛಾಯಾಚಿತ್ರಗಳು ಒಪ್ಪಿಗೆಯಿಂದ ಮಾತ್ರ
      ಪ್ರಕಟ; ಕೇಳಿದ ಕೂಡಲೇ ಯಾವುದೇ ಚಿತ್ರ ತೆಗೆಯುತ್ತೇವೆ —
      <a href="mailto:contact@kadali.org">contact@kadali.org</a> ಗೆ ಬರೆಯಿರಿ.
      ಗಮನಿಸದಿದ್ದರೆ ಈ ತಾಣದ ಬರಹ ಮತ್ತು ಛಾಯಾಚಿತ್ರಗಳ ಹಕ್ಕು ಕದಳಿಯದು;
      ಮರುಪ್ರಕಟಣೆಗೂ ಮೊದಲು ಕೇಳಿ. ವಚನ ಮತ್ತು ಇತರ ಜನಪದ ಸಾಮಗ್ರಿ
      ಎಲ್ಲರಿಗೂ ಸೇರಿದುದು; ನಾವು ಬರೆಯುವ ಪರಂಪರೆಯ ಮೇಲೆ ಯಾವುದೇ
      ಒಡೆತನ ಸಾಧಿಸುವುದಿಲ್ಲ.
    </p>

    <h2>ಈ ನೀತಿಯಲ್ಲಿ ಬದಲಾವಣೆ</h2>
    <p>
      ನಾವು ನಡೆಸುವ ರೀತಿ ಬದಲಾದಾಗ ಮಾತ್ರ ಈ ಪುಟ ಪರಿಷ್ಕರಿಸುತ್ತೇವೆ; ಆಗ
      ಮೇಲಿನ ದಿನಾಂಕವೂ ಬದಲಾಗುತ್ತದೆ. ಇಲ್ಲಿ ಏನಾದರೂ ಸಂಘದ ನಡತೆಗೆ
      ಹೊಂದದೆ ಕಾಣಿಸಿದರೆ, ತಿಳಿಸಿ.
    </p>

    <h2>ಪ್ರಶ್ನೆಗಳು</h2>
    <p>
      ನೇರವಾಗಿ ಕೇಳಿ — <a href="mailto:contact@kadali.org">contact@kadali.org</a>
      ಇಮೇಲ್ ಮೂಲಕ ಅಥವಾ
      <a href="/contact">ಸಂಪರ್ಕ ಪುಟ</a>ದ ಮೂಲಕ. ಬರುವ ಸಂದೇಶವನ್ನು ಓದುವವರು
      ನಮ್ಮವರೇ.
    </p>
  </article>
</BaseLayout>
