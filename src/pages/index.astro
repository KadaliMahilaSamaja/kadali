---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import Arch from '../components/motifs/Arch.astro';
import Beads from '../components/motifs/Beads.astro';

// Placeholder homepage — proves the content wiring. Page/hero agents build on this.
const settingsEntry = (await getCollection('site-settings')).at(0);
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
)
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);

const heroHeading =
  settingsEntry?.data.heroHeading ?? 'ಕದಲಿ · A circle of women, a circle of stories';
const heroDescription =
  settingsEntry?.data.heroDescription ??
  "Kadali is a women's cultural collective in Karnataka.";

const dateFormatter = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title="ಕದಲಿ · Kadali — A Women's Cultural Collective in Karnataka"
  description={heroDescription}
>
  <section class="bg-cream">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center px-4 py-16 text-center sm:px-6 md:py-24"
    >
      <Arch width={120} class="text-rani" />
      <h1
        class="mt-8 max-w-2xl font-display text-4xl font-semibold text-ink sm:text-5xl"
      >
        {heroHeading}
      </h1>
      <p class="mt-5 max-w-xl font-body text-lg text-stone">
        {heroDescription}
      </p>
      <Beads class="mt-10 w-44 text-turmeric" />
    </div>
  </section>

  <section class="bg-jasmine">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-3xl font-semibold text-ink">
        Latest articles
      </h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((article) => (
            <li class="border border-ink/10 bg-cream p-6">
              <p class="font-ui text-xs font-semibold tracking-wider uppercase text-rani">
                {article.data.category}
              </p>
              <h3 class="mt-2 font-display text-2xl leading-snug">
                <a
                  href={`/articles/${article.id}`}
                  class="text-ink underline-offset-4 hover:text-rani hover:underline"
                >
                  {article.data.title}
                </a>
              </h3>
              <p class="mt-3 font-body text-base text-stone">
                {article.data.description}
              </p>
              <p class="mt-4 font-ui text-sm text-stone">
                {article.data.author} · {dateFormatter.format(
                  article.data.pubDate,
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
