---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Aim from '../components/home/Aim.astro';
import EventCard from '../components/home/EventCard.astro';
import RecentArticles from '../components/home/RecentArticles.astro';
import CommitteePreview from '../components/home/CommitteePreview.astro';
import JoinBand from '../components/home/JoinBand.astro';
import { deriveStatus, sortEvents } from '../lib/events';

const now = new Date();

// --- Site settings (single file() entry, id 'site') -------------------------
const settings = (await getCollection('site-settings')).at(0);

// --- Recent articles (newest first, max 4 — the rail scrolls) ---------------
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Settings' featured pick floats to the front if it is published.
const featuredArticleRef = settings?.data.featuredArticle;
if (featuredArticleRef) {
  const entry = await getEntry(featuredArticleRef).catch(() => undefined);
  if (entry && !entry.data.draft) articles.unshift(entry);
}
const recentArticles = [...new Map(articles.map((a) => [a.id, a])).values()]
  .slice(0, 4);

// --- Upcoming events (derived status, soonest first, max 4 — the rail scrolls)
const events = await getCollection('events');
const upcomingEvents = sortEvents(
  events.filter((event) => deriveStatus(event, now) === 'upcoming'),
  'asc',
).slice(0, 4);

// --- Active announcements (current date between pubDate and optional expiryDate)
const announcements = await getCollection('announcements', ({ data }) => {
  const pub = data.pubDate ? new Date(data.pubDate) : null;
  const exp = data.expiryDate ? new Date(data.expiryDate) : null;
  const isPublished = !pub || pub <= now;
  const notExpired = !exp || exp >= now;
  return isPublished && notExpired;
});
const activeAnnouncement = announcements.at(0);

// --- Featured gallery preview (from settings or first available)
const featuredGalleryRef = settings?.data.featuredGallery;
const galleryEntry = featuredGalleryRef
  ? await getEntry('galleries', featuredGalleryRef).catch(() => undefined)
  : (await getCollection('galleries')).at(0);
const galleryPhotos = galleryEntry?.data.photos.slice(0, 3) ?? [];

const heroHeading =
  settings?.data.heroHeading ?? 'ಭಕ್ತಿ ಬೇರು. ಸಂಸ್ಕೃತಿ ಉಸಿರು. ಮಹಿಳೆಯರ ಒಗ್ಗಟ್ಟು.';
const heroDescription =
  settings?.data.heroDescription ??
  'ಅಕ್ಕ ಮಹಾದೇವಿಯ ಆತ್ಮಸಾಕ್ಷಿ ಮತ್ತು ವಚನಗಳ ಬೆಳಕಿನಲ್ಲಿ — ಭಕ್ತಿ, ಕಲೆ, ಸೇವೆ ಹಾಗೂ ಸಾಹಿತ್ಯವನ್ನು ಬೆಸೆಯುವ ನಮ್ಮ ಸಮುದಾಯ.';
---

<BaseLayout
  title="ಕದಳಿ ವನಿತಾ ಸಮಾಜ, ಶಿವಮೊಗ್ಗ"
  description={heroDescription}
>
  {
    activeAnnouncement && (
      <aside
        class="border-b border-ink/10 bg-jasmine/60 py-3 text-ink"
        aria-label="ಪ್ರಮುಖ ಸೂಚನೆ"
      >
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="inline-flex size-2 shrink-0 rounded-full bg-turmeric animate-pulse" aria-hidden="true"></span>
            <span class="shrink-0 font-ui text-xs font-bold uppercase tracking-wider text-sindoor">ಸೂಚನೆ:</span>
            <p class="truncate font-ui text-sm font-medium">
              <span lang="kn">{activeAnnouncement.data.title}</span>
            </p>
          </div>
          <a
            href="/events"
            class="shrink-0 font-ui text-xs font-semibold text-leaf hover:text-sindoor hover:underline"
          >
            <span>ವಿವರಗಳು</span>
            <span aria-hidden="true"> →</span>
          </a>
        </div>
      </aside>
    )
  }

  <Hero
    heading={heroHeading}
    description={heroDescription}
    withNotice={!!activeAnnouncement}
  />

  <Aim />

  {
    upcomingEvents.length > 0 && (
      <section class="border-t border-ink/10 bg-jasmine" aria-labelledby="upcoming-events-heading">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
          <div class="reveal flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="eyebrow-kn">ಒಟ್ಟಾಗಿ ಆಚರಿಸೋಣ</p>
              <h2 id="upcoming-events-heading" class="text-section font-bold">
                ಮುಂಬರುವ ಕಾರ್ಯಕ್ರಮಗಳು
              </h2>
            </div>
            <div class="md:pb-2 md:text-right">
              <p class="max-w-sm font-body text-lg leading-relaxed text-stone">
                ಒಟ್ಟಾಗಿ ಸೇರುವ ಕ್ಷಣಗಳೇ ಸಮುದಾಯವನ್ನು ಕಟ್ಟುತ್ತವೆ. ಮುಂದಿನ
                ಕಾರ್ಯಕ್ರಮದಲ್ಲಿ ನಮ್ಮೊಂದಿಗೆ ಸೇರಿ.
              </p>
              <a
                href="/events"
                class="underline-reveal mt-3 inline-flex items-center gap-1.5 font-ui text-base font-semibold text-leaf active:text-sindoor"
              >
                <span>ಎಲ್ಲಾ ಕಾರ್ಯಕ್ರಮಗಳು</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          {
            upcomingEvents.length === 1 ? (
              <div class="reveal mt-10">
                <EventCard event={upcomingEvents[0]} wide={true} />
              </div>
            ) : (
              <>
                <div class="rail-x mt-10 pb-2">
                  {upcomingEvents.map((event, i) => (
                    <div
                      class="reveal min-w-[86%] snap-center sm:min-w-[58%] lg:min-w-[30rem]"
                      style={`--reveal-delay: ${i * 90}ms`}
                    >
                      <EventCard event={event} />
                    </div>
                  ))}
                </div>
                <p class="swipe-hint md:hidden" aria-hidden="true">
                  ಸರಿಸಿ ನೋಡಿ
                </p>
              </>
            )
          }
        </div>
      </section>
    )
  }

  <RecentArticles articles={recentArticles} />

  {
    galleryPhotos.length > 0 && (
      <section class="bg-jasmine border-t border-ink/10" aria-labelledby="gallery-preview-heading">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
          <div class="reveal flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="eyebrow-kn">ನಮ್ಮ ಸಂಭ್ರಮ</p>
              <h2 id="gallery-preview-heading" class="text-section font-bold">
                ಚಿತ್ರಶಾಲೆಯ ಆಯ್ದ ಕ್ಷಣಗಳು
              </h2>
            </div>
            <div class="md:pb-2 md:text-right">
              <p class="max-w-sm font-body text-lg leading-relaxed text-stone">
                ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಹಬ್ಬಗಳು, ಕಸುತಿ ಹೆಣಿಗೆ, ಸಾಮೂಹಿಕ ಆಚರಣೆಗಳ ಛಾಯಾಚಿತ್ರಗಳು.
              </p>
              <a
                href="/gallery"
                class="underline-reveal mt-3 inline-flex items-center gap-1.5 font-ui text-base font-semibold text-leaf active:text-sindoor"
              >
                <span>ಸಂಪೂರ್ಣ ಚಿತ್ರಶಾಲೆ</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
            {galleryPhotos.map((photo, i) => (
              <a
                href="/gallery"
                class="reveal group relative overflow-hidden rounded-t-[3rem] border border-ink/10 bg-milk shadow-sm transition-transform duration-300 hover:-translate-y-1"
                style={`--reveal-delay: ${i * 90}ms`}
              >
                <div class="aspect-[4/3] overflow-hidden bg-jasmine/30">
                  <img
                    src={photo.image}
                    alt={photo.caption}
                    width="600"
                    height="450"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                </div>
                <div class="p-4 text-center">
                  <p class="font-body text-sm text-stone group-hover:text-ink">
                    <span lang="kn">{photo.caption}</span>
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CommitteePreview />

  <JoinBand />
</BaseLayout>

<script is:inline>
  // Mark the document before paint so reveal styles apply only when the
  // observer below can un-hide them; without scripting the page stays visible.
  document.documentElement.classList.add('js');
</script>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.05, rootMargin: '0px 0px -4% 0px' },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-in'));
  }

  // Scroll-driven word light-up (the mockup's word-reveal): the intro
  // paragraph's words brighten left-to-right as it crosses the viewport.
  // The spans are rendered server-side; no scripting leaves them visible.
  const para = document.querySelector('.word-reveal');
  if (para && !reduced) {
    const words = para.querySelectorAll('.w');
    const update = () => {
      const r = para.getBoundingClientRect();
      const progress = Math.max(
        0,
        Math.min(1, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.3)),
      );
      words.forEach((word, i) => {
        word.classList.toggle('lit', i / Math.max(1, words.length) < progress);
      });
    };
    addEventListener('scroll', () => requestAnimationFrame(update), {
      passive: true,
    });
    update();
  }

  // Subtle hero parallax, as in the mockup — the halo keeps turning
  // independently of scroll.
  const hero = document.querySelector('.hero');
  const art = document.querySelector('.hero-art');
  if (hero && art && !reduced && matchMedia('(min-width: 48rem)').matches) {
    let busy = false;
    addEventListener(
      'scroll',
      () => {
        if (busy) return;
        busy = true;
        requestAnimationFrame(() => {
          const r = hero.getBoundingClientRect();
          const p = Math.max(0, Math.min(1, -r.top / r.height));
          art.style.transform = `translateY(${p * 22}px)`;
          busy = false;
        });
      },
      { passive: true },
    );
  }
</script>
