---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Aim from '../components/home/Aim.astro';
import EventCard from '../components/home/EventCard.astro';
import RecentArticles from '../components/home/RecentArticles.astro';
import CommitteePreview from '../components/home/CommitteePreview.astro';
import JoinBand from '../components/home/JoinBand.astro';
import { deriveStatus, sortEvents } from '../lib/events';

const now = new Date();

// --- Site settings (single file() entry, id 'site') -------------------------
const settings = (await getCollection('site-settings')).at(0);

// --- Recent articles (newest first, max 2) ----------------------------------
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Settings' featured pick floats to the front if it is published.
const featuredArticleRef = settings?.data.featuredArticle;
if (featuredArticleRef) {
  const entry = await getEntry(featuredArticleRef).catch(() => undefined);
  if (entry && !entry.data.draft) articles.unshift(entry);
}
const recentArticles = [...new Map(articles.map((a) => [a.id, a])).values()]
  .slice(0, 2);

// --- Upcoming events (derived status, soonest first, max 3) ------------------
const events = await getCollection('events');
const upcomingEvents = sortEvents(
  events.filter((event) => deriveStatus(event, now) === 'upcoming'),
  'asc',
).slice(0, 3);

const heroHeading =
  settings?.data.heroHeading ?? 'ವಚನ, ಕಸುತಿ, ಸೇವೆ ಒಂದೇ ವೃತ್ತದಲ್ಲಿ';
const heroDescription =
  settings?.data.heroDescription ??
  'ಉಡುಪಿಯ ಕದಲಿ ಮಹಿಳಾ ಸಂಘ, ಅಕ್ಕಮಹಾದೇವಿಯ ವಚನಗಳ ನೆನಪಲ್ಲಿ ಬೆಳೆಯುವ ಒಡನಾಡು.';
---

<BaseLayout
  title="ಕದಲಿ ಮಹಿಳಾ ಸಂಘ, ಉಡುಪಿಯ ಮಹಿಳೆಯರ ಒಡನಾಡು"
  description={heroDescription}
>
  <Hero heading={heroHeading} description={heroDescription} />

  <Aim />

  {
    upcomingEvents.length > 0 && (
      <section class="bg-cream" aria-labelledby="upcoming-events-heading">
        <div class="mx-auto max-w-6xl px-0 py-16 sm:px-6 md:py-20">
          <div class="flex flex-wrap items-end justify-between gap-4 px-4 md:px-0">
            <h2
              id="upcoming-events-heading"
              class="reveal text-section font-bold"
            >
              ಮುಂಬರುವ ಕಾರ್ಯಕ್ರಮಗಳು
            </h2>
            <a
              href="/events"
              class="underline-reveal font-ui text-base font-semibold text-leaf active:text-sindoor"
            >
              ಎಲ್ಲಾ ಕಾರ್ಯಕ್ರಮಗಳು
            </a>
          </div>
          {/* Mobile-first: a swipeable snap rail with the next poster peeking;
              the page grid returns from md up. */}
          <div
            class:list={[
              'rail mt-10 px-4 pb-2 sm:px-6 md:px-0 md:pb-0',
              upcomingEvents.length === 1
                ? 'sm:max-w-3xl'
                : 'md:grid-cols-2 lg:grid-cols-3',
            ]}
          >
            {upcomingEvents.map((event, i) => (
              <div
                class="reveal min-w-[86%] snap-center sm:min-w-[55%] md:min-w-0"
                style={`--reveal-delay: ${i * 90}ms`}
              >
                <EventCard event={event} wide={upcomingEvents.length === 1} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <RecentArticles articles={recentArticles} />

  <CommitteePreview />

  <JoinBand />
</BaseLayout>

<script is:inline>
  // Mark the document before paint so reveal styles apply only when the
  // observer below can un-hide them; without scripting the page stays visible.
  document.documentElement.classList.add('js');
</script>

<script>
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-in'));
  }
</script>
