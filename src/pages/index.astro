---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Aim from '../components/home/Aim.astro';
import EventCard from '../components/home/EventCard.astro';
import RecentArticles from '../components/home/RecentArticles.astro';
import CommitteePreview from '../components/home/CommitteePreview.astro';
import JoinBand from '../components/home/JoinBand.astro';
import { deriveStatus, sortEvents } from '../lib/events';

const now = new Date();

// --- Site settings (single file() entry, id 'site') -------------------------
const settings = (await getCollection('site-settings')).at(0);

// --- Recent articles (newest first, max 4 — the rail scrolls) ---------------
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Settings' featured pick floats to the front if it is published.
const featuredArticleRef = settings?.data.featuredArticle;
if (featuredArticleRef) {
  const entry = await getEntry(featuredArticleRef).catch(() => undefined);
  if (entry && !entry.data.draft) articles.unshift(entry);
}
const recentArticles = [...new Map(articles.map((a) => [a.id, a])).values()]
  .slice(0, 4);

// --- Upcoming events (derived status, soonest first, max 4 — the rail scrolls)
const events = await getCollection('events');
const upcomingEvents = sortEvents(
  events.filter((event) => deriveStatus(event, now) === 'upcoming'),
  'asc',
).slice(0, 4);

const heroHeading =
  settings?.data.heroHeading ?? 'ಭಕ್ತಿ ಬೇರು. ಸಂಸ್ಕೃತಿ ಉಸಿರು. ಮಹಿಳೆಯರ ಒಗ್ಗಟ್ಟು.';
const heroDescription =
  settings?.data.heroDescription ??
  'ಅಕ್ಕ ಮಹಾದೇವಿಯ ಆತ್ಮಸಾಕ್ಷಿ ಮತ್ತು ವಚನಗಳ ಬೆಳಕಿನಲ್ಲಿ — ಭಕ್ತಿ, ಕಲೆ, ಸೇವೆ ಹಾಗೂ ಸಾಹಿತ್ಯವನ್ನು ಬೆಸೆಯುವ ನಮ್ಮ ಸಮುದಾಯ.';
---

<BaseLayout
  title="ಕದಳಿ ವನಿತಾ ಸಮಾಜ, ಶಿವಮೊಗ್ಗ"
  description={heroDescription}
>
  <Hero heading={heroHeading} description={heroDescription} />

  <Aim />

  {
    upcomingEvents.length > 0 && (
      <section class="bg-cream" aria-labelledby="upcoming-events-heading">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
          <div class="reveal flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="eyebrow-kn">ಒಟ್ಟಾಗಿ ಆಚರಿಸೋಣ</p>
              <h2 id="upcoming-events-heading" class="text-section font-bold">
                ಮುಂಬರುವ ಕಾರ್ಯಕ್ರಮಗಳು
              </h2>
            </div>
            <div class="md:pb-2 md:text-right">
              <p class="max-w-sm font-body text-lg leading-relaxed text-stone">
                ಒಟ್ಟಾಗಿ ಸೇರುವ ಕ್ಷಣಗಳೇ ಸಮುದಾಯವನ್ನು ಕಟ್ಟುತ್ತವೆ. ಮುಂದಿನ
                ಕಾರ್ಯಕ್ರಮದಲ್ಲಿ ನಮ್ಮೊಂದಿಗೆ ಸೇರಿ.
              </p>
              <a
                href="/events"
                class="underline-reveal mt-3 inline-flex items-center gap-1.5 font-ui text-base font-semibold text-leaf active:text-sindoor"
              >
                <span>ಎಲ್ಲಾ ಕಾರ್ಯಕ್ರಮಗಳು</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          {/* The mockup's swipe band: posters scroll sideways at every
              size, the next one peeking past the edge. */}
          <div class="rail-x mt-10 pb-2">
            {upcomingEvents.map((event, i) => (
              <div
                class="reveal min-w-[86%] snap-center sm:min-w-[58%] lg:min-w-[30rem]"
                style={`--reveal-delay: ${i * 90}ms`}
              >
                <EventCard event={event} wide={upcomingEvents.length === 1} />
              </div>
            ))}
          </div>
          <p class="swipe-hint" aria-hidden="true">
            ಸರಿಸಿ ನೋಡಿ
          </p>
        </div>
      </section>
    )
  }

  <RecentArticles articles={recentArticles} />

  <CommitteePreview />

  <JoinBand />
</BaseLayout>

<style>
  /* Section eyebrow — the mockup's rust kicker line, in Kannada */
  .eyebrow-kn {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-sindoor);
  }
</style>

<script is:inline>
  // Mark the document before paint so reveal styles apply only when the
  // observer below can un-hide them; without scripting the page stays visible.
  document.documentElement.classList.add('js');
</script>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-in'));
  }

  // Scroll-driven word light-up (the mockup's word-reveal): the intro
  // paragraph's words brighten left-to-right as it crosses the viewport.
  // The spans are rendered server-side; no scripting leaves them visible.
  const para = document.querySelector('.word-reveal');
  if (para && !reduced) {
    const words = para.querySelectorAll('.w');
    const update = () => {
      const r = para.getBoundingClientRect();
      const progress = Math.max(
        0,
        Math.min(1, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.3)),
      );
      words.forEach((word, i) => {
        word.classList.toggle('lit', i / Math.max(1, words.length) < progress);
      });
    };
    addEventListener('scroll', () => requestAnimationFrame(update), {
      passive: true,
    });
    update();
  }

  // Subtle hero parallax, as in the mockup — the halo keeps turning
  // independently of scroll.
  const hero = document.querySelector('.hero');
  const art = document.querySelector('.hero-art');
  if (hero && art && !reduced && matchMedia('(min-width: 48rem)').matches) {
    let busy = false;
    addEventListener(
      'scroll',
      () => {
        if (busy) return;
        busy = true;
        requestAnimationFrame(() => {
          const r = hero.getBoundingClientRect();
          const p = Math.max(0, Math.min(1, -r.top / r.height));
          art.style.transform = `translateY(${p * 22}px)`;
          busy = false;
        });
      },
      { passive: true },
    );
  }
</script>
