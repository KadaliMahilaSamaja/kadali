---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import GalleryGroup from '../components/gallery/GalleryGroup.astro';
import Lightbox from '../components/gallery/Lightbox.astro';

// Newest gallery first.
const galleries = (await getCollection('galleries')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// `event` is a free-text event title; link it to the event detail page when
// a title match exists, otherwise the header shows it as plain text.
const events = await getCollection('events');
const eventHrefByTitle = new Map(
  events.map((ev) => [ev.data.title, `/events/${ev.id}`]),
);
---

<BaseLayout
  title="ಚಿತ್ರಶಾಲೆ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ"
  description="ಕದಳಿಯ ಸಭೆಗಳ ಛಾಯಾಚಿತ್ರಗಳು — ಮೆಳಾ, ವಚನ ವೃತ್ತ ಮತ್ತು ಸಮುದಾಯದ ದಿನನಿತ್ಯದ ಕ್ಷಣಗಳು."
>
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
      <header class="max-w-2xl">
        <p class="font-ui text-sm font-semibold tracking-widest text-leaf uppercase">
          <span lang="kn">ಸಮುದಾಯದ ಕ್ಷಣಗಳು · ಛಾಯಾಚಿತ್ರ ಸಂಗ್ರಹ</span>
        </p>
        <h1 class="mt-3 font-display text-4xl font-semibold text-ink sm:text-5xl">
          ಚಿತ್ರಶಾಲೆ
        </h1>
        <p class="mt-4 font-body text-lg text-stone">
          ಸದಸ್ಸೆಯರು ಸೆರೆಹಿಡಿದ ಚೌಕಟ್ಟುಗಳು — ಅಂಗಡಿ ಮತ್ತು ಕಥೆಗಾರ್ತಿಯರು,
          ಬಾಳೆ ಎಲೆಯ ಉದ್ದನೆಯ ಊಟ, ನಡುವಣ ಶಾಂತ ಕ್ಷಣಗಳು. ದೊಡ್ಡದಾಗಿ ನೋಡಲು
          ಛಾಯಾಚಿತ್ರವೊಂದನ್ನು ಆಯ್ದುಕೊಳ್ಳಿ.
        </p>
      </header>

      <div class="mt-10 md:mt-14">
        {
          galleries.length === 0 ? (
            <p class="font-body text-lg text-stone">
              ಇನ್ನೂ ಛಾಯಾಚಿತ್ರಗಳಿಲ್ಲ — ಮುಂದಿನ ಸಭೆಯ ಬಳಿಕ ಇನ್ನೊಮ್ಮೆ ನೋಡಿ.
            </p>
          ) : (
            galleries.map((gallery) => (
              <GalleryGroup
                gallery={gallery}
                eventHref={
                  gallery.data.event
                    ? eventHrefByTitle.get(gallery.data.event)
                    : undefined
                }
              />
            ))
          )
        }
      </div>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
