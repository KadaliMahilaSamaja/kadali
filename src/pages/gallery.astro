---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import GalleryGroup from '../components/gallery/GalleryGroup.astro';
import Lightbox from '../components/gallery/Lightbox.astro';
import { ui } from '../i18n/ui';

const { gallery } = ui;

// Newest gallery first.
const galleries = (await getCollection('galleries')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// `event` is a free-text event title; link it to the event detail page when
// a title match exists, otherwise the header shows it as plain text.
const events = await getCollection('events');
const eventHrefByTitle = new Map(
  events.map((ev) => [ev.data.title, `/events/${ev.id}`]),
);
---

<BaseLayout
  title="ಚಿತ್ರಶಾಲೆ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ"
  titleEn="Gallery · Kadali Vanita Samaja"
  description="ಕದಳಿಯ ಸಭೆಗಳ ಛಾಯಾಚಿತ್ರಗಳು — ಮೆಳಾ, ವಚನ ವೃತ್ತ ಮತ್ತು ಸಮುದಾಯದ ದಿನನಿತ್ಯದ ಕ್ಷಣಗಳು."
  descriptionEn="Photographs of Kadali's gatherings — the mela, the vachana circle and everyday community moments."
>
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
      <header class="max-w-2xl">
        <p class="font-ui text-sm font-semibold tracking-widest text-leaf uppercase">
          <span data-kn lang="kn" class="tracking-normal normal-case">{gallery.eyebrow.kn}</span>
          <span data-en class="tracking-normal normal-case">{gallery.eyebrow.en}</span>
        </p>
        <h1 class="mt-3 font-display text-4xl font-semibold text-ink sm:text-5xl">
          <span data-kn lang="kn">{gallery.pageHeading.kn}</span>
          <span data-en>{gallery.pageHeading.en}</span>
        </h1>
        <p class="mt-4 font-body text-lg text-stone">
          <span data-kn lang="kn">{gallery.pageLede.kn}</span>
          <span data-en class="font-serif">{gallery.pageLede.en}</span>
        </p>
      </header>

      <div class="mt-10 md:mt-14">
        {
          galleries.length === 0 ? (
            <p class="font-body text-lg text-stone">
              <span data-kn lang="kn">{gallery.empty.kn}</span>
              <span data-en class="font-serif">{gallery.empty.en}</span>
            </p>
          ) : (
            galleries.map((gallery) => (
              <GalleryGroup
                gallery={gallery}
                eventHref={
                  gallery.data.event
                    ? eventHrefByTitle.get(gallery.data.event)
                    : undefined
                }
              />
            ))
          )
        }
      </div>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
