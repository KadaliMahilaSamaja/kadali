---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Beads from '../../components/motifs/Beads.astro';
import ArticleCard from '../../components/articles/ArticleCard.astro';
import ArticleDate from '../../components/articles/ArticleDate.astro';
import {
  CATEGORY_LABELS,
  CATEGORY_ORDER,
} from '../../components/articles/categories';

// All non-draft articles, newest first. The featured one leads as a hero
// split and is excluded from the grid below to avoid duplication.
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => +b.data.pubDate - +a.data.pubDate);

const featured = articles.find((article) => article.data.featured) ?? articles[0];
const rest = articles.filter((article) => article.id !== featured?.id);

// Distinct tags in use, alphabetically, for the filter chips below.
const allTags = [...new Set(articles.flatMap((article) => article.data.tags))].sort();

const filterChipBase =
  'border border-ink/15 bg-cream px-3 py-1.5 font-ui text-sm font-medium text-ink transition-colors duration-200 aria-[current=true]:border-rani aria-[current=true]:bg-rani aria-[current=true]:text-cream';
---

<BaseLayout
  title="Articles · Kadali"
  description="Essays and stories from the Kadali circle — vachana readings, kasuti nights, seva notes and more, by women of coastal Karnataka."
>
  <!-- Page header -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 pt-12 pb-10 sm:px-6">
      <h1 class="font-display text-4xl font-semibold text-ink">
        Articles
        <span class="text-stone" aria-hidden="true">·</span>
        <span lang="kn" class="text-rani">ಲೇಖನಗಳು</span>
      </h1>
      <p class="mt-3 max-w-xl font-body text-lg text-stone">
        Writing from the circle — essays, notes and stories by Kadali members.
      </p>
      <Beads class="mt-6 w-40 text-turmeric" />
    </div>
  </section>

  <!-- Featured article: hero split on a jasmine band -->
  {
    featured && (
      <section class="bg-jasmine">
        <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center md:py-20">
          <div>
            <p class="font-ui text-xs font-semibold tracking-wider uppercase text-rani">
              Featured
              <span aria-hidden="true"> · </span>
              <span lang="kn" class="tracking-normal normal-case">ವಿಶೇಷ ಲೇಖನ</span>
            </p>
            <h2 class="mt-4 font-display text-3xl leading-tight font-semibold text-ink sm:text-4xl">
              <a
                href={`/articles/${featured.id}`}
                class="underline-offset-4 hover:text-rani hover:underline"
              >
                {featured.data.title}
              </a>
            </h2>
            <p class="mt-4 max-w-xl font-body text-lg text-stone">
              {featured.data.description}
            </p>
            <p class="mt-5 font-ui text-sm text-stone">
              {featured.data.author} · <ArticleDate date={featured.data.pubDate} />
            </p>
            <a
              href={`/articles/${featured.id}`}
              class="mt-6 inline-block font-ui text-sm font-semibold text-rani underline-offset-4 hover:underline"
            >
              Read the article <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="overflow-hidden rounded-t-[999px] border border-ink/10">
            <img
              src={featured.data.cover}
              alt={featured.data.coverAlt}
              width={1200}
              height={675}
              decoding="async"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
        </div>
      </section>
    )
  }

  <!-- Toolbar: search + category filters -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <label for="article-search" class="sr-only">Search articles</label>
          <input
            id="article-search"
            type="search"
            placeholder="Search articles…"
            data-article-search
            hidden
            class="w-full border border-ink/20 bg-cream px-3 py-2 font-ui text-sm text-ink placeholder:text-stone/70 focus:border-rani md:w-72"
          />
        </div>
        <nav aria-label="Filter articles by category" class="flex flex-wrap gap-2">
          <a href="/articles/" data-category-link data-category="" aria-current="false" class={filterChipBase}>
            All <span lang="kn">ಎಲ್ಲಾ</span>
          </a>
          {
            CATEGORY_ORDER.map((category) => (
              <a
                href={`/articles/?category=${category}`}
                data-category-link
                data-category={category}
                aria-current="false"
                class={filterChipBase}
              >
                <span lang="kn">{CATEGORY_LABELS[category].kn}</span>
                <span aria-hidden="true"> · </span>
                <span>{CATEGORY_LABELS[category].en}</span>
              </a>
            ))
          }
        </nav>
      </div>

      {
        allTags.length > 0 && (
          <nav aria-label="Filter articles by tag" class="mt-4 flex flex-wrap gap-2">
            {allTags.map((tag) => (
              <a
                href={`/articles/?tag=${encodeURIComponent(tag)}`}
                data-tag-link
                data-tag={tag}
                aria-current="false"
                class={filterChipBase}
              >
                <span aria-hidden="true">#</span>
                {tag}
              </a>
            ))}
          </nav>
        )
      }

      <!-- Article grid: first card gets the temple-arch top -->
      <div data-article-grid class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((post, index) => <ArticleCard post={post} arch={index === 0} />)}
      </div>

      <p
        data-article-empty
        role="status"
        hidden
        class="mt-10 border border-ink/10 bg-jasmine px-4 py-6 font-ui text-base text-stone"
      >
        No articles match. Try a different word, or pick another category.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: category filter links + search input.
  // Without JS the links simply reload the page with the full list.
  const searchInput =
    document.querySelector<HTMLInputElement>('[data-article-search]');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-article-card]'),
  );
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-category-link]'),
  );
  const tagLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-tag-link]'),
  );
  const emptyMessage = document.querySelector<HTMLElement>('[data-article-empty]');

  // Reveal the search control now that script support is confirmed.
  if (searchInput) searchInput.hidden = false;

  let activeCategory = '';
  let activeTag = '';

  function applyFilters() {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const matchesCategory =
        !activeCategory || card.dataset.category === activeCategory;
      const matchesTag =
        !activeTag ||
        (card.dataset.tags ?? '')
          .toLowerCase()
          .split(/\s+/)
          .includes(activeTag.toLowerCase());
      const haystack = `${card.dataset.title ?? ''} ${card.dataset.description ?? ''} ${card.dataset.tags ?? ''}`.toLowerCase();
      const matchesQuery = !query || haystack.includes(query);
      const show = matchesCategory && matchesTag && matchesQuery;
      card.classList.toggle('hidden', !show);
      if (show) visible += 1;
    }

    if (emptyMessage) emptyMessage.hidden = visible === 0;

    for (const link of links) {
      const isActive = (link.dataset.category ?? '') === activeCategory;
      link.setAttribute('aria-current', String(isActive));
    }

    for (const link of tagLinks) {
      const isActive =
        (link.dataset.tag ?? '').toLowerCase() === activeTag.toLowerCase();
      link.setAttribute('aria-current', String(isActive));
    }
  }

  function syncUrl() {
    const url = new URL(window.location.href);
    if (activeCategory) url.searchParams.set('category', activeCategory);
    else url.searchParams.delete('category');
    if (activeTag) url.searchParams.set('tag', activeTag);
    else url.searchParams.delete('tag');
    window.history.replaceState(null, '', url);
  }

  for (const link of links) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const next = link.dataset.category ?? '';
      activeCategory = activeCategory === next ? '' : next;
      syncUrl();
      applyFilters();
    });
  }

  searchInput?.addEventListener('input', applyFilters);

  for (const link of tagLinks) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const next = link.dataset.tag ?? '';
      activeTag = activeTag.toLowerCase() === next.toLowerCase() ? '' : next;
      syncUrl();
      applyFilters();
    });
  }

  // Restore a shared/bookmarked ?category= / ?tag= filter on load.
  const params = new URLSearchParams(window.location.search);
  const initial = params.get('category');
  if (initial && links.some((link) => link.dataset.category === initial)) {
    activeCategory = initial;
    applyFilters();
  }
  const initialTag = params.get('tag');
  if (
    initialTag &&
    tagLinks.some(
      (link) => (link.dataset.tag ?? '').toLowerCase() === initialTag.toLowerCase(),
    )
  ) {
    activeTag = initialTag;
    applyFilters();
  }
</script>
