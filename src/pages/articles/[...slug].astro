---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Beads from '../../components/motifs/Beads.astro';
import CategoryChip from '../../components/articles/CategoryChip.astro';
import TagChip from '../../components/articles/TagChip.astro';
import ArticleDate from '../../components/articles/ArticleDate.astro';
import ArticleCard from '../../components/articles/ArticleCard.astro';
import ShareLinks from '../../components/articles/ShareLinks.astro';
import AuthorBio from '../../components/articles/AuthorBio.astro';
import ArticleLightbox from '../../components/articles/ArticleLightbox.astro';
import { getAuthorProfile } from '../../lib/authors';
import { ui } from '../../i18n/ui';

const { articles: t, home } = ui;

export async function getStaticPaths() {
  // Drafts excluded; newest first so related picks the freshest matches.
  const articles = (
    await getCollection('articles', ({ data }) => !data.draft)
  ).sort((a, b) => +b.data.pubDate - +a.data.pubDate);

  return Promise.all(
    articles.map(async (post) => {
      // Related = same category, exclude self, newest first, max 3.
      const related = articles
        .filter(
          (other) =>
            other.id !== post.id && other.data.category === post.data.category,
        )
        .slice(0, 3);

      // Resolved here so the page can chip-link straight to the event.
      const event = post.data.event
        ? await getEntry(post.data.event)
        : undefined;

      return { params: { slug: post.id }, props: { post, related, event } };
    }),
  );
}

interface Props {
  post: CollectionEntry<'articles'>;
  related: CollectionEntry<'articles'>[];
  event?: CollectionEntry<'events'>;
}

const { post, related, event } = Astro.props;
const { title, description, cover, coverAlt, author, pubDate } = post.data;
const { Content } = await render(post);

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const authorProfile = await getAuthorProfile(author, {
  photo: post.data.authorPhoto,
  role: post.data.authorRole,
  bio: post.data.authorBio,
});
const authorArticlesCount = allArticles.filter((a) => a.data.author === author).length;

const shareUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://kadali.org',
).href;
---

<BaseLayout
  title={`${title} · ಕದಳಿ ವನಿತಾ ಸಮಾಜ`}
  titleEn={`${title} · Kadali Vanita Samaja`}
  description={description}
  image={cover}
  type="article"
>
  <article class="bg-cream">
    <!-- Breadcrumb + article header -->
    <div class="mx-auto max-w-3xl px-4 pt-10 sm:px-6">
      <nav aria-label="ಸ್ಥಳ ಸೂಚಿ" class="font-ui text-sm text-stone">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/" class="underline-offset-4 hover:text-leaf hover:underline">
              <span data-kn lang="kn">{t.breadcrumbHome.kn}</span>
              <span data-en>{t.breadcrumbHome.en}</span>
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/articles" class="underline-offset-4 hover:text-leaf hover:underline">
              <span data-kn lang="kn">{t.breadcrumbArticles.kn}</span>
              <span data-en>{t.breadcrumbArticles.en}</span>
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink"><span lang="kn">{title}</span></li>
        </ol>
      </nav>

      <header class="mt-10">
        <div class="flex flex-wrap items-center gap-2">
          <CategoryChip category={post.data.category} />
          {
            event && (
              <a
                href={`/events/${event.id}`}
                class="inline-flex items-center gap-1.5 self-start border border-leaf/30 bg-cream px-2.5 py-1 font-ui text-xs font-semibold tracking-wider uppercase text-leaf transition-colors duration-200 hover:border-leaf hover:bg-leaf hover:text-cream"
              >
                <span data-kn lang="kn" class="tracking-normal normal-case">{t.eventChip.kn}</span>
                <span data-en class="tracking-normal normal-case">{t.eventChip.en}</span>
                <span aria-hidden="true">·</span>
                <span class="normal-case"><span lang="kn">{event.data.title}</span></span>
              </a>
            )
          }
          {post.data.tags.map((tag) => <TagChip tag={tag} />)}
        </div>
        <h1 class="mt-5 font-display text-4xl leading-tight font-semibold text-ink md:text-5xl">
          <span lang="kn">{title}</span>
        </h1>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={`/articles?author=${encodeURIComponent(author)}`}
            class="group inline-flex items-center gap-2.5 rounded-full border border-ink/15 bg-milk py-1 pl-1.5 pr-3.5 transition-colors duration-200 hover:border-leaf hover:bg-jasmine"
            title={`${author} ${t.allByAuthorSuffix.kn}`}
          >
            {authorProfile.photo ? (
              <img
                src={authorProfile.photo}
                alt={author}
                width="28"
                height="28"
                class="size-7 rounded-full object-cover border border-ink/10"
              />
            ) : (
              <span class="flex size-7 items-center justify-center rounded-full bg-leaf text-milk font-ui text-xs font-bold">
                {author.slice(0, 1)}
              </span>
            )}
            <span class="font-ui text-sm text-ink">
              <span class="text-stone">
                <span data-kn lang="kn">{home.by.kn}</span>
                <span data-en>{home.by.en}</span>
              </span>{' '}
              <strong class="font-semibold text-leaf group-hover:underline">
                <span lang="kn">{author}</span>
              </strong>
            </span>
          </a>
          <span class="text-stone/40 font-ui text-sm" aria-hidden="true">·</span>
          <ArticleDate date={pubDate} />
        </div>
      </header>
    </div>

    <!-- Cover: full-width with the temple-arch top mask (above fold, no lazy) -->
    <div class="article-cover mx-auto mt-10 max-w-4xl px-4 sm:px-6">
      <div class="overflow-hidden rounded-t-[999px] border border-ink/10 bg-jasmine/30">
        <img
          src={cover}
          alt={coverAlt}
          width={1200}
          height={675}
          decoding="async"
          class="aspect-[16/9] w-full object-cover"
        />
      </div>
    </div>

    <!-- Body -->
    <div class="prose-kadali mx-auto mt-12 max-w-3xl px-4 sm:px-6">
      <Content />
      <AuthorBio author={authorProfile} articlesCount={authorArticlesCount} />
    </div>
  </article>

  <Beads class="mx-auto mt-14 block w-44 text-turmeric" />

  {
    related.length > 0 && (
      <section class="mt-14 bg-jasmine">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
          <h2 class="font-display text-2xl font-semibold text-ink">
            <span data-kn lang="kn" class="text-leaf">{t.related.kn}</span>
            <span data-en class="text-leaf">{t.related.en}</span>
          </h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((rel) => (
              <ArticleCard post={rel} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <ShareLinks url={shareUrl} title={title} />
    </div>
  </section>

  <ArticleLightbox />
</BaseLayout>
