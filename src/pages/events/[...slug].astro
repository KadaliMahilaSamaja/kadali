---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Beads from '../../components/motifs/Beads.astro';
import EventDate from '../../components/events/EventDate.astro';
import EventCard from '../../components/events/EventCard.astro';
import CancelledBadge from '../../components/events/CancelledBadge.astro';
import ArticleCard from '../../components/articles/ArticleCard.astro';
import { istIso } from '../../i18n/dates';
import { deriveStatus, sortEvents } from '../../lib/events';
import { ui } from '../../i18n/ui';

const { articles: tArticles, events: t } = ui;

export async function getStaticPaths() {
  const events = await getCollection('events');
  // Newest-first stories that articles have filed under an event. Each
  // article's event reference is resolved once, then grouped by event id.
  const published = (
    await getCollection('articles', ({ data }) => !data.draft)
  ).sort((a, b) => +b.data.pubDate - +a.data.pubDate);

  const storiesByEventId = new Map<string, CollectionEntry<'articles'>[]>();
  for (const article of published) {
    // The event reference stores {collection, id}; group by the id.
    const ref = article.data.event;
    if (!ref) continue;
    const bucket = storiesByEventId.get(ref.id) ?? [];
    bucket.push(article);
    storiesByEventId.set(ref.id, bucket);
  }

  return events.map((event) => {
    const others = sortEvents(
      events.filter(
        (candidate) =>
          candidate.id !== event.id && deriveStatus(candidate) === 'upcoming',
      ),
    ).slice(0, 2);
    return {
      params: { slug: event.id },
      props: { event, others, stories: storiesByEventId.get(event.id) ?? [] },
    };
  });
}

interface Props {
  event: CollectionEntry<'events'>;
  others: CollectionEntry<'events'>[];
  stories: CollectionEntry<'articles'>[];
}

const { event, others, stories } = Astro.props;
const { Content } = await render(event);
const { title, poster, summary, venue, mapUrl, contact, startAt, endAt } =
  event.data;

const statusLabel = deriveStatus(event);
const siteUrl = (Astro.site ?? new URL('https://kadali.org')).href;

// Structured data: instants pinned to +05:30 so search engines read IST.
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: summary,
  startDate: istIso(startAt),
  endDate: istIso(endAt ?? startAt),
  eventStatus:
    statusLabel === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: venue },
  image: [new URL(poster, siteUrl).href],
  organizer: { '@type': 'Organization', name: 'ಕದಳಿ ವನಿತಾ ಸಮಾಜ', url: siteUrl },
};
---

<BaseLayout
  title={`${title} · ಕಾರ್ಯಕ್ರಮಗಳು — ಕದಳಿ ವನಿತಾ ಸಮಾಜ`}
  titleEn={`${title} · Events — Kadali Vanita Samaja`}
  description={summary}
  image={poster}
  type="article"
>
  <article class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-16">
      <nav aria-label="ಸ್ಥಳ ಸೂಚಿ" class="font-ui text-sm text-stone">
        <a href="/" class="hover:text-leaf hover:underline">
          <span data-kn lang="kn">{tArticles.breadcrumbHome.kn}</span>
          <span data-en>{tArticles.breadcrumbHome.en}</span>
        </a>
        <span aria-hidden="true"> / </span>
        <a href="/events" class="hover:text-leaf hover:underline">
          <span data-kn lang="kn">{t.pageHeading.kn}</span>
          <span data-en>{t.pageHeading.en}</span>
        </a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page" class="text-ink"><span lang="kn">{title}</span></span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-14">
        <!-- Poster with temple-arch mask; above the fold, so eager -->
        <figure class="lg:col-span-5">
          <div class="overflow-hidden rounded-t-[999px] border border-ink/10">
            <img
              src={poster}
              alt={`${title} — ${t.posterSuffix.kn}`}
              width="850"
              height="1100"
              loading="eager"
              decoding="async"
              class="h-auto w-full"
            />
          </div>
        </figure>

        <div class="flex flex-col items-start gap-5 lg:col-span-7">
          {statusLabel === 'cancelled' && <CancelledBadge />}
          <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">
            <span lang="kn">{title}</span>
          </h1>

          <EventDate startAt={startAt} endAt={endAt} size="large" />

          <p class="font-ui text-base text-ink">
            <span class="font-semibold">
              <span data-kn lang="kn">{t.venue.kn}</span>
              <span data-en>{t.venue.en}</span>
            </span>{' '}
            <span lang="kn">{venue}</span>
          </p>

          {
            mapUrl && (
              <a
                href={mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-leaf px-4 py-2 font-ui text-sm font-semibold text-leaf underline-offset-4 transition-colors duration-200 hover:bg-leaf hover:text-cream"
              >
                <span data-kn lang="kn">{t.viewOnMap.kn}</span>
                <span data-en>{t.viewOnMap.en}</span>{' '}
                <span aria-hidden="true">↗</span>
              </a>
            )
          }

          {
            contact && (
              <p class="font-ui text-base text-stone">
                <span class="font-semibold">
                  <span data-kn lang="kn">{t.contact.kn}</span>
                  <span data-en>{t.contact.en}</span>
                </span>{' '}
                <span lang="kn">{contact}</span>
              </p>
            )
          }

          <p class="font-body text-lg text-stone"><span lang="kn">{summary}</span></p>
        </div>
      </div>

      <Beads class="mt-12 w-44 text-turmeric" />

      <div class="prose-kadali mt-8 max-w-3xl">
        <Content />
      </div>
    </div>
  </article>

  {
    stories.length > 0 && (
      <section class="bg-jasmine">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
          <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">
            <span data-kn lang="kn">{t.stories.kn}</span>
            <span data-en>{t.stories.en}</span>
          </h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {stories.map((story) => (
              <ArticleCard post={story} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="bg-jasmine">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
          <h2 class="font-display text-2xl font-semibold text-ink sm:text-3xl">
            <span data-kn lang="kn">{t.otherUpcoming.kn}</span>
            <span data-en>{t.otherUpcoming.en}</span>
          </h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2">
            {others.map((other) => (
              <li>
                <EventCard event={other} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
</BaseLayout>
