---
/**
 * Contact page — ways to reach the samaja. No contact form: the site is
 * fully static, so messages go straight to the club's own email instead
 * of into a backend nobody watches.
 */
import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/pages/PageHero.astro';
import { ui } from '../i18n/ui';

const { contact, events } = ui;

const CONTACT = {
  email: 'contact@kadali.org',
  emailHref: 'mailto:contact@kadali.org',
  addressLines: contact.addressLines,
  mapHref:
    'https://www.google.com/maps/search/?api=1&query=Chowki+Matha+Shivamogga',
};
---

<BaseLayout
  title="ಸಂಪರ್ಕ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ"
  titleEn="Contact · Kadali Vanita Samaja"
  description="ಕದಳಿ ವನಿತಾ ಸಮಾಜವನ್ನು ಸಂಪರ್ಕಿಸಿ — ಇಮೇಲ್ contact@kadali.org, ಅಥವಾ ಶಿವಮೊಗ್ಗದ ಚೌಕಿ ಮಠದಲ್ಲಿ ಭೇಟಿಯಾಗಿ."
  descriptionEn="Reach Kadali Vanita Samaja — email contact@kadali.org, or visit Chowki Matha in Shivamogga."
>
  <PageHero
    eyebrow={contact.eyebrow}
    title={contact.title}
    lede={contact.lede}
    tone="jasmine"
  />

  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="sr-only">{contact.ways.kn}</h2>
      <ul class="grid gap-6 sm:grid-cols-2">
        <!-- Email -->
        <li class="flex flex-col border border-ink/10 bg-jasmine p-6">
          <div class="flex items-center gap-3">
            <svg
              class="size-6 shrink-0 text-leaf"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="1"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <h3
              class="font-ui text-xs font-semibold tracking-[0.2em] text-stone"
            >
              <span data-kn lang="kn">{contact.email.kn}</span>
              <span data-en>{contact.email.en}</span>
            </h3>
          </div>
          <p class="mt-4 font-display text-xl font-semibold break-all text-ink">
            {CONTACT.email}
          </p>
          <p class="mt-2 font-body text-base text-stone">
            <span data-kn lang="kn">{contact.emailLede.kn}</span>
            <span data-en class="font-serif">{contact.emailLede.en}</span>
          </p>
          <a
            href={CONTACT.emailHref}
            class="mt-auto self-start pt-4 font-ui text-sm font-semibold text-leaf underline-offset-4 hover:underline"
          >
            <span data-kn lang="kn">{contact.writeEmail.kn}</span>
            <span data-en>{contact.writeEmail.en}</span>
            <span aria-hidden="true"> ↗</span>
          </a>
        </li>

        <!-- Visit -->
        <li class="flex flex-col border border-ink/10 bg-jasmine p-6">
          <div class="flex items-center gap-3">
            <svg
              class="size-6 shrink-0 text-leaf"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11Z"
              ></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <h3
              class="font-ui text-xs font-semibold tracking-[0.2em] text-stone"
            >
              <span data-kn lang="kn">{contact.visit.kn}</span>
              <span data-en>{contact.visit.en}</span>
            </h3>
          </div>
          <address
            class="mt-4 font-display text-xl font-semibold not-italic text-ink"
          >
            <span data-kn lang="kn">
              {CONTACT.addressLines.map((line, i) => (
                <span class:list={['block', i > 0 && 'mt-0.5']}>{line.kn}</span>
              ))}
            </span>
            <span data-en>
              {CONTACT.addressLines.map((line, i) => (
                <span class:list={['block', i > 0 && 'mt-0.5']}>{line.en}</span>
              ))}
            </span>
          </address>
          <p class="mt-2 font-body text-base text-stone">
            <span data-kn lang="kn">{contact.visitLede.kn}</span>
            <span data-en class="font-serif">{contact.visitLede.en}</span>
          </p>
          <a
            href={CONTACT.mapHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto self-start pt-4 font-ui text-sm font-semibold text-leaf underline-offset-4 hover:underline"
          >
            <span data-kn lang="kn">{events.viewOnMap.kn}</span>
            <span data-en>{events.viewOnMap.en}</span>
            <span aria-hidden="true"> ↗</span>
          </a>
        </li>
      </ul>

      <div class="mt-10 border border-ink/10 bg-jasmine p-6 sm:p-8">
        <h2 class="font-display text-2xl font-semibold text-ink">
          <span data-kn lang="kn">{contact.noFormTitle.kn}</span>
          <span data-en>{contact.noFormTitle.en}</span>
        </h2>
        <p class="mt-3 max-w-2xl font-body text-base text-stone">
          <span data-kn lang="kn">{contact.noFormLede.kn}</span>
          <span data-en class="font-serif">{contact.noFormLede.en}</span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
