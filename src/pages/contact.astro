---
/**
 * Contact page — ways to reach the samaja. No contact form: the site is
 * fully static, so messages go straight to the club's own email instead
 * of into a backend nobody watches.
 */
import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/pages/PageHero.astro';

const CONTACT = {
  email: 'contact@kadali.org',
  emailHref: 'mailto:contact@kadali.org',
  addressLines: ['ಕದಳಿ ವನಿತಾ ಸಮಾಜ', 'ಚೌಕಿ ಮಠ', 'ಶಿವಮೊಗ್ಗ, ಕರ್ನಾಟಕ'],
  mapHref:
    'https://www.google.com/maps/search/?api=1&query=Chowki+Matha+Shivamogga',
};
---

<BaseLayout
  title="ಸಂಪರ್ಕ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ"
  description="ಕದಳಿ ವನಿತಾ ಸಮಾಜವನ್ನು ಸಂಪರ್ಕಿಸಿ — ಇಮೇಲ್ contact@kadali.org, ಅಥವಾ ಶಿವಮೊಗ್ಗದ ಚೌಕಿ ಮಠದಲ್ಲಿ ಭೇಟಿಯಾಗಿ."
>
  <PageHero
    eyebrow="ಕದಳಿ ವನಿತಾ ಸಮಾಜ"
    title="ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ"
    lede="ಒಂದು ಸಂದೇಶ ಸಾಕು — ಇಮೇಲ್ ಬರೆಯಿರಿ ಅಥವಾ ಶಿವಮೊಗ್ಗದ ಚೌಕಿ ಮಠಕ್ಕೆ ಬನ್ನಿ. ದಿನದ ಕೆಲಸಗಳ ನಡುವೆ ಉತ್ತರಿಸುತ್ತೇವೆ."
    tone="jasmine"
  />

  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="sr-only">ಸಂಪರ್ಕದ ದಾರಿಗಳು</h2>
      <ul class="grid gap-6 sm:grid-cols-2">
        <!-- Email -->
        <li class="flex flex-col border border-ink/10 bg-jasmine p-6">
          <div class="flex items-center gap-3">
            <svg
              class="size-6 shrink-0 text-leaf"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="1"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <h3
              class="font-ui text-xs font-semibold tracking-[0.2em] text-stone"
            >
              <span>ಇಮೇಲ್</span>
            </h3>
          </div>
          <p class="mt-4 font-display text-xl font-semibold break-all text-ink">
            {CONTACT.email}
          </p>
          <p class="mt-2 font-body text-base text-stone">
            ಸದಸ್ಯತ್ವ, ಕಾರ್ಯಕ್ರಮಗಳು, ಬರಹಗಳ ಹಂಚಿಕೆ — ಬರೆದು ಇಟ್ಟರೆ
            ಸಾಕು.
          </p>
          <a
            href={CONTACT.emailHref}
            class="mt-auto self-start pt-4 font-ui text-sm font-semibold text-leaf underline-offset-4 hover:underline"
          >
            <span>ಇಮೇಲ್ ಬರೆಯಿರಿ</span>
            <span aria-hidden="true"> ↗</span>
          </a>
        </li>

        <!-- Visit -->
        <li class="flex flex-col border border-ink/10 bg-jasmine p-6">
          <div class="flex items-center gap-3">
            <svg
              class="size-6 shrink-0 text-leaf"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11Z"
              ></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <h3
              class="font-ui text-xs font-semibold tracking-[0.2em] text-stone"
            >
              <span>ಭೇಟಿ</span>
            </h3>
          </div>
          <address
            class="mt-4 font-display text-xl font-semibold not-italic text-ink"
          >
            {
              CONTACT.addressLines.map((line, i) => (
                <span class:list={['block', i > 0 && 'mt-0.5']}>{line}</span>
              ))
            }
          </address>
          <p class="mt-2 font-body text-base text-stone">
            ಸಭೆಗಳು ಶಿವಮೊಗ್ಗದ ಚೌಕಿ ಮಠದ ಸುತ್ತ ನಡೆಯುತ್ತವೆ; ಮೊದಲು ಸಂದೇಶ
            ಕಳಿಸಿದರೆ ಸರಿಯಾದ ಸಮಯ ಹೇಳಿಕೊಡುತ್ತೇವೆ.
          </p>
          <a
            href={CONTACT.mapHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto self-start pt-4 font-ui text-sm font-semibold text-leaf underline-offset-4 hover:underline"
          >
            <span>ನಕ್ಷೆಯಲ್ಲಿ ನೋಡಿ</span>
            <span aria-hidden="true"> ↗</span>
          </a>
        </li>
      </ul>

      <div class="mt-10 border border-ink/10 bg-jasmine p-6 sm:p-8">
        <h2 class="font-display text-2xl font-semibold text-ink">
          <span>ಅರ್ಜಿ ಇಲ್ಲ — ಬೇಕಾಗಿಲ್ಲ</span>
        </h2>
        <p class="mt-3 max-w-2xl font-body text-base text-stone">
          ಈ ಜಾಲತಾಣದಲ್ಲಿ ಯಾವುದೇ ಫಾರ್ಮ್ ಇಲ್ಲ, ದತ್ತಾಂಶ ಸಂಗ್ರಹವಿಲ್ಲ. ಇಮೇಲ್
          ಕೊಂಡಿ ನಿಮ್ಮದೇ ಮೇಲ್ ಅಪ್ಲಿಕೇಶನ್ ತೆರೆಯುತ್ತದೆ — ನಿಮ್ಮ ಸಂದೇಶ
          ನೇರವಾಗಿ ಸಮಾಜಕ್ಕೆ ಬರುತ್ತದೆ, ಬೇರೆ ಯಾವುದೇ ಸರ್ವರ್‌ಗೆ ಹೋಗುವುದಿಲ್ಲ.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
