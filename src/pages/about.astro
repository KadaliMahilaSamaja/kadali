<BaseLayout
  title="ನಮ್ಮ ಬಗ್ಗೆ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ, ಶಿವಮೊಗ್ಗ"
  titleEn="About us · Kadali Vanita Samaja, Shivamogga"
  description="1993ರಲ್ಲಿ ಶಿವಮೊಗ್ಗದಲ್ಲಿ ಜ್ಯೋತಿ ಬೆಳಗುವ ಮೂಲಕ ಆರಂಭವಾದ ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಮೂರು ದಶಕಗಳ ಸಾರ್ಥಕ ಸೇವಾ ಪಯಣ, ಮಹಿಳಾ ಸಬಲೀಕರಣ ಮತ್ತು ಸಾಧನೆಗಳ ವಿವರ."
  descriptionEn="Three decades of rewarding service by Kadali Vanita Samaja, begun by lighting a lamp in Shivamogga in 1993 — women's empowerment, milestones and the committee."
>
  <PageHero
    eyebrow={{ kn: 'ಕದಳಿ ವನಿತಾ ಸಮಾಜ · ಶಿವಮೊಗ್ಗ', en: 'Kadali Vanita Samaja · Shivamogga' }}
    title={{
      kn: 'ಸಮಾಜಸೇವೆಯೇ ಬದುಕಿನ ಉಸಿರು · ಮಹಿಳಾ ಸಬಲೀಕರಣವೇ ಸಂಕಲ್ಪ',
