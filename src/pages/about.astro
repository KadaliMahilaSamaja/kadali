---
/**
 * About page — ಕದಳಿ ವನಿತಾ ಸಮಾಜ, ಶಿವಮೊಗ್ಗ.
 * 1993ರಿಂದ ಇಂದಿನವರೆಗಿನ ಮೂರು ದಶಕಗಳ ಸಾರ್ಥಕ ಪಯಣ, ಸಂಸ್ಥಾಪನೆಯ ಹಿನ್ನೆಲೆ,
 * ಧ್ಯೇಯೋದ್ದೇಶಗಳು ಮತ್ತು ಪ್ರಮುಖ ಸಾಧನೆಗಳ ಅಧಿಕೃತ ವಿವರ.
 */
import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/pages/PageHero.astro';
import Beads from '../components/motifs/Beads.astro';
import FlowerLine from '../motifs/FlowerLine.astro';
import CommitteeSection from '../components/pages/CommitteeSection.astro';
---

<BaseLayout
  title="ನಮ್ಮ ಬಗ್ಗೆ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ, ಶಿವಮೊಗ್ಗ"
  description="1993ರಲ್ಲಿ ಶಿವಮೊಗ್ಗದಲ್ಲಿ ಜ್ಯೋತಿ ಬೆಳಗುವ ಮೂಲಕ ಆರಂಭವಾದ ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಮೂರು ದಶಕಗಳ ಸಾರ್ಥಕ ಸೇವಾ ಪಯಣ, ಮಹಿಳಾ ಸಬಲೀಕರಣ ಮತ್ತು ಸಾಧನೆಗಳ ವಿವರ."
>
  <PageHero
    eyebrow="ಕದಳಿ ವನಿತಾ ಸಮಾಜ · ಶಿವಮೊಗ್ಗ"
    title="ಸಮಾಜಸೇವೆಯೇ ಬದುಕಿನ ಉಸಿರು · ಮಹಿಳಾ ಸಬಲೀಕರಣವೇ ಸಂಕಲ್ಪ"
    kn="ಮೂರು ದಶಕಗಳಿಗೂ ಮೀರಿದ ಸಾರ್ಥಕ ಸೇವಾ ಪಯಣ (1993 – 2026)"
    lede="ಜನಸೇವೆ, ಜನಸಂಘಟನೆ ಹಾಗೂ ಸಮಾಜಮುಖಿ ಚಿಂತನೆಯೊಂದಿಗೆ ಆರಂಭವಾದ ಕದಳಿ ವನಿತಾ ಸಮಾಜವು ಮಹಿಳೆಯರಲ್ಲಿ ಜಾಗೃತಿ, ಆತ್ಮವಿಶ್ವಾಸ, ಸಂಸ್ಕೃತಿ ಮತ್ತು ಸಮಾಜಮುಖಿ ಸೇವೆಯ ಬೆಳಕನ್ನು ನಿರಂತರವಾಗಿ ಹರಡುತ್ತಿದೆ."
    tone="leaf"
  />

  <!-- 1. ಸಂಸ್ಥಾಪನೆ ಮತ್ತು ಹಿನ್ನೆಲೆ (Founding & History) -->
  <section class="bg-cream">
    <div
      class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-14"
    >
      <div>
        <p class="font-ui text-xs font-semibold tracking-[0.2em] uppercase text-leaf">
          ಸ್ಥಾಪನೆಯ ಇತಿಹಾಸ
        </p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">
          ಜ್ಯೋತಿ ಬೆಳಗಿಸಿ ಆರಂಭವಾದ ಸೇವಾ ಪಯಣ
        </h2>

        <div class="mt-8 space-y-5 font-body text-lg leading-relaxed text-stone">
          <p>
            ಜನಸೇವೆ, ಜನಸಂಘಟನೆ ಹಾಗೂ ಸಮಾಜಮುಖಿ ಚಿಂತನೆಗಳ ವಾತಾವರಣದಲ್ಲಿ ಬೆಳೆದು ಬಂದ ಅಕ್ಕನವರು (ರೇಣುಕಾ ಶಿವಾನಂದಪ್ಪ) ತಮ್ಮ ಜನ್ಮಸ್ಥಳವಾದ ಶಿವಮೊಗ್ಗ ಜಿಲ್ಲೆಗೆ ಬಂದು ನೆಲೆಸಿದ ಸಂದರ್ಭದಲ್ಲಿ, ಇಲ್ಲಿನ ಮಹಿಳೆಯರನ್ನು ಸಂಘಟಿಸಿ, ಅವರಲ್ಲಿ ಜಾಗೃತಿ, ಆತ್ಮವಿಶ್ವಾಸ ಹಾಗೂ ಸಾಮಾಜಿಕ ಪ್ರಜ್ಞೆಯನ್ನು ಮೂಡಿಸಬೇಕೆಂಬ ಮಹತ್ತರ ಆಶಯ ಅವರಲ್ಲಿ ಮೂಡಿತು. ಈ ಚಿಂತನೆಯೇ ಮುಂದೆ ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಸ್ಥಾಪನೆಗೆ ದೃಢ ಪ್ರೇರಣೆಯಾಯಿತು.
          </p>
          <p>
            ಕೆಲವು ಸಮಾನ ಮನಸ್ಕ ಸ್ನೇಹಿತೆಯರ ಸಹಕಾರ, ಪ್ರೋತ್ಸಾಹ ಮತ್ತು ಸಮರ್ಪಣಾ ಮನೋಭಾವದೊಂದಿಗೆ <strong class="font-semibold text-ink">ದಿನಾಂಕ 12-03-1993 ರಂದು</strong> ಕದಳಿ ವನಿತಾ ಸಮಾಜ ಅಸ್ತಿತ್ವಕ್ಕೆ ಬಂದು, ಒಂದು ಸಶಕ್ತ ಸಂಘಟನೆಯಾಗಿ ರೂಪುಗೊಂಡಿತು.
          </p>
          <p>
            ಅಂದಿನ ಶಿವಮೊಗ್ಗ ಜಿಲ್ಲಾಧಿಕಾರಿಗಳ ಪತ್ನಿಯಾದ <strong class="font-semibold text-ink">ಶ್ರೀಮತಿ ಪ್ರೇಮಲತಾ ಸದಾಶಿವಯ್ಯನವರ</strong> ಅಮೃತ ಹಸ್ತದಿಂದ ಜ್ಯೋತಿ ಬೆಳಗಿಸುವ ಮೂಲಕ ಅತ್ಯಂತ ಸರಳ ಹಾಗೂ ಅರ್ಥಪೂರ್ಣ ಸಮಾರಂಭದಲ್ಲಿ ಸಮಾಜಕ್ಕೆ ಚಾಲನೆ ನೀಡಲಾಯಿತು. ಅಂದು ಬೆಳಗಿದ ಆ ಜ್ಯೋತಿ ಇಂದು ಸಹಸ್ರಾರು ಮಹಿಳೆಯರ ಬದುಕಿನಲ್ಲಿ ಜ್ಞಾನ, ಜಾಗೃತಿ, ಆತ್ಮವಿಶ್ವಾಸ ಮತ್ತು ಸೇವೆಯ ಬೆಳಕನ್ನು ಹರಡುತ್ತಿದೆ.
          </p>
        </div>

        <!-- Featured Founding Photo -->
        <figure class="mt-10 overflow-hidden border border-ink/10 bg-jasmine p-3">
          <div class="overflow-hidden rounded-t-[999px] border border-ink/10">
            <img
              src="/images/uploads/poster-deepa-lighting.jpg"
              alt="ಜ್ಯೋತಿ ಬೆಳಗಿಸುವ ಮೂಲಕ ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಸೇವಾ ಪಯಣಕ್ಕೆ ಚಾಲನೆ ನೀಡಿದ ಮಂಗಳಕರ ಕ್ಷಣದ ಕಲಾಚಿತ್ರ"
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
              class="aspect-[16/9] w-full object-cover"
            />
          </div>
          <figcaption class="mt-3 px-2 pb-1 font-ui text-sm text-stone text-center">
            ಮಂಗಳಕರ ಜ್ಯೋತಿ ಬೆಳಗಿಸುವ ಮೂಲಕ ಆರಂಭವಾದ ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಸೇವಾ ಪಯಣ
          </figcaption>
        </figure>
      </div>

      <!-- Quick Summary Aside -->
      <aside class="mt-12 self-start border border-ink/10 bg-jasmine p-6 sm:p-8 lg:mt-0">
        <h3 class="font-ui text-xs font-semibold tracking-[0.2em] uppercase text-leaf">
          ಒಂದು ನೋಟದಲ್ಲಿ
        </h3>
        <dl class="mt-6 space-y-5">
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸ್ಥಾಪನೆ ದಿನಾಂಕ
            </dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink">
              12 ಮಾರ್ಚ್ 1993
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸ್ಥಳ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ಶಿವಮೊಗ್ಗ, ಕರ್ನಾಟಕ
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಆದರ್ಶ ಪ್ರೇರಣೆ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ಶರಣೆ ಅಕ್ಕಮಹಾದೇವಿ ಹಾಗೂ ಬಸವಾದಿ ಶರಣರ ಸಮಾನತೆ, ಕಾಯಕ ಮತ್ತು ದಾಸೋಹ ತತ್ವಗಳು
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಹೆಸರಿನ ಹಿನ್ನೆಲೆ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              <span lang="kn" class="font-semibold text-leaf">ಕದಳಿ</span> — ಬಾಳೆಗಿಡ (ಆಶ್ರಯ ಮತ್ತು ತಂಪು ನೀಡುವ ನಿಸರ್ಗದ ಸಂಕೇತ) ಹಾಗೂ ಅಕ್ಕಮಹಾದೇವಿ ಐಕ್ಯವಾದ ಪವಿತ್ರ ಕದಳಿ ವನ.
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸಾರ್ಥಕ ಮೈಲಿಗಲ್ಲು
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ರಜತ ಮಹೋತ್ಸವ (ಬೆಳ್ಳಿ ಹಬ್ಬ) ಪೂರೈಸಿ 35ನೇ ವರ್ಷದತ್ತ ಸಾಗುತ್ತಿರುವ ಹೆಮ್ಮೆಯ ಇತಿಹಾಸ
            </dd>
          </div>
          <div>
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸದಸ್ಯತ್ವ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ಎಲ್ಲಾ ವರ್ಗದ ಮಹಿಳೆಯರಿಗೂ ಮುಕ್ತ ಸ್ವಾಗತ
            </dd>
          </div>
        </dl>

        <div class="mt-8 pt-4 border-t border-ink/10">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 font-ui text-sm font-semibold text-leaf underline-offset-4 hover:underline"
          >
            <span>ಸಮಾಜದೊಂದಿಗೆ ಸಂಪರ್ಕದಲ್ಲಿರಿ</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <div class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <Beads class="w-40 text-turmeric" />
    </div>
  </div>

  <!-- 2. ಸಮಾಜದ ಉದ್ದೇಶ ಮತ್ತು ಧ್ಯೇಯಗಳು (Aims & Objectives) -->
  <section class="bg-jasmine">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="max-w-3xl">
        <p class="font-ui text-xs font-semibold tracking-[0.2em] uppercase text-leaf">
          ಮೂಲ ಸಂಕಲ್ಪ
        </p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">
          ಸಮಾಜದ ಉದ್ದೇಶ ಮತ್ತು ಧ್ಯೇಯಗಳು
        </h2>
        <p class="mt-4 font-body text-lg text-stone">
          ಯಾವುದೇ ಸಂಘಟನೆ ಸ್ಥಾಪನೆಯಾಗುವಾಗ ಅದರ ಹಿಂದೆ ಒಂದು ದೂರದೃಷ್ಟಿ ಇರುತ್ತದೆ. ಕದಳಿ ವನಿತಾ ಸಮಾಜವು ಮಹಿಳೆಯರ ಸರ್ವತೋಮುಖ ಅಭಿವೃದ್ಧಿಯನ್ನು ತನ್ನ ಪ್ರಮುಖ ಗುರಿಯನ್ನಾಗಿ ಸ್ವೀಕರಿಸಿದೆ.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Pillar 1 -->
        <div class="border border-ink/10 bg-cream p-6">
          <div class="font-ui text-xs font-semibold text-turmeric">01</div>
          <h3 class="mt-2 font-display text-xl font-semibold text-ink">
            ಮಹಿಳಾ ಸಬಲೀಕರಣ & ಜಾಗೃತಿ
          </h3>
          <p class="mt-3 font-body text-base text-stone">
            ಮಹಿಳೆಯರ ವರ್ತಮಾನವನ್ನು ಸುಧಾರಿಸುವುದರ ಜೊತೆಗೆ ಅವರ ಭವಿಷ್ಯವನ್ನು ಉಜ್ವಲಗೊಳಿಸುವಂತಹ ತಿಳುವಳಿಕೆ, ಅರಿವು ಮತ್ತು ಆತ್ಮವಿಶ್ವಾಸವನ್ನು ಪ್ರತಿಯೊಬ್ಬ ಸದಸ್ಯೆಯಲ್ಲಿಯೂ ಮೂಡಿಸುವುದು.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="border border-ink/10 bg-cream p-6">
          <div class="font-ui text-xs font-semibold text-turmeric">02</div>
          <h3 class="mt-2 font-display text-xl font-semibold text-ink">
            ವಿದ್ಯಾಭ್ಯಾಸ & ಪ್ರತಿಭೆಗೆ ಪ್ರೋತ್ಸಾಹ
          </h3>
          <p class="mt-3 font-body text-base text-stone">
            ಮಹಿಳೆಯರ ವಿದ್ಯಾಭ್ಯಾಸಕ್ಕೆ ಪ್ರೋತ್ಸಾಹ ನೀಡುವುದು, ಅಗತ್ಯವಿರುವವರಿಗೆ ನೆರವಿನ ಹಸ್ತ ಚಾಚುವುದು ಹಾಗೂ ಅವರ ಪ್ರತಿಭೆ ಮತ್ತು ಸಾಮರ್ಥ್ಯಗಳನ್ನು ಗುರುತಿಸಿ ಸಾಮಾಜಿಕ, ಶೈಕ್ಷಣಿಕ ಬೆಳವಣಿಗೆಗೆ ಪೂರಕ ಕಾರ್ಯಕ್ರಮಗಳನ್ನು ನಡೆಸುವುದು.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="border border-ink/10 bg-cream p-6">
          <div class="font-ui text-xs font-semibold text-turmeric">03</div>
          <h3 class="mt-2 font-display text-xl font-semibold text-ink">
            ಶರಣ ಸಾಹಿತ್ಯ & ವಚನ ಸಂದೇಶ
          </h3>
          <p class="mt-3 font-body text-base text-stone">
            ವಿಶ್ವಮಾನವೀಯತೆಯ ತತ್ವಗಳು ಹಾಗೂ ಬಸವಣ್ಣನವರ ಸಮಾನತೆ, ಕಾಯಕ, ದಾಸೋಹ ಮತ್ತು ಮಾನವೀಯ ಮೌಲ್ಯಗಳನ್ನು ಬಿತ್ತುವುದು; ಶರಣ ಸಾಹಿತ್ಯ ಮತ್ತು ವಚನ ಸಾಹಿತ್ಯದ ಮಹತ್ವವನ್ನು ಎಲ್ಲ ವರ್ಗದ ಜನರಿಗೆ ತಲುಪಿಸುವುದು.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div class="border border-ink/10 bg-cream p-6">
          <div class="font-ui text-xs font-semibold text-turmeric">04</div>
          <h3 class="mt-2 font-display text-xl font-semibold text-ink">
            ಸಮಾಜ ನಿರ್ಮಾಣದಲ್ಲಿ ಮಹಿಳೆಯ ಪಾತ್ರ
          </h3>
          <p class="mt-3 font-body text-base text-stone">
            ಮಹಿಳೆಯರು ಕೇವಲ ಕುಟುಂಬದ ಜವಾಬ್ದಾರಿಯನ್ನು ಮಾತ್ರವಲ್ಲದೆ ಸಮಾಜದ ನಿರ್ಮಾಣದಲ್ಲಿಯೂ ಪ್ರಮುಖ ಪಾತ್ರ ವಹಿಸಬಲ್ಲರು ಎಂಬ ಅರಿವನ್ನು ಮೂಡಿಸುವುದು.
          </p>
        </div>

        <!-- Pillar 5 -->
        <div class="border border-ink/10 bg-cream p-6">
          <div class="font-ui text-xs font-semibold text-turmeric">05</div>
          <h3 class="mt-2 font-display text-xl font-semibold text-ink">
            ರಾಷ್ಟ್ರೀಯ ಹಬ್ಬಗಳು & ಸಂಸ್ಕೃತಿ
          </h3>
          <p class="mt-3 font-body text-base text-stone">
            ರಾಷ್ಟ್ರೀಯ ಹಬ್ಬಗಳು ಹಾಗೂ ಮಹನೀಯರ ಜಯಂತಿಗಳನ್ನು ಆಚರಿಸುವ ಮೂಲಕ ದೇಶಭಕ್ತಿ, ಭಾರತೀಯ ಸಂಸ್ಕೃತಿ ಮತ್ತು ಸಾಮಾಜಿಕ ಜವಾಬ್ದಾರಿಯ ಭಾವನೆಯನ್ನು ಬೆಳೆಸುವುದು.
          </p>
        </div>

        <!-- Pillar 6 -->
        <div class="border border-ink/10 bg-cream p-6">
          <div class="font-ui text-xs font-semibold text-turmeric">06</div>
          <h3 class="mt-2 font-display text-xl font-semibold text-ink">
            ಆರೋಗ್ಯ & ಸಮುದಾಯ ಕಾಳಜಿ
          </h3>
          <p class="mt-3 font-body text-base text-stone">
            ಉಚಿತ ಆರೋಗ್ಯ ತಪಾಸಣಾ ಶಿಬಿರಗಳು, ಯೋಗ ತರಬೇತಿ ಹಾಗೂ ನೇತ್ರದಾನ ಜಾಗೃತಿಯ ಮೂಲಕ ಸಮುದಾಯದ ದೈಹಿಕ ಮತ್ತು ಮಾನಸಿಕ ಆರೋಗ್ಯ ಸುಧಾರಣೆಗೆ ಶ್ರಮಿಸುವುದು.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-jasmine">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
