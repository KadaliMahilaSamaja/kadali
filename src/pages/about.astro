---
/**
 * About page — ಕದಳಿ ವನಿತಾ ಸಮಾಜ, ಶಿವಮೊಗ್ಗ.
 * About Us-style summary: founding facts, mission, milestones and the committee,
 * distilled from the founder's article (which carries the full narrative and
 * photos — linked from here instead of duplicated).
 */
import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/pages/PageHero.astro';
import Beads from '../components/motifs/Beads.astro';
import CommitteeSection from '../components/pages/CommitteeSection.astro';

const ARTICLE_URL = '/articles/kadali-vanita-samaja';

/** Mission pillars — one short line each, independent of the article's prose. */
const OBJECTIVES = [
  {
    title: 'ಮಹಿಳಾ ಸಬಲೀಕರಣ ಮತ್ತು ಜಾಗೃತಿ',
    text: 'ಪ್ರತಿಯೊಬ್ಬ ಸದಸ್ಯೆಯಲ್ಲಿ ಅರಿವು ಮತ್ತು ಆತ್ಮವಿಶ್ವಾಸ ಮೂಡಿಸುವುದು.',
  },
  {
    title: 'ವಿದ್ಯಾಭ್ಯಾಸ ಮತ್ತು ಪ್ರತಿಭೆಗೆ ಪ್ರೋತ್ಸಾಹ',
    text: 'ಅಗತ್ಯವಿರುವವರಿಗೆ ನೆರವು, ಪ್ರತಿಭೆಗೆ ಗೌರವ.',
  },
  {
    title: 'ಶರಣ ಸಾಹಿತ್ಯ ಮತ್ತು ವಚನ ಸಂದೇಶ',
    text: 'ಸಮಾನತೆ, ಕಾಯಕ ಮತ್ತು ದಾಸೋಹ ತತ್ವಗಳನ್ನು ಎಲ್ಲ ವರ್ಗದ ಜನರಿಗೆ ತಲುಪಿಸುವುದು.',
  },
  {
    title: 'ಸಮಾಜ ನಿರ್ಮಾಣದಲ್ಲಿ ಮಹಿಳೆಯ ಪಾತ್ರ',
    text: 'ಮಹಿಳೆ ಕುಟುಂಬದಷ್ಟೇ ಸಮಾಜದ ನಿರ್ಮಾತೃ ಎಂಬ ಅರಿವು.',
  },
  {
    title: 'ರಾಷ್ಟ್ರೀಯ ಹಬ್ಬಗಳು ಮತ್ತು ಸಂಸ್ಕೃತಿ',
    text: 'ಹಬ್ಬ-ಜಯಂತಿಗಳ ಆಚರಣೆಯ ಮೂಲಕ ದೇಶಭಕ್ತಿ ಬೆಳೆಸುವುದು.',
  },
  {
    title: 'ಆರೋಗ್ಯ ಮತ್ತು ಸಮುದಾಯ ಕಾಳಜಿ',
    text: 'ಆರೋಗ್ಯ ಶಿಬಿರಗಳು, ಯೋಗ ಮತ್ತು ನೇತ್ರದಾನ ಜಾಗೃತಿ.',
  },
] as const;

/** Three decades of milestones — fact lines distilled from the article. */
const MILESTONES = [
  {
    title: 'ಶ್ರೀಮತಿ ಕದಳಿ ಸಿರಿ ಪ್ರಶಸ್ತಿ',
    text: 'ರಾಜ್ಯಮಟ್ಟದಲ್ಲಿ ಸಾಧನೆ ಮಾಡಿದ ಮಹಿಳೆಯರಿಗೆ ಗೌರವ.',
  },
  {
    title: 'ನೇತ್ರದಾನ ಜಾಗೃತಿ ಮತ್ತು ಯೋಜನೆ',
    text: 'ಯಶಸ್ವಿಯಾಗಿ ನಿರ್ವಹಿಸಲಾದ ಮಾನವೀಯ ಸೇವಾ ಕಾರ್ಯ.',
  },
  {
    title: 'ಉಚಿತ ಆರೋಗ್ಯ ತಪಾಸಣಾ ಶಿಬಿರಗಳು',
    text: 'ಪ್ರತಿ ವರ್ಷ ಮಹಿಳೆಯರ ಆರೋಗ್ಯದ ಕಾಳಜಿ.',
  },
  {
    title: 'ಯೋಗ ತರಬೇತಿ',
    text: 'ದೈಹಿಕ ಮತ್ತು ಮಾನಸಿಕ ಆರೋಗ್ಯದ ಅಭ್ಯಾಸಕ್ಕೆ ಪ್ರೋತ್ಸಾಹ.',
  },
  {
    title: "'ವಚನಯಾನ' ನಾಟಕ",
    text: 'ಶರಣೆ ಅಕ್ಕನಾಗವ್ವ ಸ್ಮರಣಾರ್ಥ ಬಸವ ಕೇಂದ್ರದ ಸಹಕಾರದ ರಂಗಪ್ರಯೋಗ.',
  },
  {
    title: 'ಪ್ರತಿಭಾ ಪ್ರದರ್ಶನ ಮತ್ತು ಅರಿವು ಕಾರ್ಯಕ್ರಮಗಳು',
    text: 'ಸಾಮಾಜಿಕ ಮತ್ತು ಸಾಂಸ್ಕೃತಿಕ ಚಿಂತನೆಯ ವೇದಿಕೆ.',
  },
] as const;
---

<BaseLayout
  title="ನಮ್ಮ ಬಗ್ಗೆ · ಕದಳಿ ವನಿತಾ ಸಮಾಜ, ಶಿವಮೊಗ್ಗ"
  description="1993ರಲ್ಲಿ ಶಿವಮೊಗ್ಗದಲ್ಲಿ ಜ್ಯೋತಿ ಬೆಳಗುವ ಮೂಲಕ ಆರಂಭವಾದ ಕದಳಿ ವನಿತಾ ಸಮಾಜದ ಮೂರು ದಶಕಗಳ ಸಾರ್ಥಕ ಸೇವಾ ಪಯಣ, ಮಹಿಳಾ ಸಬಲೀಕರಣ ಮತ್ತು ಸಾಧನೆಗಳ ವಿವರ."
>
  <PageHero
    eyebrow="ಕದಳಿ ವನಿತಾ ಸಮಾಜ · ಶಿವಮೊಗ್ಗ"
    title="ಸಮಾಜಸೇವೆಯೇ ಬದುಕಿನ ಉಸಿರು · ಮಹಿಳಾ ಸಬಲೀಕರಣವೇ ಸಂಕಲ್ಪ"
    kn="ಮೂರು ದಶಕಗಳಿಗೂ ಮೀರಿದ ಸಾರ್ಥಕ ಸೇವಾ ಪಯಣ (1993 – 2026)"
    lede="ಶಿವಮೊಗ್ಗದಲ್ಲಿ ಮಹಿಳಾ ಸಬಲೀಕರಣ, ಸಂಸ್ಕೃತಿ ಮತ್ತು ಸಮಾಜಸೇವೆಗಾಗಿ 1993ರಿಂದ ನಿರಂತರವಾಗಿ ದುಡಿಯುತ್ತಿರುವ ಸಂಘಟನೆ — ನಮ್ಮ ಹಿನ್ನೆಲೆ, ಧ್ಯೇಯ ಮತ್ತು ಸಮಿತಿಯ ಪರಿಚಯ."
    tone="leaf"
  />

  <!-- 1. ಸಂಸ್ಥಾಪನೆ — distilled facts; full story lives in the article -->
  <section class="bg-cream">
    <div
      class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-14"
    >
      <div>
        <p class="font-ui text-xs font-semibold tracking-[0.2em] uppercase text-leaf">
          ಸ್ಥಾಪನೆಯ ಇತಿಹಾಸ
        </p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">
          ಜ್ಯೋತಿ ಬೆಳಗಿಸಿ ಆರಂಭವಾದ ಸೇವಾ ಪಯಣ
        </h2>

        <div class="mt-8 space-y-5 font-body text-lg leading-relaxed text-stone">
          <p>
            ಮಹಿಳೆಯರನ್ನು ಸಂಘಟಿಸಿ, ಅವರಲ್ಲಿ ಜಾಗೃತಿ ಮತ್ತು ಆತ್ಮವಿಶ್ವಾಸ ಮೂಡಿಸುವ ಆಶಯದೊಂದಿಗೆ
            <strong class="font-semibold text-ink">ರೇಣುಕಾ ಶಿವಾನಂದಪ್ಪ</strong> ಹಾಗೂ ಸಮಾನ
            ಮನಸ್ಕ ಸ್ನೇಹಿತೆಯರ ಸಮೂಹವೊಂದು <strong class="font-semibold text-ink">12 ಮಾರ್ಚ್
            1993ರಂದು</strong> ಶಿವಮೊಗ್ಗದಲ್ಲಿ ಕದಳಿ ವನಿತಾ ಸಮಾಜವನ್ನು ಕಟ್ಟಿಬೆಳೆಸಿತು.
          </p>
          <p>
            ಅಂದಿನ ಜಿಲ್ಲಾಧಿಕಾರಿಗಳ ಪತ್ನಿ <strong class="font-semibold text-ink">ಶ್ರೀಮತಿ ಪ್ರೇಮಲತಾ
            ಸದಾಶಿವಯ್ಯನವರ</strong> ಅಮೃತ ಹಸ್ತದ ಜ್ಯೋತಿ ಬೆಳಗುವಿಕೆಯೊಂದಿಗೆ ಸಮಾಜದ ಪಯಣ ಆರಂಭವಾಯಿತು; ಆ
            ಬೆಳಕು ಇಂದು ಮೂರು ದಶಕಗಳಿಗೂ ಮೀರಿ ಸಹಸ್ರಾರು ಮಹಿಳೆಯರ ಬದುಕಿನಲ್ಲಿ ಮುಂದುವರಿದಿದೆ.
          </p>
        </div>

        <a
          href={ARTICLE_URL}
          class="mt-8 inline-flex items-center gap-2 rounded-full border border-leaf/40 bg-jasmine px-6 py-3 font-ui text-sm font-semibold text-leaf transition-colors duration-200 hover:border-leaf hover:bg-leaf hover:text-milk"
        >
          <span>ಸಂಸ್ಥಾಪಕರ ಬರಹದಲ್ಲಿ ಸಂಪೂರ್ಣ ಸ್ಥಾಪನಾ ಕಥೆ ಓದಿ</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Quick Summary Aside -->
      <aside class="mt-12 self-start border border-ink/10 bg-jasmine p-6 sm:p-8 lg:mt-0">
        <h3 class="font-ui text-xs font-semibold tracking-[0.2em] uppercase text-leaf">
          ಒಂದು ನೋಟದಲ್ಲಿ
        </h3>
        <dl class="mt-6 space-y-5">
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸ್ಥಾಪನೆ ದಿನಾಂಕ
            </dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink">
              12 ಮಾರ್ಚ್ 1993
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸಂಸ್ಥಾಪಕರು
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ರೇಣುಕಾ ಶಿವಾನಂದಪ್ಪ ಹಾಗೂ ಸಮಾನ ಮನಸ್ಕ ಸ್ನೇಹಿತೆಯರು
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸ್ಥಳ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ಶಿವಮೊಗ್ಗ, ಕರ್ನಾಟಕ
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಆದರ್ಶ ಪ್ರೇರಣೆ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ಶರಣೆ ಅಕ್ಕಮಹಾದೇವಿ ಹಾಗೂ ಬಸವಾದಿ ಶರಣರ ಸಮಾನತೆ, ಕಾಯಕ ಮತ್ತು ದಾಸೋಹ ತತ್ವಗಳು
            </dd>
          </div>
          <div class="border-b border-ink/10 pb-3">
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಹೆಸರಿನ ಹಿನ್ನೆಲೆ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              <span lang="kn" class="font-semibold text-leaf">ಕದಳಿ</span> — ಬಾಳೆಗಿಡ (ಆಶ್ರಯ ಮತ್ತು ತಂಪು ನೀಡುವ ನಿಸರ್ಗದ ಸಂಕೇತ) ಹಾಗೂ ಅಕ್ಕಮಹಾದೇವಿ ಐಕ್ಯವಾದ ಪವಿತ್ರ ಕದಳಿ ವನ.
            </dd>
          </div>
          <div>
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸಾರ್ಥಕ ಮೈಲಿಗಲ್ಲು
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ರಜತ ಮಹೋತ್ಸವ (ಬೆಳ್ಳಿ ಹಬ್ಬ) ಪೂರೈಸಿ 35ನೇ ವರ್ಷದತ್ತ ಸಾಗುತ್ತಿರುವ ಹೆಮ್ಮೆಯ ಇತಿಹಾಸ
            </dd>
          </div>
          <div>
            <dt class="font-ui text-xs font-semibold tracking-wide uppercase text-stone">
              ಸದಸ್ಯತ್ವ
            </dt>
            <dd class="mt-1 font-body text-base text-ink">
              ಎಲ್ಲಾ ವರ್ಗದ ಮಹಿಳೆಯರಿಗೂ ಮುಕ್ತ ಸ್ವಾಗತ
            </dd>
          </div>
        </dl>

        <div class="mt-8 pt-4 border-t border-ink/10">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 font-ui text-sm font-semibold text-leaf underline-offset-4 hover:underline"
          >
            <span>ಸಮಾಜದೊಂದಿಗೆ ಸಂಪರ್ಕದಲ್ಲಿರಿ</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <div class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <Beads class="w-40 text-turmeric" />
    </div>
  </div>

  <!-- 2. ಸಮಾಜದ ಧ್ಯೇಯಗಳು — one-line pillar summaries -->
  <section class="bg-jasmine">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="max-w-3xl">
        <p class="font-ui text-xs font-semibold tracking-[0.2em] uppercase text-leaf">
          ಮೂಲ ಸಂಕಲ್ಪ
        </p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">
          ಸಮಾಜದ ಉದ್ದೇಶ ಮತ್ತು ಧ್ಯೇಯಗಳು
        </h2>
        <p class="mt-4 font-body text-lg text-stone">
          ಮಹಿಳೆಯರ ಸರ್ವತೋಮುಖ ಅಭಿವೃದ್ಧಿ — ಈ ಒಂದು ಗುರಿಯುಳ್ಳ ಸಂಕಲ್ಪದ ಮೇಲೆ ಸಮಾಜದ ಎಲ್ಲಾ ಕಾರ್ಯಕ್ರಮಗಳು ನಿಂತಿವೆ.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          OBJECTIVES.map((objective, i) => (
            <div class="border border-ink/10 bg-cream p-6">
              <div class="font-ui text-xs font-semibold text-turmeric">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="mt-2 font-display text-xl font-semibold text-ink">
                <span lang="kn">{objective.title}</span>
              </h3>
              <p class="mt-3 font-body text-base text-stone">
                <span lang="kn">{objective.text}</span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="bg-jasmine">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <Beads class="w-40 text-turmeric" />
    </div>
  </div>

  <!-- 3. ಮೂರು ದಶಕಗಳ ಸಾಧನೆಗಳು — compact milestone grid; photos stay with the article -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="max-w-3xl">
        <p class="font-ui text-xs font-semibold tracking-[0.2em] uppercase text-leaf">
          ಮೂರು ದಶಕಗಳ ಸಾಧನೆಗಳು
        </p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">
          ಪ್ರಮುಖ ಮೈಲಿಗಲ್ಲುಗಳು ಮತ್ತು ಕಾರ್ಯಕ್ರಮಗಳು
        </h2>
        <p class="mt-4 font-body text-lg text-stone">
          ಧ್ಯೇಯಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ಸಮಾಜವು ನಿರಂತರವಾಗಿ ಹಮ್ಮಿಕೊಂಡು ಬಂದ ಪ್ರಮುಖ ಕಾರ್ಯಗಳು.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          MILESTONES.map((milestone) => (
            <div class="flex gap-4 border border-ink/10 bg-milk p-6">
              <span aria-hidden="true" class="mt-2 block h-2.5 w-2.5 shrink-0 rounded-full bg-turmeric" />
              <div>
                <h3 class="font-display text-lg font-semibold text-ink">
                  <span lang="kn">{milestone.title}</span>
                </h3>
                <p class="mt-2 font-body text-base text-stone">
                  <span lang="kn">{milestone.text}</span>
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-10">
        <a
          href={ARTICLE_URL}
          class="inline-flex items-center gap-2 font-ui text-sm font-semibold text-leaf underline-offset-4 hover:underline"
        >
          <span>ಪ್ರತಿಯೊಂದು ಸಾಧನೆಯ ವಿವರವನ್ನು ಸಂಸ್ಥಾಪಕರ ಬರಹದಲ್ಲಿ ಓದಿ</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Founder's words, carried over as a quote -->
      <div class="mt-16 border-t border-ink/10 pt-12">
        <Beads class="mx-auto w-40 text-turmeric" />
        <blockquote class="mx-auto mt-8 max-w-3xl text-center font-display text-xl leading-snug italic text-ink sm:text-2xl">
          “ಹಿಂದಿನ ತಲೆಮಾರಿನವರ ಅನುಭವ ಮತ್ತು ಇಂದಿನ ಪೀಳಿಗೆಯವರ ನವೀನ ಚಿಂತನೆಗಳು ಒಂದಾಗಿ ಸಾಗಿದಾಗ ಮಾತ್ರ ಸಂಸ್ಥೆಯ ಬೆಳವಣಿಗೆ ಇನ್ನಷ್ಟು ಎತ್ತರಕ್ಕೆ ತಲುಪಲು ಸಾಧ್ಯ.”
          <footer class="mt-4 font-ui text-sm font-semibold not-italic text-leaf">
            — ರೇಣುಕಾ ಶಿವಾನಂದಪ್ಪ, ಸಂಸ್ಥಾಪಕರು / ಹಿರಿಯ ಮಾರ್ಗದರ್ಶಕರು
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- 4. ನಮ್ಮ ಕಾರ್ಯಕಾರಿ ಸಮಿತಿ (The Committee) -->
  <CommitteeSection />

  <!-- 5. ಕದಳಿಗೆ ಸೇರಿ (Join Us Banner) -->
  <section class="bg-ink text-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6 sm:py-20">
