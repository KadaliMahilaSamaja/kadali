---
/**
 * ಶುಭೋದ್ಘಾಟನೆ — the ceremony page at /launch (unlinked, noindex, kept out
 * of the sitemap in astro.config.mjs).
 *
 * The committee opens this page on stage, usually from a QR code that
 * carries the key in the URL fragment: https://kadali.org/launch#k=…  The
 * fragment never reaches any server; the script reads it into memory and
 * scrubs it from the address bar immediately. Nothing is ever stored.
 *
 * Deliberately NOT BaseLayout: the ceremony screen must have no header,
 * footer, language-gate dialog, install prompt or service-worker
 * registration — nothing that could pop up mid-ceremony. Its strings also
 * live inline for the same reason (ops tooling, not site chrome;
 * offline.html is the precedent). global.css is imported directly so the
 * design tokens, the bilingual visibility rules and the focus styles still
 * apply, and the brand motifs (KasutiBorder, Mandala, Bloom) dress it
 * like the rest of the brochure.
 *
 * Design (v3): the page enacts the ritual it triggers — ಪುಷ್ಪ ವರ್ಷ, the
 * petal shower elders perform at every inauguration. Entrance: the salu
 * arch draws itself in stroke by stroke and the mandala unfurls behind the
 * disc. Holding: the mandala "wakes" (a slow 3 s turn, released fast —
 * asymmetric timing), the glow breathes and the centre counts 3·2·1 with a
 * heartbeat pop per numeral. On confirmation: the disc pops, a turmeric
 * flare blooms and dissolves, a radial petal burst erupts from the disc,
 * a full-viewport flower shower falls for ~10 s in two depth layers, and
 * the kasuti frame lights turmeric. Everything is transform/opacity via
 * CSS or WAAPI (no animation library — the choreography is one short
 * timeline, and the page stays dependency-free like the rest of the repo),
 * gated behind html.js and reduced-motion-checked in JS so every effect
 * degrades to a calm state change.
 *
 * Design (v4): no ops chrome on stage. The title is ceremonial, the URL
 * pill is gone, and the quiet-tools panel (close-the-curtain chip, key
 * form) stays folded away — it unfolds only when a flip asks for a key.
 * A key carried in by the #k= fragment never surfaces any machinery.
 *
 * Design (v5): a flaky connection reads as silence — the page just keeps
 * checking, never alarming.
 *
 * Design (v6): Akka Mahadevi replaces the arch vector as the header's
 * subtle emblem, and she gathers presence when the gate opens. The
 * connection pill is gone entirely. Every maintainer control lives in the
 * collapsed "ನಿರ್ವಹಣೆ / maintainer" strip at the foot — it only opens
 * when expanded (click), via ops mode (/launch?ops, the "o" key, or five
 * quick taps on the emblem), or when a flip asks for the key. Guests
 * never see any of it.
 *
 * Design (v7): the hold grows the diya glow with the ring until it washes
 * the whole screen at confirm, the celebration dissolves it into the
 * petal burst, and then the stage page opens the homepage itself. The
 * hold duration is set in the maintainer strip (1–10 s, remembered on
 * the device in localStorage — no cookies).
 */
import '../styles/global.css';
import KasutiBorder from '../components/motifs/KasutiBorder.astro';
import Mandala from '../components/motifs/Mandala.astro';
import Bloom from '../components/motifs/Bloom.astro';
---

<!doctype html>
<html lang="kn" data-lang="kn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1d5f3c" />
    <title>ಜಾಲತಾಣದ ಶುಭೋದ್ಘಾಟನೆ · The grand opening — ಕದಳಿ ವನಿತಾ ಸಮಾಜ</title>
    <script is:inline>
      // Pre-paint, same as BaseLayout: mark js capability (the entrance
      // animation only applies when this runs — the page is fully visible
      // without it) and restore the language choice. This page ships both
      // languages too.
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('kadali-lang') === 'en') {
          document.documentElement.dataset.lang = 'en';
          document.documentElement.lang = 'en';
        }
      } catch (e) {
        /* storage unavailable — the Kannada default stands */
      }
    </script>
  </head>
  <body class="min-h-screen bg-cream font-ui text-ink antialiased">
    <!-- The brochure frame: cross-stitch bands top and bottom, like the
         site's footer dividers. Both light turmeric when the gate opens. -->
    <div data-frame class="text-leaf transition-colors duration-1000"><KasutiBorder class="h-4 w-full" /></div>

    <main
      class="relative z-10 mx-auto flex min-h-[calc(100vh-2rem)] w-full max-w-2xl flex-col px-4 py-8 text-center sm:py-10"
    >
      <div class="m-auto flex w-full flex-col items-center">
        <!-- scattered blossoms, the brochure's peach-panel flowers -->
        <Bloom
          class="pointer-events-none absolute -left-7 top-24 h-28 w-28 text-leaf/10 sm:h-36 sm:w-36"
        />
        <Bloom
          class="pointer-events-none absolute -right-5 top-1/2 h-32 w-32 text-turmeric/15 sm:h-44 sm:w-44"
        />
        <Bloom
          class="pointer-events-none absolute -left-6 bottom-20 h-24 w-24 text-turmeric/10 sm:h-32 sm:w-32"
        />
        <Bloom
          class="pointer-events-none absolute -right-4 top-16 h-14 w-14 text-leaf/10 sm:h-20 sm:w-20"
        />

        <header class="stage-rise flex flex-col items-center">
          <!-- Akka Mahadevi, the site's hero saint, as the ceremony's
               emblem — subtle on the cream ground, and she gathers
               presence when the gate opens (see .saint-img). She is also
               the phone's secret ops tap-target (five quick taps). -->
          <div data-saint class="relative flex justify-center" aria-hidden="true">
            <picture>
              <source srcset="/images/akkamahadevi-hero.webp" type="image/webp" />
              <img
                src="/images/akkamahadevi-hero.png"
                alt=""
                width="2048"
                height="1172"
                loading="eager"
                decoding="async"
                class="saint-img w-auto"
              />
            </picture>
          </div>
          <p class="mt-3 text-2xl font-bold tracking-wide text-sindoor sm:text-3xl">
            <span data-kn lang="kn">ಕದಳಿ ವನಿತಾ ಸಮಾಜ</span>
            <span data-en>Kadali Vanita Samaja</span>
          </p>
          <h1 class="stage-h1 mt-1 font-bold">
            <span data-kn lang="kn">ಜಾಲತಾಣದ ಶುಭೋದ್ಘಾಟನೆ</span>
            <span data-en>The grand opening of the website</span>
          </h1>
        </header>

        <!-- The big one: press and hold three seconds. The button is a
             mandala disc on purpose — dotted rim, bud dots echoing the
             favicon — and a hold gesture cannot be triggered by a stray tap
             on stage. While holding, a turmeric glow breathes behind the
             disc, the mandala behind wakes up with a slow turn, and the
             centre counts 3·2·1 with the filling ring. -->
        <div
          data-launch-wrap
          class="stage-rise mt-10 flex w-full flex-col items-center"
          style="--rise-delay: 120ms"
        >
          <div
            data-launch-stage
            class="launch-stage relative flex w-full items-center justify-center"
          >
            <!-- wrapper carries the hold "wake-up" transform; the svg inside
                 carries its own entrance unfurl (separate elements so the
                 finished entrance animation never locks the wake transform) -->
            <span
              class="stage-mandala-wrap pointer-events-none absolute inset-0 flex items-center justify-center text-leaf/[0.08]"
              aria-hidden="true"
            >
              <Mandala class="stage-mandala h-full w-full" />
            </span>
            <button
              data-launch
              type="button"
              class="launch-btn relative z-10 grid place-items-center rounded-full bg-leaf text-milk shadow-photo disabled:cursor-not-allowed disabled:opacity-70"
            >
              <svg class="absolute inset-0 h-full w-full" viewBox="0 0 240 240" aria-hidden="true">
                <!-- dotted rim, slowly turning -->
                <circle
                  class="rim-spin"
                  cx="120"
                  cy="120"
                  r="114"
                  fill="none"
                  stroke="rgb(255 253 247 / 0.4)"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-dasharray="0.2 10"></circle>
                <!-- quiet inner stitch ring -->
                <circle
                  cx="120"
                  cy="120"
                  r="80"
                  fill="none"
                  stroke="rgb(255 253 247 / 0.28)"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-dasharray="1 8"></circle>
                <!-- hold-progress track + ring -->
                <circle
                  cx="120"
                  cy="120"
                  r="98"
                  fill="none"
                  stroke="rgb(255 253 247 / 0.25)"
                  stroke-width="6"
                  transform="rotate(-90 120 120)"></circle>
                <circle
                  data-ring
                  cx="120"
                  cy="120"
                  r="98"
                  fill="none"
                  stroke="#E8862E"
                  stroke-width="6"
                  stroke-linecap="round"
                  stroke-dasharray="615.75"
                  stroke-dashoffset="615.75"
                  transform="rotate(-90 120 120)"></circle>
                <!-- the bud mark's dots, set into the disc -->
                <circle cx="120" cy="64" r="3.5" fill="rgb(255 253 247 / 0.85)"></circle>
                <circle cx="165" cy="92" r="3.5" fill="rgb(255 253 247 / 0.85)"></circle>
                <circle cx="165" cy="148" r="3.5" fill="rgb(255 253 247 / 0.85)"></circle>
                <circle cx="120" cy="176" r="3.5" fill="rgb(255 253 247 / 0.85)"></circle>
                <circle cx="75" cy="148" r="3.5" fill="rgb(255 253 247 / 0.85)"></circle>
                <circle cx="75" cy="92" r="3.5" fill="rgb(255 253 247 / 0.85)"></circle>
              </svg>
              <span data-btn-label class="relative px-8 text-2xl font-bold leading-snug sm:text-3xl">
                <span data-kn lang="kn">ತೆರೆಯಿರಿ</span>
                <span data-en>Open<br />the site</span>
              </span>
              <!-- the hold countdown — inline display style, toggled by the
                   script; numerals are shared by both languages -->
              <span
                data-btn-count
                aria-hidden="true"
                class="absolute inset-0 grid place-items-center font-display text-6xl font-bold"
                style="display: none">3</span>
            </button>
            <!-- the diya glow: a solid turmeric core with a feathered edge —
                 the hold grows it (16×) until it engulfs the page and the
                 other content disappears under it, while the disc floats
                 above on the turmeric sea -->
            <div
              data-glow
              class="glow pointer-events-none absolute h-80 w-80 rounded-full"
              aria-hidden="true"
            ></div>
          </div>
          <p class="mt-3 text-base font-medium text-stone">
            <span data-kn lang="kn">ಒತ್ತಿ ಹಿಡಿಯಿರಿ — <span data-hold-secs>3</span> ಸೆಕೆಂಡು</span>
            <span data-en>Press and hold — <span data-hold-secs>3</span> seconds</span>
          </p>
          <p
            data-message
            aria-live="assertive"
            class="mx-auto mt-4 hidden max-w-md border px-4 py-2.5 text-sm font-semibold leading-relaxed"
          ></p>
        </div>

        <div data-open-wrap class="hidden">
          <div class="mt-2 flex flex-col items-center">
            <div class="open-rise flex items-center gap-3 text-turmeric" aria-hidden="true">
              <Bloom class="h-4 w-4 text-turmeric/70" />
              <Bloom class="h-6 w-6" />
              <Bloom class="h-4 w-4 text-turmeric/70" />
            </div>
            <a
              href="/"
              class="open-rise mt-5 inline-flex items-center gap-3 bg-leaf px-8 py-4 text-lg font-bold text-milk shadow-photo transition duration-150 hover:bg-ink active:scale-[0.98]"
              style="--rise-delay: 90ms"
            >
              <span data-kn lang="kn">ತೆರೆದ ತಾಣಕ್ಕೆ ಹೋಗಿ</span>
              <span data-en>Visit the opened site</span>
              <span aria-hidden="true">⟶</span>
            </a>
            <p
              class="open-rise mt-3 max-w-sm text-sm leading-relaxed text-stone"
              style="--rise-delay: 180ms"
            >
              <span data-kn lang="kn">ಎಲ್ಲರ ಪರದೆಯೂ ಸ್ವಲ್ಪ ಹೊತ್ತಿನಲ್ಲಿ ತಾನೇ ತೆರೆದುಕೊಳ್ಳುತ್ತದೆ</span>
              <span data-en>Every curtain tab opens itself within seconds</span>
            </p>
          </div>
        </div>

        <!-- maintainer tools: a quiet collapsible, collapsed by default —
             the ceremony never shows machinery. It opens only when the
             strip is clicked, ops mode is on (/launch?ops, the "o" key,
             five taps on the emblem), or a flip asks for the key. -->
        <section class="stage-rise mt-12 w-full max-w-lg" style="--rise-delay: 180ms">
          <details data-tools class="mx-auto w-full max-w-md">
            <summary
              class="flex list-none cursor-pointer items-center justify-center gap-2 py-2 text-xs font-semibold tracking-[0.18em] text-stone/60 transition-colors duration-150 hover:text-stone"
            >
              <span data-kn lang="kn">ನಿರ್ವಹಣೆ</span>
              <span data-en>maintainer</span>
              <span class="chev" aria-hidden="true">▾</span>
            </summary>
            <div class="mt-4 border border-ink/10 bg-milk/80 px-5 py-6">
              <!-- the gate status lives here, on the control side — the
                   ceremony stage above stays free of diagnostics -->
              <p
                data-ctrl-status
                data-state="checking"
                aria-live="polite"
                class="flex items-center justify-center gap-2.5 text-sm font-semibold text-stone"
              >
                <span class="ctrl-dot" aria-hidden="true"></span>
                <span data-ctrl-text>
                  <span data-kn lang="kn">ತಪಾಸಣೆ ನಡೆಯುತ್ತಿದೆ…</span>
                  <span data-en>Checking the gate…</span>
                </span>
              </p>
              <p data-ctrl-since class="mt-1 hidden text-center text-xs text-stone/80"></p>
              <p
                data-warn
                class="hidden mt-4 w-full border border-sindoor bg-milk px-4 py-2.5 text-left text-sm leading-relaxed text-sindoor"
              ></p>
              <div class="mt-4 flex flex-wrap items-center justify-center">
                <button
                  data-reset
                  type="button"
                  class="hold-chip border-2 border-leaf px-5 py-2.5 text-sm font-semibold text-leaf transition-colors hover:bg-leaf hover:text-milk disabled:cursor-not-allowed disabled:opacity-60"
                >
                  <span data-kn lang="kn">ಪರದೆ ಮುಚ್ಚಿ · ಒತ್ತಿ ಹಿಡಿಯಿರಿ</span>
                  <span data-en>Close the curtain · press and hold</span>
                </button>
              </div>
              <form data-key-form class="hidden mt-5 border-t border-ink/10 pt-5">
                <div class="flex flex-wrap items-center justify-center gap-2.5">
                  <label class="text-sm font-semibold text-stone" for="launch-key">
                    <span data-kn lang="kn">ಕೀ:</span>
                    <span data-en>Key:</span>
                  </label>
                  <input
                    data-key-input
                    id="launch-key"
                    type="password"
                    autocomplete="off"
                    spellcheck="false"
                    class="w-44 border border-ink/20 bg-milk px-3 py-2 text-sm tracking-wider sm:w-52"
                  />
                  <button
                    type="submit"
                    class="bg-leaf px-4 py-2 text-sm font-semibold text-milk transition duration-150 hover:bg-ink active:scale-[0.97]"
                  >
                    <span data-kn lang="kn">ಉಳಿಸಿ</span>
                    <span data-en>Save</span>
                  </button>
                </div>
              </form>
              <p data-key-ok class="mt-4 hidden text-center text-sm text-stone"></p>
              <!-- how long the big button must be held — a stage-device
                   setting, remembered in this browser's localStorage -->
              <div class="mt-5 flex flex-wrap items-center justify-center gap-2.5 border-t border-ink/10 pt-5">
                <label class="text-sm font-semibold text-stone" for="hold-secs">
                  <span data-kn lang="kn">ಒತ್ತುವ ಸೆಕೆಂಡು:</span>
                  <span data-en>Hold seconds:</span>
                </label>
                <input
                  data-hold-input
                  id="hold-secs"
                  type="number"
                  min="1"
                  max="10"
                  step="1"
                  value="3"
                  class="w-16 border border-ink/20 bg-milk px-2 py-2 text-center text-sm"
                />
              </div>
            </div>
          </details>
        </section>
      </div>
    </main>

    <div data-frame class="text-leaf transition-colors duration-1000"><KasutiBorder class="h-4 w-full" /></div>

    <!-- Celebration layer: a radial petal burst from the disc, populated
         by the script at runtime; pointer-events-none and self-cleaning.
         (The flower shower itself falls on the opened site — see
         BaseLayout and ?celebrate=1.) -->
    <div
      data-burst
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-10 grid place-items-center"
    ></div>
  </body>
</html>

<style>
  /* Page-only styles; everything else rides on tokens + Tailwind. */

  /* Entrance: rise once, staggered via --rise-delay. Gated behind html.js
     (set pre-paint in the head), so without scripting the page simply
     shows; the global reduced-motion rules zero the duration, and the
     explicit block below also drops the delay. */
  html.js .stage-rise {
    animation: stage-in 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--rise-delay, 0ms);
  }
  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The reveal of the opened-site block staggers in the same voice whenever
     the wrap is unhidden (first launch, and again after every rehearsal). */
  html.js .open-rise {
    animation: stage-in 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--rise-delay, 0ms);
  }

  /* ——— the ritual's scale ———
     Sizes live here (not in Tailwind utilities) so the page can tune them
     per viewport: phones get the compact ceremony, tablets a larger one,
     and a tablet in landscape compacts the header so the whole ritual —
     emblem, word, disc — fits one unscrollable stage. Kannada headings
     keep line-height 1.3 for conjunct clearance (global.css rule). */
  .saint-img {
    height: 9rem;
    opacity: 0.4;
    transition: opacity 1400ms ease;
  }
  [data-saint].gate-open .saint-img {
    opacity: 0.6;
  }
  .stage-h1 {
    font-size: 3rem;
    line-height: 1.3;
  }
  .launch-stage {
    height: 20rem;
  }
  .launch-btn {
    width: 15rem;
    height: 15rem;
  }
  @media (min-width: 48rem) {
    .saint-img {
      height: 11rem;
    }
    .stage-h1 {
      font-size: 3.375rem;
    }
    .launch-stage {
      height: 23rem;
    }
    .launch-btn {
      width: 18rem;
      height: 18rem;
    }
  }
  /* landscape tablets and laptop-height windows (≤960px tall): the
     ceremony must fit one viewport — compact the header, keep the disc
     generous */
  @media (orientation: landscape) and (max-height: 60rem) {
    .saint-img {
      height: 7.5rem;
    }
    .stage-h1 {
      font-size: 2.6rem;
      margin-top: 0.25rem;
    }
    .launch-stage {
      height: 17rem;
    }
    .launch-btn {
      width: 15rem;
      height: 15rem;
    }
  }

  /* the collapsible maintainer strip: no native marker, the chevron turns */
  [data-tools] summary {
    list-style: none;
  }
  [data-tools] summary::-webkit-details-marker {
    display: none;
  }
  .chev {
    display: inline-block;
    transition: transform 200ms ease;
  }
  [data-tools][open] .chev {
    transform: rotate(180deg);
  }

  /* the control-side status line: a small dot speaking in tones —
     turmeric while checking, turmeric steady for closed, leaf for open,
     quiet stone when the connection is slow */
  .ctrl-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    background: var(--color-stone);
    transition: background-color 300ms ease;
  }
  [data-ctrl-status][data-state='checking'] .ctrl-dot {
    background: var(--color-turmeric);
    animation: dot-breathe 1.2s ease-in-out infinite;
  }
  [data-ctrl-status][data-state='closed'] .ctrl-dot {
    background: var(--color-turmeric);
  }
  [data-ctrl-status][data-state='open'] .ctrl-dot {
    background: var(--color-leaf);
  }
  [data-ctrl-status][data-state='down'] .ctrl-dot {
    background: var(--color-stone);
  }
  @keyframes dot-breathe {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  /* The mandala unfurls once on entrance (the svg); the hold "wake-up"
     turn is a transition on its wrapper, so the two never fight. Release
     is deliberately faster than the press — slow where the guest is
     deciding, snappy where the system responds. */
  .stage-mandala-wrap {
    transition: transform 700ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .launch-stage.awake .stage-mandala-wrap {
    transform: rotate(22deg) scale(1.05);
    transition: transform 3s linear;
  }

  /* The message box speaks in tones: errors sindoor, successes leaf,
     rehearsal notes quiet stone. (The old version showed "the website is
     open!" in error-red.) */
  [data-message] {
    background: var(--color-milk);
  }
  [data-message][data-tone='error'] {
    border-color: rgb(192 58 43 / 0.35);
    color: var(--color-sindoor);
  }
  [data-message][data-tone='ok'] {
    border-color: rgb(29 95 60 / 0.4);
    color: var(--color-leaf);
  }
  [data-message][data-tone='quiet'] {
    border-color: rgb(32 40 31 / 0.14);
    color: var(--color-stone);
  }

  .launch-btn {
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .launch-btn.holding {
    transform: scale(0.965);
  }
  .hold-chip {
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .hold-chip.holding {
    transform: scale(0.97);
  }

  /* the diya glow behind the disc: a solid turmeric core with a feathered
     edge — no blur filter, so growing it to 16× stays cheap on tablets.
     The hold raises its opacity and scale together; the content outside
     the disc disappears under the wash long before the ring completes. */
  .glow {
    opacity: 0;
    /* above every animated sibling (their filled entrance animations give
       them stacking contexts) so the wash truly swallows the page — but
       below the disc (button z-10), which floats on the turmeric sea */
    z-index: 1;
    background: radial-gradient(
      circle closest-side,
      var(--color-turmeric) 0%,
      var(--color-turmeric) 62%,
      rgb(232 134 46 / 0) 74%
    );
    transition:
      opacity 350ms ease,
      transform 300ms linear;
  }
  .launch-btn.holding ~ .glow {
    opacity: 1;
  }

  .rim-spin {
    animation: rim-spin 90s linear infinite;
    transform-origin: 120px 120px;
  }
  @keyframes rim-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-rise,
    .open-rise {
      animation: none;
    }
    .launch-stage.awake .stage-mandala-wrap {
      transform: none;
      transition: none;
    }
    .launch-btn.holding,
    .hold-chip.holding {
      transform: none;
    }
    .glow,
    .launch-btn.holding ~ .glow {
      transition: none;
    }
    .rim-spin {
      animation: none;
    }
    .saint-img,
    .chev {
      transition: none;
    }
    [data-ctrl-status][data-state='checking'] .ctrl-dot {
      animation: none;
    }
  }
</style>

<!-- Rules the scoped block cannot express: the petals and drops are created
     by the script at runtime (no template scope attribute to match), and
     the mandala svg belongs to its own component. Astro would rewrite these
     selectors with a scope attribute they never carry — the original petal
     burst carried the same is:global requirement, and losing it turns every
     drop into a viewport-sized unstyled span. -->
<style is:global>
  html.js .stage-mandala {
    animation: mandala-in 1200ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 120ms;
  }
  @keyframes mandala-in {
    from {
      opacity: 0;
      transform: scale(0.9) rotate(-14deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The runtime celebration shapes (.petal / .drop) and their reduced-
     motion rules live in global.css — they are shared with the opened
     site's ?celebrate=1 shower. */

  @media (prefers-reduced-motion: reduce) {
    .stage-mandala {
      animation: none;
    }
  }
</style>

<script>
  // Ceremony logic: poll the gate, hold-to-confirm (with a live countdown),
  // flip the flag — then celebrate like an inauguration. The key lives in
  // this tab's memory only; the runbook (docs/launch-gate.md) describes the
  // full flow. Plain JavaScript — the Astro compiler parses page scripts as
  // JS, so no TypeScript syntax here.
  import { burstPetals } from '../lib/petal-shower.js';

  const lang = document.documentElement.dataset.lang === 'en' ? 'en' : 'kn';
  const t = (pair) => pair[lang];

  const STATE = {
    unknown: { kn: 'ತಪಾಸಣೆ ನಡೆಯುತ್ತಿದೆ…', en: 'Checking the gate…' },
    down: { kn: 'ಸಂಪರ್ಕ ಕಾಯುತ್ತಿದೆ…', en: 'Still reaching the gate…' },
    closed: { kn: 'ಪರದೆ ಮುಚ್ಚಿದೆ', en: 'Curtain closed' },
    open: { kn: 'ತೆರೆದಿದೆ!', en: 'It is open!' },
  };
  const SINCE = { kn: 'ತೆರೆದದ್ದು:', en: 'Opened at:' };
  const WARN = {
    notArmed: {
      kn: 'ಗೇಟ್ ಸಜ್ಜಾಗಿಲ್ಲ — Cloudflare Pages ಪ್ರಾಜೆಕ್ಟಿನಲ್ಲಿ LAUNCH_KV ಹೆಸರಿನ KV ಬೈಂಡಿಂಗ್ ಸೇರಿಸಿ, ಆಮೇಲೆ ಒಂದು ಸಲ ಪುನಃ ನಿಯೋಜಿಸಿ (docs/launch-gate.md).',
      en: 'The gate is not armed — add a KV binding named LAUNCH_KV to the Cloudflare Pages project, then redeploy once (docs/launch-gate.md).',
    },
  };
  const MSG = {
    needKey: {
      kn: 'ಕೀ ಬೇಕು — ಕೆಳಗೆ ನಮೂದಿಸಿ.',
      en: 'A key is needed — enter it below.',
    },
    badKey: {
      kn: 'ಕೀ ಒಪ್ಪಲಿಲ್ಲ — ಪುನಃ ಪರಿಶೀಲಿಸಿ.',
      en: 'The key was not accepted — double-check it.',
    },
    notConfigured: {
      kn: 'ಸರ್ವರಿನಲ್ಲಿ LAUNCH_KEY ಸಿದ್ಧವಾಗಿಲ್ಲ — ಮೊದಲು ಗುಪ್ತಪದ ಸೇರಿಸಿ (docs/launch-gate.md).',
      en: 'LAUNCH_KEY is not set on the server — configure the secret first (docs/launch-gate.md).',
    },
    netError: {
      kn: 'ಜಾಲಬಂಧದ ತೊಂದರೆ — ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.',
      en: 'Network trouble — please try again.',
    },
    serverError: {
      kn: 'ತಾಂತ್ರಿಕ ಅಡಚಣೆ — ಸ್ವಲ್ಪ ಕಾದು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.',
      en: 'A technical hiccup — wait a moment and try again.',
    },
    launched: { kn: 'ಜಾಲತಾಣ ತೆರೆದಿದೆ!', en: 'The website is open!' },
    closedAgain: { kn: 'ಪರದೆ ಮತ್ತೆ ಮುಚ್ಚಿದೆ.', en: 'The curtain is closed again.' },
  };
  const KEY_SAVED = {
    kn: 'ಕೀ ಇಡಲಾಗಿದೆ ✓ (ಈ ಟ್ಯಾಬಿನ ಮೆಮೊರಿಯಲ್ಲಿ ಮಾತ್ರ)',
    en: 'Key set ✓ (in this tab’s memory only)',
  };

  /* ——— motion helpers ———
     WAAPI gives JS-choreographed animation with CSS performance. It does
     NOT inherit the global reduced-motion CSS zeroing, so every call goes
     through motion(), which no-ops when the guest prefers reduced motion.
     The ceremony still communicates: state changes, colours and text flip
     instantly instead. */
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE_OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const motion = (el, frames, opts) => {
    if (REDUCED || !el || !el.animate) return null;
    return el.animate(frames, opts);
  };
  const sleep = (ms) => new Promise((r) => window.setTimeout(r, ms));

  /* ——— the key: URL fragment → memory, scrubbed from the bar at once ——— */
  let key = '';
  const hashMatch = /^#(?:k|key)=(.+)$/.exec(location.hash);
  if (hashMatch) {
    try {
      key = decodeURIComponent(hashMatch[1]).trim();
    } catch (e) {
      key = hashMatch[1].trim();
    }
    history.replaceState(null, '', location.pathname + location.search);
  }

  const warnEl = document.querySelector('[data-warn]');
  const launchWrap = document.querySelector('[data-launch-wrap]');
  const openWrap = document.querySelector('[data-open-wrap]');
  const launchBtn = document.querySelector('[data-launch]');
  const resetBtn = document.querySelector('[data-reset]');
  const messageEl = document.querySelector('[data-message]');
  const keyForm = document.querySelector('[data-key-form]');
  const keyInput = document.querySelector('[data-key-input]');
  const keyOkEl = document.querySelector('[data-key-ok]');
  const toolsEl = document.querySelector('[data-tools]');
  const saintEl = document.querySelector('[data-saint]');
  const ctrlStatusEl = document.querySelector('[data-ctrl-status]');
  const ctrlTextEl = document.querySelector('[data-ctrl-text]');
  const ctrlSinceEl = document.querySelector('[data-ctrl-since]');
  const burstEl = document.querySelector('[data-burst]');
  const glowEl = document.querySelector('[data-glow]');
  const stageEl = document.querySelector('[data-launch-stage]');
  const ring = document.querySelector('[data-ring]');
  const btnLabel = document.querySelector('[data-btn-label]');
  const btnCount = document.querySelector('[data-btn-count]');
  const RING_C = 615.75;

  const show = (el, on) => {
    if (el) el.classList.toggle('hidden', !on);
  };

  function showMsg(pair, tone) {
    if (!messageEl) return;
    messageEl.textContent = t(pair);
    messageEl.dataset.tone = tone || 'error';
    show(messageEl, true);
    motion(
      messageEl,
      [
        { opacity: 0, transform: 'translateY(6px)' },
        { opacity: 1, transform: 'none' },
      ],
      { duration: 200, easing: EASE_OUT },
    );
  }

  /* the kasuti frame joins the celebration: stitch bands turn turmeric */
  function frameLight(on) {
    document.querySelectorAll('[data-frame]').forEach((el) => {
      el.style.color = on ? 'var(--color-turmeric)' : '';
    });
  }

  let lastGate = null;
  /* the gate status speaks only inside the maintainer strip — the stage
     above stays pure. A slow connection is just "still reaching…", and
     it lives on the control side, where it is useful. */
  function renderStatus(state, pair) {
    if (!ctrlStatusEl || !ctrlTextEl) return;
    ctrlStatusEl.dataset.state = state;
    ctrlTextEl.textContent = t(pair);
  }
  function formatSince(iso) {
    try {
      return new Date(iso).toLocaleTimeString(lang === 'en' ? 'en-IN' : 'kn-IN', {
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch (e) {
      return iso;
    }
  }
  function render(gate) {
    if (!gate) {
      // a flaky hall network changes nothing on stage — the page just
      // keeps quietly checking (two misses in a row even get here)
      lastGate = null;
      frameLight(false);
      renderStatus('down', STATE.down);
      renderChrome();
      return;
    }
    lastGate = gate;
    frameLight(gate.open);
    renderStatus(gate.open ? 'open' : 'closed', gate.open ? STATE.open : STATE.closed);
    show(launchWrap, !gate.open);
    show(openWrap, gate.open);
    if (saintEl) saintEl.classList.toggle('gate-open', gate.open);
    renderChrome();
  }

  /* ——— the collapsible maintainer strip ———
     A collapsed "ನಿರ್ವಹಣೆ / maintainer" line at the foot; the ceremony
     never shows machinery. It opens only when expanded — by click, by ops
     mode, or by a flip that needs the key. */
  function syncKeyRow() {
    if (key) {
      if (keyOkEl) keyOkEl.textContent = t(KEY_SAVED);
      show(keyOkEl, true);
      show(keyForm, false);
    } else {
      show(keyForm, true);
      show(keyOkEl, false);
    }
  }
  function openTools(on) {
    if (!toolsEl) return;
    toolsEl.open = on;
    if (on) syncKeyRow();
  }
  function foldKeyTools() {
    if (keyInput) keyInput.value = '';
    openTools(false);
  }

  /* ——— ops mode: the maintainer's quiet switch ———
     /launch?ops (or #ops), the "o" key, or five quick taps on the emblem
     all expand the maintainer strip. The strip itself already hides the
     controls from guests, so ops mode is pure convenience — it never
     persists; a fresh load is ceremony-clean. */
  let opsMode = /ops/.test(location.search + location.hash);
  function renderChrome() {
    if (ctrlSinceEl) {
      if (lastGate && lastGate.open && lastGate.since) {
        ctrlSinceEl.textContent = t(SINCE) + ' ' + formatSince(lastGate.since);
        show(ctrlSinceEl, true);
      } else {
        show(ctrlSinceEl, false);
      }
    }
    if (warnEl) {
      // not armed = the Worker is failing open (site open anyway) — a
      // diagnostic for the maintainer, inside the collapsed strip
      const on = !!(lastGate && !lastGate.armed);
      if (on) warnEl.textContent = t(WARN.notArmed);
      show(warnEl, on);
    }
  }
  function setOps(on) {
    opsMode = on;
    openTools(on);
  }
  window.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    if (e.key === 'o' || e.key === 'O') setOps(!opsMode);
  });
  // on a phone there is no keyboard: five quick taps on the emblem
  let taps = 0;
  let tapTimer = 0;
  if (saintEl) {
    saintEl.addEventListener('click', () => {
      taps += 1;
      window.clearTimeout(tapTimer);
      tapTimer = window.setTimeout(() => {
        taps = 0;
      }, 1600);
      if (taps >= 5) {
        taps = 0;
        setOps(!opsMode);
      }
    });
  }
  // expanding by hand shows the right key row for the current memory
  if (toolsEl) {
    toolsEl.addEventListener('toggle', () => {
      if (toolsEl.open) syncKeyRow();
    });
  }
  if (opsMode) openTools(true);

  /* ——— status polling ——— */
  let failures = 0;
  async function poll() {
    try {
      const res = await fetch('/api/launch-status', { cache: 'no-store' });
      if (!res.ok) throw new Error('bad status');
      const gate = await res.json();
      failures = 0;
      render(gate);
    } catch (e) {
      failures += 1;
      // One failed poll (lift edge, flaky hall wi-fi) must not disturb the
      // stage — call it down only after two in a row, and the stage doesn't
      // even change then.
      if (failures >= 2) render(null);
    }
  }
  poll();
  window.setInterval(poll, 2000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) poll();
  });

  /* ——— hold-to-confirm ———
     Three drivers, so the confirm never depends on one mechanism: rAF for a
     smooth ring, a short interval as watchdog, and one authoritative timeout
     that fires even in renderers that throttle rAF and intervals. The big
     button also counts 3·2·1 in its centre while the ring fills, each
     numeral landing with a heartbeat pop. */
  function holdToConfirm(btn, opts) {
    let raf = 0;
    let watchdog = 0;
    let confirmer = 0;
    let start = 0;
    let lastShown = 0;
    let holding = false;
    let confirmed = false;

    const resetRing = () => {
      if (opts.ring && opts.circumference) {
        opts.ring.style.strokeDashoffset = String(opts.circumference);
      }
    };
    const setCount = (n) => {
      if (!opts.count) return;
      if (n == null) {
        opts.count.style.display = 'none';
        if (opts.label) opts.label.style.display = '';
      } else {
        const isNew = opts.count.textContent !== String(n);
        opts.count.textContent = String(n);
        opts.count.style.display = 'grid';
        if (opts.label) opts.label.style.display = 'none';
        if (isNew) {
          motion(
            opts.count,
            [
              { transform: 'scale(1.3)', opacity: 0.4 },
              { transform: 'scale(1)', opacity: 1 },
            ],
            { duration: 170, easing: EASE_OUT },
          );
        }
      }
    };
    const finish = () => {
      holding = false;
      confirmed = true;
      cancelAnimationFrame(raf);
      clearInterval(watchdog);
      clearTimeout(confirmer);
      btn.classList.remove('holding');
      resetRing();
      setCount(null);
      if (opts.onEnd) opts.onEnd();
      opts.onConfirm();
    };
    const stop = (released) => {
      if (!holding || confirmed) return;
      holding = false;
      cancelAnimationFrame(raf);
      clearInterval(watchdog);
      clearTimeout(confirmer);
      btn.classList.remove('holding');
      resetRing();
      setCount(null);
      if (opts.onReset) opts.onReset();
      if (opts.onEnd) opts.onEnd();
      if (released && opts.onShortRelease) {
        const held = performance.now() - start;
        if (held > 200 && held < opts.ms) opts.onShortRelease();
      }
    };
    const tick = () => {
      if (!holding || confirmed) return;
      const elapsed = performance.now() - start;
      const progress = Math.min(1, elapsed / opts.ms);
      if (opts.ring && opts.circumference) {
        opts.ring.style.strokeDashoffset = String(opts.circumference * (1 - progress));
      }
      if (opts.onProgress) opts.onProgress(progress);
      if (opts.count) {
        const remaining = Math.ceil((opts.ms - elapsed) / 1000);
        if (remaining > 0 && remaining !== lastShown) {
          lastShown = remaining;
          setCount(remaining);
        }
      }
      if (progress >= 1) finish();
    };
    const begin = (e) => {
      if (btn.disabled || holding) return;
      e.preventDefault();
      try {
        if (typeof e.pointerId === 'number') btn.setPointerCapture(e.pointerId);
      } catch (err) {
        /* capture is best-effort; the window handler below still catches it */
      }
      confirmed = false;
      holding = true;
      start = performance.now();
      lastShown = 0;
      btn.classList.add('holding');
      if (opts.onBegin) opts.onBegin();
      if (opts.onProgress) opts.onProgress(0);
      if (opts.count) setCount(Math.round(opts.ms / 1000));
      raf = requestAnimationFrame(tick);
      watchdog = setInterval(tick, 60);
      confirmer = setTimeout(() => {
        if (holding && !confirmed) finish();
      }, opts.ms + 120);
    };

    btn.addEventListener('pointerdown', begin);
    btn.addEventListener('pointerup', () => stop(true));
    btn.addEventListener('pointercancel', () => stop(true));
    // Safety net: a pointer released outside the button (capture failed) —
    // no-op when nothing is being held.
    window.addEventListener('pointerup', () => stop(true), { passive: true });
    btn.addEventListener('keydown', (e) => {
      if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) begin(e);
    });
    btn.addEventListener('keyup', (e) => {
      if (e.key === ' ' || e.key === 'Enter') stop(true);
    });
    btn.addEventListener('contextmenu', (e) => e.preventDefault());
  }

  /* ——— the flips ——— */
  let busy = false;
  function setBusy(on) {
    busy = on;
    if (launchBtn) launchBtn.disabled = on;
    if (resetBtn) resetBtn.disabled = on;
  }

  async function flip(path) {
    if (busy) return;
    if (!key) {
      showMsg(MSG.needKey);
      openTools(true);
      if (keyInput) keyInput.focus();
      return;
    }
    setBusy(true);
    try {
      const res = await fetch(path, {
        method: 'POST',
        headers: { 'x-launch-key': key },
        cache: 'no-store',
      });
      if (res.status === 404) {
        // the key in memory is wrong: unfold the strip so it can be retyped
        showMsg(MSG.badKey);
        openTools(true);
        if (keyInput) keyInput.focus();
      } else if (res.status === 503) {
        let error = '';
        try {
          error = (await res.json()).error || '';
        } catch (e) {
          /* body optional */
        }
        showMsg(error === 'not-configured' ? MSG.notConfigured : WARN.notArmed);
      } else if (!res.ok) {
        showMsg(MSG.serverError);
      } else if (path === '/api/launch') {
        // celebrate first — pop, flare, burst — then hand the stage over
        // to the real site: the homepage opens itself and rains petals
        // over itself (?celebrate=1). Back returns to this console.
        showMsg(MSG.launched, 'ok');
        foldKeyTools();
        celebrate();
        await sleep(REDUCED ? 500 : 1400);
        window.location.assign(REDUCED ? '/' : '/?celebrate=1');
      } else {
        showMsg(MSG.closedAgain, 'quiet');
        foldKeyTools();
        await poll();
      }
    } catch (e) {
      showMsg(MSG.netError);
    }
    setBusy(false);
  }

  /* ——— the celebration ———
     ಪುಷ್ಪ ವರ್ಷ: the disc pops, the turmeric wash blooms and dissolves,
     and a radial burst of petals erupts from the disc (petal art lives in
     src/lib/petal-shower.js, shared with the opened site). The full
     flower shower belongs to the destination: the ceremony page hands
     over to the homepage with ?celebrate=1 and the petals rain there. */
  function celebrate() {
    frameLight(true);
    if (REDUCED) {
      clearGlow(); // state changes above still tell the story
      return;
    }
    // 1 — the disc pops
    motion(
      launchBtn,
      [
        { transform: 'scale(0.965)' },
        { transform: 'scale(1.06)', offset: 0.35 },
        { transform: 'scale(1)' },
      ],
      { duration: 480, easing: EASE_OUT },
    );
    // 2 — the diya flare: the wash is already full-screen from the hold —
    // bloom it a little wider, dissolve it into the petal burst, clear it
    const from = Math.max(glowScale, 1);
    motion(
      glowEl,
      [
        { opacity: 1, transform: 'scale(' + from + ')' },
        { opacity: 0.9, transform: 'scale(' + from * 1.12 + ')', offset: 0.45 },
        { opacity: 0, transform: 'scale(' + from * 1.3 + ')' },
      ],
      { duration: 1100, easing: 'ease-out' },
    );
    window.setTimeout(clearGlow, 1150);
    burstPetals(burstEl);
  }

  /* ——— the hold duration, set from the maintainer panel ———
     Remembered per device in localStorage (no cookies, per the privacy
     policy); the guest's device keeps its own value. opts objects are
     read live on every tick, so editing launchHold.ms mid-session just
     works. */
  const launchHold = {
    ms: 3000,
    ring: ring,
    circumference: RING_C,
    count: btnCount,
    label: btnLabel,
    onBegin: () => stageEl && stageEl.classList.add('awake'),
    onProgress: (p) => setGlowProgress(p),
    onReset: () => clearGlow(),
    onEnd: () => stageEl && stageEl.classList.remove('awake'),
    onShortRelease: () =>
      showMsg(
        {
          kn: 'ಒತ್ತಿ ಹಿಡಿಯಬೇಕು — ' + holdSecs + ' ಸೆಕೆಂಡು.',
          en: 'You have to hold it — for ' + holdSecs + ' seconds.',
        },
        'quiet',
      ),
    onConfirm: () => flip('/api/launch'),
  };
  let holdSecs = 3;
  try {
    const saved = parseInt(localStorage.getItem('kadali-hold-secs') || '', 10);
    if (saved >= 1 && saved <= 10) holdSecs = saved;
  } catch (e) {
    /* storage unavailable — the three-second default stands */
  }
  launchHold.ms = holdSecs * 1000;
  const holdInput = document.querySelector('[data-hold-input]');
  function renderHoldSecs() {
    document.querySelectorAll('[data-hold-secs]').forEach((el) => {
      el.textContent = String(holdSecs);
    });
    if (holdInput) holdInput.value = String(holdSecs);
  }
  if (holdInput) {
    holdInput.addEventListener('change', () => {
      const v = parseInt(holdInput.value, 10);
      if (isNaN(v)) return;
      holdSecs = Math.min(10, Math.max(1, v));
      launchHold.ms = holdSecs * 1000;
      try {
        localStorage.setItem('kadali-hold-secs', String(holdSecs));
      } catch (e) {
        /* fine — this device just forgets it */
      }
      renderHoldSecs();
    });
  }
  renderHoldSecs();
  holdToConfirm(launchBtn, launchHold);
  holdToConfirm(resetBtn, { ms: 1200, onConfirm: () => flip('/api/reset') });

  /* ——— the glow: grows with the hold until it engulfs the page ———
     scale 1 → 16× of the 20rem disc: the solid core (62% of the radius)
     covers every corner of a stage screen, and the emblem, title, flowers
     and frames slip under the turmeric sea one by one. Reduced-motion
     guests get a calm lit glow instead of the bloom. */
  let glowScale = 1;
  function setGlowProgress(p) {
    if (!glowEl) return;
    if (REDUCED) {
      glowEl.style.opacity = '1';
      return;
    }
    glowScale = 1 + p * 15;
    glowEl.style.opacity = String(0.35 + p * 0.65);
    glowEl.style.transform = 'scale(' + glowScale + ')';
  }
  function clearGlow() {
    glowScale = 1;
    if (!glowEl) return;
    glowEl.style.opacity = '';
    glowEl.style.transform = '';
  }

  /* ——— key entry (only when the fragment link wasn't used) ——— */
  // The strip stays collapsed on load: a fragment key works in silence,
  // and a missing one only surfaces when someone actually tries a flip.
  keyForm.addEventListener('submit', (e) => {
    e.preventDefault();
    key = (keyInput ? keyInput.value : '').trim();
    if (keyInput) keyInput.value = '';
    syncKeyRow();
  });
</script>
